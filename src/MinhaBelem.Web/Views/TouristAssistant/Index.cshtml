@model MinhaBelem.Web.Controllers.TouristAssistantPage
@{ViewData["Title"]=Loc["TouristAssistantTitle"];}
<section class="hero"><span class="eyebrow">MINHABELÉM</span><h1>@Loc["TouristAssistantTitle"]</h1><p>@Loc["TouristAssistantScope"]</p></section><main class="section"><form method="post" action="/guia-ia" class="card route-form">@Html.AntiForgeryToken()<label>@Loc["TouristQuestion"]<textarea name="question" required minlength="3" maxlength="500">@Model.Question</textarea></label><label><input name="useAi" type="checkbox" value="true"/> @Loc["TouristAiConsent"]</label><button>@Loc["Search"]</button></form>
@if(Model.Answer is {} answer){<p class="notice">@Loc[answer.AiRanked?"TouristAiRanked":"TouristVerifiedSearch"]</p><h2>@Loc["RouteAlternatives"]</h2><div class="grid">@foreach(var c in answer.Content){<article class="card"><h3><a href="/Home/Detalhe/@c.Id">@c.DisplayTitle</a></h3><p>@c.DisplaySummary</p><a href="@c.SourceUrl" target="_blank" rel="noopener noreferrer">@Loc["RouteSource"]: @c.SourceName ↗</a></article>}@foreach(var p in answer.Places){<article class="card"><h3><a href="/guia/@p.Id">@p.DisplayName</a></h3><p>@p.FormattedAddress</p><a href="/como-chegar?placeId=@p.Id">@Loc["RouteTitle"] →</a></article>}@foreach(var l in answer.Lines){<article class="card"><h3><a href="/mobilidade/linha/@l.Code">@l.Code · @l.Name</a></h3><p>@l.Origin → @l.Destination</p><a href="@l.SourceUrl" rel="noopener noreferrer">@Loc["RouteSource"]</a></article>}</div>@if(answer.Content.Count+answer.Places.Count+answer.Lines.Count==0){<p>@Loc["General_Empty"]</p>}<p>@Loc["RouteNoCrowding"]</p>}
</main>
