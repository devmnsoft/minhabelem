@model MinhaBelem.Web.Controllers.TouristAssistantPage
@{
    ViewData["Title"] = Loc["TouristAssistantTitle"];
    var answer = Model.Answer;
}

<div class="ai-assistant-shell">
    <section class="hero ai-hero">
        <div class="hero-content">
            <span class="eyebrow ai-badge">✨ INTELIGÊNCIA ARTIFICIAL AMAZÔNICA 360</span>
            <h1>@Loc["TouristAssistantTitle"]</h1>
            <p class="lead">
                Converse com o <strong>Curió IA</strong>, o assistente oficial do MinhaBelém.
                Receba recomendações de gastronomia autêntica, passeios fluviais, horários de museus,
                linhas de transporte e eventos reais sem alucinações.
            </p>
        </div>
    </section>

    <main class="section ai-container" id="conteudo">
        <!-- Barra de Pergunta Conversacional -->
        <div class="card ai-input-card">
            <form method="post" action="/guia-ia" class="ai-query-form" id="ai-form">
                @Html.AntiForgeryToken()
                <label for="ai-question" class="ai-label">
                    <span>Faça sua pergunta sobre Belém do Pará:</span>
                </label>
                
                <div class="ai-input-wrapper">
                    <textarea id="ai-question" name="question" required minlength="3" maxlength="500" rows="3"
                              placeholder="Ex: Onde comer o melhor tacacá hoje? Como chegar à Ilha do Combu? O que fazer no fim de semana de graça?">@Model.Question</textarea>
                </div>

                <div class="ai-form-bar">
                    <label class="checkbox-label ai-consent-toggle">
                        <input name="useAi" type="checkbox" value="true" checked class="checkbox-input" />
                        <span>Usar inteligência contextual e ordenar por relevância cultural</span>
                    </label>

                    <div class="ai-form-actions">
                        <button type="submit" class="button ai-submit-btn">
                            <span>Perguntar ao Curió IA</span>
                            <span aria-hidden="true">✨</span>
                        </button>
                    </div>
                </div>
            </form>

            <!-- Sugestões Rápidas (Chips de Pergunta) -->
            <div class="ai-suggestions-box">
                <span class="ai-suggestions-title">💡 Perguntas frequentes dos visitantes:</span>
                <div class="ai-chips">
                    <a href="/guia-ia?q=Onde+comer+o+melhor+tacaca+e+acai+em+Belem" class="ai-chip">🍲 Onde comer o melhor Tacacá e Açaí?</a>
                    <a href="/guia-ia?q=Como+fazer+o+passeio+de+barco+para+a+Ilha+do+Combu" class="ai-chip">🚤 Como ir de barco para a Ilha do Combu?</a>
                    <a href="/guia-ia?q=Roteiro+historico+pelo+Ver-o-Peso+e+Theatro+da+Paz" class="ai-chip">🏛️ Theatro da Paz e Ver-o-Peso</a>
                    <a href="/guia-ia?q=Mangal+das+Garcas+e+Parque+do+Utinga+horarios" class="ai-chip">🌿 Mangal das Garças e Parque do Utinga</a>
                    <a href="/guia-ia?q=Quais+os+eventos+culturais+gratuitos+nesta+semana" class="ai-chip">🎉 Eventos culturais gratuitos</a>
                </div>
            </div>
        </div>

        @if (answer is not null)
        {
            <div class="ai-response-section" aria-live="polite">
                <!-- Painel da Resposta Sintetizada -->
                @if (!string.IsNullOrWhiteSpace(answer.TextResponse))
                {
                    <article class="card ai-answer-card">
                        <div class="ai-answer-header">
                            <div class="ai-avatar">
                                <span class="ai-avatar-icon">🦜</span>
                                <div>
                                    <strong>Curió IA</strong>
                                    <span class="small ai-provider-tag">@(answer.ProviderName ?? "MinhaBelém IA 360") · Verificado</span>
                                </div>
                            </div>

                            <div class="ai-toolbar">
                                <button type="button" class="button secondary small" id="btn-speak" title="Ouvir resposta em áudio" aria-label="Ouvir resposta em áudio">
                                    <span aria-hidden="true" id="speak-icon">🔊</span>
                                    <span id="speak-label">Ouvir</span>
                                </button>
                                <button type="button" class="button secondary small" id="btn-copy-ai" title="Copiar resposta" aria-label="Copiar resposta">
                                    <span aria-hidden="true">📋</span>
                                    <span id="copy-label">Copiar</span>
                                </button>
                            </div>
                        </div>

                        <div class="ai-markdown-body" id="ai-text-content">
                            @foreach (var paragraph in answer.TextResponse.Split(new[] { "\n\n" }, StringSplitOptions.RemoveEmptyEntries))
                            {
                                <p>@Html.Raw(paragraph.Replace("\n", "<br/>"))</p>
                            }
                        </div>

                        <div class="ai-card-footer">
                            <span class="small text-muted">
                                🛡️ Baseado em dados autênticos de Belém do Pará. Respeita fontes oficiais, segurança e patrimônio cultural.
                            </span>
                        </div>
                    </article>
                }

                <!-- Sugestões de Continuação -->
                @if (answer.QuickSuggestions?.Count > 0)
                {
                    <div class="ai-followup-box">
                        <span class="eyebrow">CONTINUAR EXPLORANDO:</span>
                        <div class="ai-chips">
                            @foreach (var s in answer.QuickSuggestions)
                            {
                                <a href="/guia-ia?q=@Uri.EscapeDataString(s)" class="ai-chip">@s ↗</a>
                            }
                        </div>
                    </div>
                }

                <!-- Lugares Verificados Relacionados -->
                @if (answer.Places.Count > 0)
                {
                    <section class="ai-places-section">
                        <div class="sectionhead">
                            <div>
                                <span class="eyebrow">PONTOS DE INTERESSE SUGERIDOS</span>
                                <h2>Lugares em Belém (@answer.Places.Count)</h2>
                            </div>
                            <a href="/guia" class="button secondary small">Ver todos os lugares ↗</a>
                        </div>

                        <div class="grid ai-places-grid">
                            @foreach (var p in answer.Places.Take(6))
                            {
                                <article class="card ai-place-card">
                                    <span class="eyebrow">@p.PrimaryType</span>
                                    <h3><a href="/guia/@p.Id">@p.DisplayName</a></h3>
                                    <p class="small">@p.FormattedAddress</p>
                                    @if (!string.IsNullOrWhiteSpace(p.CulturalNotes))
                                    {
                                        <div class="cultural-badge">💡 @p.CulturalNotes</div>
                                    }
                                    <div class="ai-place-actions" style="margin-top:auto;padding-top:14px;border-top:1px solid var(--border-subtle);display:flex;gap:8px;">
                                        <a href="/guia/@p.Id" class="button secondary small">Ver Detalhes</a>
                                        <a href="/como-chegar?placeId=@p.Id" class="button small">Como Chegar →</a>
                                    </div>
                                </article>
                            }
                        </div>
                    </section>
                }

                <!-- Eventos e Matérias Relacionadas -->
                @if (answer.Content.Count > 0)
                {
                    <section class="ai-content-section">
                        <div class="sectionhead">
                            <div>
                                <span class="eyebrow">AGENDA & MATÉRIAS RELEVANTES</span>
                                <h2>Conteúdos Verificados (@answer.Content.Count)</h2>
                            </div>
                            <a href="/agenda" class="button secondary small">Ver Agenda Completa ↗</a>
                        </div>

                        <div class="grid ai-content-grid">
                            @foreach (var c in answer.Content.Take(4))
                            {
                                <article class="card ai-story-card">
                                    <span class="eyebrow">@c.Category</span>
                                    <h3><a href="/Home/Detalhe/@c.Id">@c.DisplayTitle</a></h3>
                                    <p class="small">@c.DisplaySummary</p>
                                    <div class="card-meta">
                                        <span>Fonte: @c.SourceName</span>
                                        <a href="/Home/Detalhe/@c.Id" class="button-link">Ler matéria →</a>
                                    </div>
                                </article>
                            }
                        </div>
                    </section>
                }

                <!-- Linhas de Transporte e Travessia -->
                @if (answer.Lines.Count > 0)
                {
                    <section class="ai-transit-section">
                        <div class="sectionhead">
                            <div>
                                <span class="eyebrow">MOBILIDADE E TRANSPORTE</span>
                                <h2>Linhas e Acessos Diretos</h2>
                            </div>
                            <a href="/mobilidade" class="button secondary small">Ver Mobilidade ↗</a>
                        </div>

                        <div class="grid ai-lines-grid">
                            @foreach (var l in answer.Lines.Take(4))
                            {
                                <article class="card ai-line-card">
                                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
                                        <span class="badge" style="background:var(--green-forest);color:white;font-weight:700;">@l.Code</span>
                                        <span class="small text-muted">@l.TransitType</span>
                                    </div>
                                    <h3><a href="/mobilidade/linha/@l.Code">@l.Name</a></h3>
                                    <p class="small">@l.Origin → @l.Destination</p>
                                    <a href="/mobilidade/linha/@l.Code" class="button secondary small" style="margin-top:10px;">Ver Itinerário</a>
                                </article>
                            }
                        </div>
                    </section>
                }
            </div>
        }
    </main>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // Text-to-Speech (Leitura em voz alta acessível)
    const btnSpeak = document.getElementById('btn-speak');
    const speakLabel = document.getElementById('speak-label');
    const speakIcon = document.getElementById('speak-icon');
    const textEl = document.getElementById('ai-text-content');

    if (btnSpeak && textEl && 'speechSynthesis' in window) {
        let isSpeaking = false;
        btnSpeak.addEventListener('click', () => {
            if (isSpeaking) {
                window.speechSynthesis.cancel();
                isSpeaking = false;
                speakLabel.textContent = 'Ouvir';
                speakIcon.textContent = '🔊';
            } else {
                window.speechSynthesis.cancel();
                const text = textEl.innerText;
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = document.documentElement.lang || 'pt-BR';
                utterance.rate = 1.0;
                utterance.onend = () => {
                    isSpeaking = false;
                    speakLabel.textContent = 'Ouvir';
                    speakIcon.textContent = '🔊';
                };
                utterance.onerror = () => {
                    isSpeaking = false;
                    speakLabel.textContent = 'Ouvir';
                    speakIcon.textContent = '🔊';
                };
                window.speechSynthesis.speak(utterance);
                isSpeaking = true;
                speakLabel.textContent = 'Parar';
                speakIcon.textContent = '⏹';
            }
        });
    } else if (btnSpeak) {
        btnSpeak.style.display = 'none';
    }

    // Copiar resposta com feedback acessível
    const btnCopy = document.getElementById('btn-copy-ai');
    const copyLabel = document.getElementById('copy-label');
    if (btnCopy && textEl) {
        btnCopy.addEventListener('click', async () => {
            try {
                await navigator.clipboard.writeText(textEl.innerText);
                copyLabel.textContent = 'Copiado! ✓';
                setTimeout(() => { copyLabel.textContent = 'Copiar'; }, 2500);
            } catch (err) {
                copyLabel.textContent = 'Erro ao copiar';
            }
        });
    }
});
</script>
