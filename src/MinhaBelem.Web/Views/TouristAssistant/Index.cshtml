@using System.Net
@using System.Text.RegularExpressions
@using MinhaBelem.Core.Entities
@using MinhaBelem.Core.Security
@model MinhaBelem.Web.Controllers.TouristAssistantPage
@{
    ViewData["Title"] = Loc["TouristAssistantTitle"];
    ViewData["Description"] = Loc["AiLead"];
    var answer = Model.Answer;
    const int size = MinhaBelem.Web.Controllers.TouristAssistantController.PageSize;
    var skip = (Model.Page - 1) * size;
    string PageLink(int page)
    {
        var link = "/guia-ia?q=" + Uri.EscapeDataString(Model.Question) + "&pagina=" + page;
        return Model.UseAi ? link : link + "&useAi=false";
    }
    bool ShowImage(string? url, string? license)
    {
        if (string.IsNullOrWhiteSpace(url) || string.IsNullOrWhiteSpace(license)) return false;
        if (url.Contains("..", StringComparison.Ordinal)) return false;
        if (url.StartsWith("/images/", StringComparison.Ordinal) || url.StartsWith("/midia/", StringComparison.Ordinal)) return true;
        return SafeUrl.Validate(url).IsValid;
    }
    string Format(string text)
    {
        var encoded = WebUtility.HtmlEncode(text);
        encoded = Regex.Replace(encoded, @"\*\*(.+?)\*\*", "<strong>$1</strong>", RegexOptions.Singleline);
        return encoded.Replace("\r\n", "\n").Replace("\n", "<br/>");
    }
}
<div class="ai-assistant-shell">
    <header class="ai-hero">
        <span class="ai-badge">✨ @Loc["AIAssistantTitle"] · @Loc["AIAssistantHint"]</span>
        <h1>@Loc["TouristAssistantTitle"]</h1>
        <p class="lead">@Loc["AiLead"]</p>
        <div class="ai-hero-capabilities" role="list">
            <span role="listitem">📍 @Loc["AiPlaces"]</span>
            <span role="listitem">📅 @Loc["AiEvents"]</span>
            <span role="listitem">🚌 @Loc["AiLines"]</span>
            <span role="listitem">🖼️ @Loc["AiMedia"]</span>
        </div>
        <div class="ai-curio-signature">
            <img src="/images/curio-marca.svg" width="34" height="34" alt="" aria-hidden="true" />
            <span>Curió · Motor de Inteligência Amazônica do MinhaBelém</span>
        </div>
    </header>

    <div class="ai-stage">
        <section class="card ai-input-card" aria-labelledby="ai-ask-title">
            <form method="post" action="/guia-ia" class="ai-query-form" id="ai-form">
                @Html.AntiForgeryToken()
                <label id="ai-ask-title" for="ai-question" class="ai-label">@Loc["AiAsk"]</label>
                <div class="ai-input-wrapper">
                    <textarea id="ai-question" name="question" required minlength="3" maxlength="500" rows="4" placeholder="@Loc["AiPlaceholder"]">@Model.Question</textarea>
                </div>
                <div class="ai-form-bar">
                    <label class="checkbox-label ai-consent-toggle">
                        <input name="useAi" type="checkbox" value="true" @(Model.UseAi ? "checked" : null) />
                        <span>@Loc["AiUseContext"]</span>
                    </label>
                    <div class="ai-form-actions">
                        <span class="ai-shortcut-hint small" aria-hidden="true">Ctrl + Enter</span>
                        <button type="submit" class="button ai-submit-btn">@Loc["AiSubmit"] <span aria-hidden="true">↗</span></button>
                    </div>
                </div>
            </form>
            <div class="ai-suggestions-box">
                <p class="ai-suggestions-title">Perguntas sugeridas</p>
                <div class="ai-chips">
                    <a class="ai-chip" href="/guia-ia?q=@Uri.EscapeDataString("O que fazer em Belém hoje?")">📍 O que fazer em Belém hoje?</a>
                    <a class="ai-chip" href="/guia-ia?q=@Uri.EscapeDataString("Como chegar ao Ver-o-Peso?")">🛒 Como chegar ao Ver-o-Peso?</a>
                    <a class="ai-chip" href="/guia-ia?q=@Uri.EscapeDataString("Quais ônibus vão para a Estação das Docas?")">🚌 Ônibus para Estação das Docas</a>
                    <a class="ai-chip" href="/guia-ia?q=@Uri.EscapeDataString("Qual barco vai para o Combu?")">⛵ Barco para a Ilha do Combu</a>
                    <a class="ai-chip" href="/guia-ia?q=@Uri.EscapeDataString("O Mangal das Garças abre amanhã?")">🌿 Mangal das Garças abre amanhã?</a>
                    <a class="ai-chip" href="/guia-ia?q=@Uri.EscapeDataString("Onde comer tacacá?")">🍲 Onde comer tacacá?</a>
                    <a class="ai-chip" href="/guia-ia?q=@Uri.EscapeDataString("Quais eventos gratuitos estão previstos?")">🎟️ Eventos gratuitos previstos</a>
                </div>
            </div>
        </section>

        @if (answer is null)
        {
            <div class="ai-empty-state reveal">
                <span class="ai-empty-icon" aria-hidden="true">🦜</span>
                <h2>@Loc["AIAssistantTitle"]</h2>
                <p style="max-width:56ch;margin:10px auto 20px;color:var(--text-muted,#59675f);">Pergunte sobre pontos turísticos, história, linhas de ônibus, horários de funcionamento, gastronomia e eventos de Belém do Pará.</p>
                <div class="ai-chips" style="justify-content:center;">
                    <a class="ai-chip" href="/guia-ia?q=@Uri.EscapeDataString("O que fazer em Belém hoje?")">📍 O que fazer hoje?</a>
                    <a class="ai-chip" href="/guia-ia?q=@Uri.EscapeDataString("Como chegar à Estação das Docas?")">🚉 Estação das Docas</a>
                    <a class="ai-chip" href="/guia-ia?q=@Uri.EscapeDataString("Quais linhas de ônibus saem do Ver-o-Peso?")">🚌 Linhas do Ver-o-Peso</a>
                    <a class="ai-chip" href="/guia-ia?q=@Uri.EscapeDataString("Qual barco vai para a Ilha do Combu?")">🚤 Barco para o Combu</a>
                </div>
            </div>
        }

        @if (answer is not null)
        {
            var places = answer.Places.Skip(skip).Take(size).ToArray();
            var stories = answer.Content.Skip(skip).Take(size).ToArray();
            var lines = answer.Lines.Skip(skip).Take(size).ToArray();
            <div class="ai-response" aria-live="polite">
                @if (!string.IsNullOrWhiteSpace(answer.TextResponse))
                {
                    <article class="card ai-answer-card">
                        <div class="ai-answer-header">
                            <div class="ai-avatar">
                                <span class="ai-avatar-icon" aria-hidden="true">
                                    <img src="/images/curio-marca.svg" width="34" height="34" alt="" />
                                </span>
                                <div>
                                    <p class="eyebrow">Curió</p>
                                    <p class="ai-provider-tag">@(answer.ProviderName ?? "MinhaBelém")</p>
                                </div>
                            </div>
                            <div class="ai-toolbar">
                                <button type="button" class="button secondary" id="btn-speak" aria-pressed="false" data-listen="@Loc["AiListen"]" data-stop="@Loc["AiStop"]">
                                    <span id="speak-label">@Loc["AiListen"]</span>
                                </button>
                                <button type="button" class="button secondary" id="btn-copy-ai" data-copy="@Loc["AiCopy"]" data-copied="@Loc["AiCopied"]">
                                    <span id="copy-label">@Loc["AiCopy"]</span>
                                </button>
                                <button type="button" class="button secondary" id="btn-share-ai" data-copy-link data-copied="@Loc["AiCopied"]">
                                    <span aria-hidden="true">🔗</span>
                                </button>
                            </div>
                        </div>
                        <div class="ai-markdown-body" id="ai-text-content">@Html.Raw(Format(answer.TextResponse))</div>
                        <p class="ai-card-footer small">@Loc["AiAnswerNote"]</p>
                    </article>
                }

                @if (answer.QuickSuggestions is { Count: > 0 })
                {
                    <div class="ai-followup-box">
                        <p class="ai-suggestions-title">@Loc["AiSuggestions"]</p>
                        <div class="ai-chips">
                            @foreach (var suggestion in answer.QuickSuggestions)
                            {
                                <a class="ai-chip" href="/guia-ia?q=@Uri.EscapeDataString(suggestion)">@suggestion</a>
                            }
                        </div>
                    </div>
                }

                @if (places.Length == 0 && stories.Length == 0 && lines.Length == 0)
                {
                    <p class="notice" role="status">@Loc["AiEmptyLists"]</p>
                }

                @if (places.Length > 0)
                {
                    <section class="ai-block" aria-labelledby="ai-places-title">
                        <div class="sectionhead">
                            <h2 id="ai-places-title">@Loc["AiPlaces"] <span class="small">@answer.Places.Count</span></h2>
                            <a class="button secondary" href="/guia?marco=1">@Loc["Landmarks"]</a>
                        </div>
                        <div class="ai-result-grid">
                            @foreach (var place in places)
                            {
                                <article class="card ai-result-card">
                                    @if (Model.Covers.TryGetValue(place.Id, out var cover))
                                    {
                                        <img class="ai-cover" src="@cover.ThumbUrl" alt="@place.DisplayName" width="640" height="360" loading="lazy" referrerpolicy="no-referrer" />
                                        <p class="small">@cover.Credit · @cover.LicenseName</p>
                                    }
                                    <p class="eyebrow">@place.PrimaryType</p>
                                    <h3><a href="/guia/@place.Id">@place.DisplayName</a></h3>
                                    <p>@(place.FormattedAddress ?? place.Neighborhood)</p>
                                    @if (!string.IsNullOrWhiteSpace(place.Municipality))
                                    {
                                        <p class="small">@place.Neighborhood · @place.Municipality</p>
                                    }
                                    <div class="ai-card-actions">
                                        <a class="button secondary" href="/guia/@place.Id">@Loc["AiDetails"]</a>
                                        <a class="button" href="/como-chegar?placeId=@place.Id">@Loc["AiRoute"]</a>
                                    </div>
                                </article>
                            }
                        </div>
                    </section>
                }

                @if (stories.Length > 0)
                {
                    <section class="ai-block" aria-labelledby="ai-events-title">
                        <div class="sectionhead">
                            <h2 id="ai-events-title">@Loc["AiEvents"] <span class="small">@answer.Content.Count</span></h2>
                            <a class="button secondary" href="/agenda">@Loc["Nav_Agenda"]</a>
                        </div>
                        <div class="ai-result-grid">
                            @foreach (var story in stories)
                            {
                                <article class="card ai-result-card">
                                    @if (ShowImage(story.ImageUrl, story.ImageLicense))
                                    {
                                        <img class="ai-cover" src="@story.ImageUrl" alt="@story.DisplayTitle" width="640" height="360" loading="lazy" />
                                        <p class="small">@story.ImageCredit · @story.ImageLicense</p>
                                    }
                                    <p class="eyebrow">@story.Category</p>
                                    <h3><a href="/Home/Detalhe/@story.Id">@story.DisplayTitle</a></h3>
                                    <p>@story.DisplaySummary</p>
                                    <p class="small">@story.SourceName</p>
                                    <div class="ai-card-actions">
                                        <a class="button secondary" href="/Home/Detalhe/@story.Id">@Loc["AiRead"]</a>
                                    </div>
                                </article>
                            }
                        </div>
                    </section>
                }

                @if (lines.Length > 0)
                {
                    <section class="ai-block" aria-labelledby="ai-lines-title">
                        <div class="sectionhead">
                            <h2 id="ai-lines-title">@Loc["AiLines"] <span class="small">@answer.Lines.Count</span></h2>
                            <a class="button secondary" href="/mobilidade">@Loc["NavMobility"]</a>
                        </div>
                        <div class="ai-result-grid">
                            @foreach (var line in lines)
                            {
                                <article class="card ai-result-card">
                                    <p class="eyebrow">@line.Code · @line.TransitType</p>
                                    <h3><a href="/mobilidade/linha/@line.Code">@line.Name</a></h3>
                                    <p>@line.Origin → @line.Destination</p>
                                    <div class="ai-card-actions">
                                        <a class="button secondary" href="/mobilidade/linha/@line.Code">@Loc["AiDetails"]</a>
                                    </div>
                                </article>
                            }
                        </div>
                    </section>
                }

                @if (Model.Clips.Count > 0)
                {
                    <section class="ai-block" aria-labelledby="ai-media-title">
                        <div class="sectionhead">
                            <h2 id="ai-media-title">@Loc["AiMedia"]</h2>
                            <a class="button secondary" href="/midias">@Loc["MediaGalleryTitle"]</a>
                        </div>
                        <div class="photo-gallery">
                            @foreach (var clip in Model.Clips)
                            {
                                <figure class="photo-item reveal" data-lightbox="ai-media" data-src="@(clip.HasPicture ? "/midia/" + clip.Id : "")" data-caption="@clip.Description">
                                    @if (clip.HasPicture)
                                    {
                                        <img src="/midia/@clip.Id" alt="@clip.Description" width="640" height="480" loading="lazy" decoding="async" />
                                        <span class="photo-badge" aria-hidden="true">📷</span>
                                    }
                                    @if (clip.HasVideo)
                                    {
                                        <div class="video-embed" style="position:absolute;inset:0;">
                                            <iframe src="https://www.youtube-nocookie.com/embed/@clip.YoutubeId" title="@clip.Description" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                                        </div>
                                        <span class="photo-badge" aria-hidden="true">🎬</span>
                                    }
                                    <figcaption>@clip.Description</figcaption>
                                </figure>
                            }
                        </div>
                    </section>
                }

                @if (Model.PageCount > 1)
                {
                    <nav class="ai-pager" aria-label="@Loc["AiPage"]">
                        @if (Model.Page > 1)
                        {
                            <a class="button secondary" rel="prev" href="@PageLink(Model.Page - 1)">@Loc["AiPrev"]</a>
                        }
                        <span>@Model.Page / @Model.PageCount</span>
                        @if (Model.Page < Model.PageCount)
                        {
                            <a class="button" rel="next" href="@PageLink(Model.Page + 1)">@Loc["AiNext"]</a>
                        }
                    </nav>
                }
            </div>
        }
    </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', () => {
    const textEl = document.getElementById('ai-text-content');
    const btnSpeak = document.getElementById('btn-speak');
    const speakLabel = document.getElementById('speak-label');
    if (btnSpeak && textEl && 'speechSynthesis' in window) {
        let speaking = false;
        const listen = btnSpeak.dataset.listen || 'Ouvir';
        const stop = btnSpeak.dataset.stop || 'Parar';
        const reset = () => { speaking = false; speakLabel.textContent = listen; btnSpeak.setAttribute('aria-pressed', 'false'); };
        btnSpeak.addEventListener('click', () => {
            if (speaking) { window.speechSynthesis.cancel(); reset(); return; }
            const utterance = new SpeechSynthesisUtterance(textEl.innerText);
            utterance.lang = document.documentElement.lang || 'pt-BR';
            utterance.onend = reset;
            utterance.onerror = reset;
            window.speechSynthesis.cancel();
            window.speechSynthesis.speak(utterance);
            speaking = true;
            speakLabel.textContent = stop;
            btnSpeak.setAttribute('aria-pressed', 'true');
        });
    } else if (btnSpeak) {
        btnSpeak.hidden = true;
    }
    const btnCopy = document.getElementById('btn-copy-ai');
    const copyLabel = document.getElementById('copy-label');
    if (btnCopy && textEl && copyLabel) {
        btnCopy.addEventListener('click', async () => {
            try {
                await navigator.clipboard.writeText(textEl.innerText);
                copyLabel.textContent = btnCopy.dataset.copied || copyLabel.textContent;
            } catch {
                copyLabel.textContent = btnCopy.dataset.copy || copyLabel.textContent;
            }
        });
    }
});
</script>
