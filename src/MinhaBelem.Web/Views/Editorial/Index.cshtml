@model MinhaBelem.Web.Models.EditorialIndex
<section class="section"><p class="eyebrow">CENTRAL EDITORIAL</p><h1>Revisão e publicação</h1><p>Uma fonte identificada, edição humana e verificação precedem cada publicação.</p>
<h2>Candidatos recebidos</h2>@if(Model.Candidates.Count == 0){<p class="empty">Nenhum candidato pendente. Consulte <a href="/admin/fontes">Fontes e monitoramento</a>.</p>}
<div class="grid">@foreach(var item in Model.Candidates){<article class="card"><p class="eyebrow">@item.SourceName</p><h3>@item.Title</h3><p>@item.Summary</p><a href="/editorial/comparar/@item.Id">Comparar dados e atualizações</a><a href="@(MinhaBelem.Core.Security.SafeUrl.Validate(item.SourceUrl).IsValid ? item.SourceUrl : null)" target="_blank" rel="noopener noreferrer">Conferir original</a><form method="post" asp-action="Importar" asp-route-id="@item.Id"><button>Importar para edição</button></form><form method="post" asp-action="Rejeitar" asp-route-id="@item.Id"><button class="secondary">Rejeitar</button></form></article>}</div>
<h2>Conteúdos editoriais</h2><div class="table-wrap"><table><thead><tr><th>Título</th><th>Estado</th><th>Atualização (UTC)</th><th>Edição</th></tr></thead><tbody>@foreach(var item in Model.Content){<tr><td>@item.Title</td><td>@item.Status</td><td>@item.UpdatedAt.ToString("g")</td><td><a asp-action="Editar" asp-route-id="@item.Id">Abrir</a></td></tr>}</tbody></table></div></section>
