@model IReadOnlyList<MinhaBelem.Web.Services.EditorialCandidate>
<section class="section"><p class="eyebrow">CENTRAL EDITORIAL</p><h1>Fontes aguardando revisão</h1><p>Conteúdo recebido de fontes cadastradas. A aprovação abaixo envia para uma segunda etapa de edição, <strong>não publica no portal</strong>.</p><form method="post" asp-action="Logout"><button type="submit">Sair</button></form>
@if(Model.Count==0){<div class="empty"><h3>Nenhuma informação pendente</h3><p>Configure fontes aprovadas e ative o coletor no servidor.</p></div>}
else{<div class="grid">@foreach(var item in Model){<article class="card"><span class="eyebrow">@item.SourceName</span><h3>@item.Title</h3><p>@item.Summary</p><p class="small">@item.PublishedAt.ToString("dd/MM/yyyy HH:mm")</p><a href="@item.SourceUrl" target="_blank" rel="noopener noreferrer">Ver fonte original</a><form asp-action="Review" asp-route-id="@item.Id" method="post"><button name="approve" value="true" type="submit">Encaminhar para edição</button><button name="approve" value="false" type="submit">Rejeitar</button></form></article>}</div>}</section>