@model MinhaBelem.Web.Models.ContentInput
@using MinhaBelem.Core.Entities
@using MinhaBelem.Core.Taxonomy
<section class="section article"><p class="eyebrow">EDIÇÃO EDITORIAL · @ViewData["Status"]</p><h1>Editar conteúdo</h1><p>Sinalizações: @ViewData["Flags"]. Datas deste formulário usam UTC.</p><div asp-validation-summary="All" role="alert"></div>
<form method="post" asp-action="Editar" asp-route-id="@Model.Id"><input asp-for="Id" type="hidden" /><input asp-for="Revision" type="hidden" />
<label>Título<input asp-for="Title" maxlength="300" required /></label><label>Resumo<textarea asp-for="Summary" maxlength="2500" rows="5" required></textarea></label><label>Texto (sem HTML)<textarea asp-for="Body" rows="8" maxlength="20000"></textarea></label>
<label>Categoria<select asp-for="Category" asp-items="Html.GetEnumSelectList<ContentCategory>()"></select></label><label>Tipo<select asp-for="Kind" asp-items="Html.GetEnumSelectList<ContentKind>()"></select></label>
<label>Assunto<select asp-for="Subject"><option value="">Sem assunto específico</option>@foreach(var subject in MinhaBelem.Core.Taxonomy.Taxonomy.Subjects){<option value="@subject.Key">@subject.Label</option>}</select></label>
<label>Organizador<input asp-for="Organizer" maxlength="240" /></label><label>Artistas e participantes<input asp-for="Participants" maxlength="500" /></label><label>Classificação mínima (0 = livre)<input asp-for="MinimumAge" type="number" min="0" max="18" /></label>
<label>Resumo público da atualização<input asp-for="PublicUpdateNote" maxlength="300" /></label>
<label><input asp-for="ResolveDuplicate" /> Conferi a indicação de duplicidade e confirmei que este é um conteúdo distinto (explique na descrição da alteração)</label>
<fieldset><legend>Públicos</legend>@foreach(var audience in Enum.GetValues<Audience>()){<label><input name="Audiences" type="checkbox" value="@audience" checked="@Model.Audiences.Contains(audience)" /> @audience</label>}</fieldset>
<fieldset><legend>Acessibilidade confirmada</legend>@foreach(var feature in Enum.GetValues<AccessibilityFeature>()){<label><input name="Accessibility" type="checkbox" value="@feature" checked="@Model.Accessibility.Contains(feature)" /> @feature</label>}</fieldset>
<label>Nome da fonte<input asp-for="SourceName" required /></label><label>URL original<input asp-for="SourceUrl" type="url" required /></label><label>Autoria<input asp-for="AuthorName" required /></label>
<label>Município<input asp-for="Municipality" /></label><label>Bairro<input asp-for="Neighborhood" /></label><label>Endereço<input asp-for="Address" /></label>
<label>Início do evento (UTC)<input asp-for="EventStartAt" type="datetime-local" /></label><label>Término (UTC)<input asp-for="EventEndAt" type="datetime-local" /></label><label>Expiração (UTC)<input asp-for="ExpiresAt" type="datetime-local" /></label>
<label>Valor<input asp-for="TicketPrice" type="number" step="0.01" min="0" /></label><label><input asp-for="IsFree" /> Gratuito</label><label><input asp-for="Verified" /> Conferi os dados na fonte original</label>
<label>Descrição da alteração<input asp-for="ChangeSummary" maxlength="480" required /></label><button>Salvar e enviar à revisão</button></form>
<div class="actions"><form method="post" asp-action="Analisar" asp-route-id="@Model.Id"><button>Analisar com IA</button></form><form method="post" asp-action="Publicar" asp-route-id="@Model.Id"><label><input type="checkbox" name="confirmSensitive" value="true" /> Revisei as evidências e as sinalizações de conteúdo sensível</label><button>Aprovar e publicar</button></form><form method="post" asp-action="Arquivar" asp-route-id="@Model.Id"><button class="secondary">Arquivar</button></form></div>
<h2>Histórico</h2><ul>@foreach(var revision in ViewData["Revisions"] as IReadOnlyList<ContentRevision> ?? Array.Empty<ContentRevision>()){<li>Revisão @revision.Revision · @revision.ChangedAt.ToString("g") UTC · editor @revision.ChangedById — @revision.ChangeSummary</li>}</ul></section>
<section class="section article"><h2>Situação especial</h2><form method="post" asp-action="Situacao" asp-route-id="@Model.Id"><label>Estado<select name="status"><option value="Cancelled">Cancelado</option><option value="Postponed">Adiado</option><option value="UncertainDate">Data incerta</option><option value="AwaitingOrganizer">Aguardando organizador</option><option value="Completed">Evento encerrado</option></select></label><p>Confirme o estado na fonte antes de registrar. Cancelamentos publicados continuam acessíveis com aviso.</p><button>Registrar situação</button></form></section>
