@model MinhaBelem.Web.Models.MobilidadeViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Mobilidade Urbana em Belém";
    var currentCulture = CultureInfo.CurrentUICulture;
}

<div class="mobility-page">
    <section class="hero">
        <div class="eyebrow">TRANSPORTE & TRÂNSITO EM BELÉM 🚌 🚤</div>
        <h1>Mobilidade Urbana</h1>
        <p>Linhas de ônibus, estações BRT, travessias fluviais amazônicas e alertas oficiais de trânsito em tempo real.</p>

        <form method="get" action="/mobilidade" class="search" role="search">
            <label for="busca-linha" class="sr-only">Buscar linha, bairro ou trajeto</label>
            <input id="busca-linha" name="busca" maxlength="120" placeholder="Digite número da linha, rua ou destino (ex: 758, Ver-o-Peso, BRT)..." value="@Model.SearchQuery" />
            <button type="submit">Buscar Linha</button>
        </form>

        <div class="hero-quick-tags" style="margin-top:18px;">
            <a href="/mobilidade/de-para">🔀 Planejador de-para</a>
            <a href="/mobilidade/paradas">📍 Paradas e terminais</a>
            <a href="/mobilidade/fluvial">🚤 Travessias fluviais</a>
            <a href="/mobilidade/alertas">⚠️ Alertas de trânsito</a>
        </div>
    </section>

    <!-- Alertas de Trânsito Ativos -->
    @if (Model.Alerts.Count > 0)
    {
        <section class="section alerts-section">
            <div class="sectionhead">
                <div>
                    <span class="eyebrow">AVISOS OFICIAIS SEMOB</span>
                    <h2>⚠️ Alertas e Interdições de Trânsito</h2>
                </div>
            </div>

            <div class="grid alerts-grid">
                @foreach (var alert in Model.Alerts)
                {
                    <div class="card alert-card notice error-notice">
                        <div class="alert-header">
                            <span class="badge badge-rejected">@alert.Severity</span>
                            <span class="small">📍 @alert.Neighborhood</span>
                        </div>
                        <h3>@alert.Title</h3>
                        <p>@alert.Description</p>
                        <span class="small">Início: @alert.StartAt.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                }
            </div>
        </section>
    }

    <!-- Linhas de Ônibus e BRT -->
    <section class="section lines-section">
        <div class="sectionhead">
            <div>
                <span class="eyebrow">TRANSPORTE COLETIVO</span>
                <h2>Linhas de Ônibus & BRT</h2>
            </div>
            <div class="view-31e4e2a2 filter-pills">
                <a href="/mobilidade" class="button @(string.IsNullOrEmpty(Model.SelectedType) ? "" : "secondary") small">Todas</a>
                <a href="/mobilidade?tipo=BRT" class="button @(Model.SelectedType == "BRT" ? "" : "secondary") small">BRT Metropolitano</a>
                <a href="/mobilidade?tipo=Urbano" class="button @(Model.SelectedType == "Urbano" ? "" : "secondary") small">Urbanas</a>
                <a href="/mobilidade?tipo=Distrital" class="button @(Model.SelectedType == "Distrital" ? "" : "secondary") small">Distritais</a>
            </div>
        </div>

        @if (Model.Lines.Count == 0)
        {
            <div class="empty">
                <h3>Nenhuma linha encontrada</h3>
                <p>Tente buscar por outro termo ou selecione todas as categorias.</p>
            </div>
        }
        else
        {
            <div class="grid lines-grid">
                @foreach (var line in Model.Lines)
                {
                    <article class="card line-card">
                        <div class="line-header" style="display:flex;justify-content:space-between;align-items:center;gap:10px;">
                            <span class="line-code-badge">@line.Code</span>
                            <span class="badge badge-info">@line.TransitType</span>
                        </div>

                        <h3 style="margin:14px 0 6px;"><a href="/mobilidade/linha/@line.Code">@line.Name</a></h3>

                        <div class="transit-de-para" style="margin:10px 0 12px;padding:12px 14px;">
                            <div class="depara-end">
                                <span class="depara-label">De</span>
                                <strong>@line.Origin</strong>
                            </div>
                            <span class="depara-arrow" aria-hidden="true">→</span>
                            <div class="depara-end">
                                <span class="depara-label">Para</span>
                                <strong>@line.Destination</strong>
                            </div>
                        </div>

                        @if (line.IsVerified)
                        {
                            <p class="small"><strong>🕒 Horário:</strong> @line.ScheduleText</p>
                            @if (line.ConfirmedFare is { } verifiedFare)
                            {
                                <p class="small"><strong>💰 Tarifa:</strong> R$ @verifiedFare.ToString("F2", CultureInfo.InvariantCulture) · meia R$ @((verifiedFare / 2).ToString("F2", CultureInfo.InvariantCulture))</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(line.IntegrationPoints))
                            {
                                <p class="small"><strong>🔄 Integração:</strong> @line.IntegrationPoints</p>
                            }
                        }
                        else
                        {
                            <p class="small">Horário e tarifa: confirme com o operador.</p>
                        }

                        @if (!string.IsNullOrWhiteSpace(line.ItinerarySummary))
                        {
                            <p class="small text-muted">@line.ItinerarySummary</p>
                        }

                        <div class="line-features" style="display:flex;gap:12px;margin:12px 0;font-size:0.85rem;flex-wrap:wrap;">
                            @if (line.IsVerified && line.HasAirConditioning)
                            {
                                <span>❄️ Ar-condicionado</span>
                            }
                            @if (line.IsVerified && line.HasWheelchairLift)
                            {
                                <span>♿ Elevador acessível</span>
                            }
                            @if (line.IsVerified)
                            {
                                <span>📅 @line.ServiceDays</span>
                            }
                        </div>

                        <div class="card-footer" style="margin-top:12px;border-top:1px solid var(--border-subtle,#eef3ef);padding-top:10px;display:flex;gap:12px;flex-wrap:wrap;">
                            <a href="/mobilidade/linha/@line.Code" class="button-link">Itinerário completo →</a>
                            <a href="/guia-ia?q=@Uri.EscapeDataString("linha " + line.Code + " horário")" class="button-link">✨ Perguntar ao Curió</a>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <!-- Demais modais de transporte -->
    <section class="section other-modes-section">
        <div class="sectionhead">
            <div>
                <span class="eyebrow">OUTROS MODAIS</span>
                <h2>🚲 🚕 🛵 Mais formas de se mover</h2>
                <p class="section-subtitle">Serviços públicos de mobilidade managecidos pela Prefeitura de Belém e pela SEMOB.</p>
            </div>
        </div>
        <div class="grid">
            <article class="card">
                <span class="eyebrow">Ciclovias</span>
                <h3>Rede Cicloviária de Belém</h3>
                <p>Ciclovias e rotas cicláveis que conectam a orla, o centro histórico e as áreas de lazer.</p>
                <a class="button-link" href="https://seguranca.belem.pa.gov.br/servicos-online/rede-cicloviaria-de-belem/" target="_blank" rel="noopener noreferrer">Ver na fonte oficial ↗</a>
            </article>
            <article class="card">
                <span class="eyebrow">Táxi</span>
                <h3>Serviços para táxi</h3>
                <p>Disque táxi, pontos de embarque e tabela de fares do serviço municipal.</p>
                <a class="button-link" href="https://seguranca.belem.pa.gov.br/servicos-online/servicos-para-taxi/" target="_blank" rel="noopener noreferrer">Ver na fonte oficial ↗</a>
            </article>
            <article class="card">
                <span class="eyebrow">Mototáxi</span>
                <h3>Cadastro de mototaxistas</h3>
                <p>Cadastro operacional dos mototaxistas de Belém e pontos de atendimento.</p>
                <a class="button-link" href="https://seguranca.belem.pa.gov.br/servicos-online/formularios-diversos/" target="_blank" rel="noopener noreferrer">Ver na fonte oficial ↗</a>
            </article>
            <article class="card">
                <span class="eyebrow">Integração</span>
                <h3>Integra Belém</h3>
                <p>Regras de integração, cartões Passe Fácil, gratuidades e cobrança por sentido de trajeto.</p>
                <a class="button-link" href="https://seguranca.belem.pa.gov.br/integra-belem/" target="_blank" rel="noopener noreferrer">Ver na fonte oficial ↗</a>
            </article>
            <article class="card">
                <span class="eyebrow">Rotas</span>
                <h3>Planejador de-para</h3>
                <p>Descubra quais linhas oficiais conectam um ponto a outro e onde trocar de ônibus.</p>
                <a class="button-link" href="/mobilidade/de-para">Abrir planejador ↗</a>
            </article>
            <article class="card">
                <span class="eyebrow">Radar</span>
                <h3>Alertas de trânsito</h3>
                <p>Obras, interdições, desvios e eventos que afetam a circulação na cidade.</p>
                <a class="button-link" href="/mobilidade/alertas">Ver alertas ↗</a>
            </article>
        </div>
    </section>

    <!-- Travessias Fluviais Amazônicas -->
    <section class="section river-transit-section">
        <div class="sectionhead">
            <div>
                <span class="eyebrow">TRANSPORTE HIDROVIÁRIO</span>
                <h2>🚤 Travessias Fluviais & Ilhas</h2>
            </div>
            <p class="small">Acesso às ilhas de Belém: Combu, Cotijuba, Barcarena e Mosqueiro.</p>
        </div>

        <div class="grid river-grid">
            @foreach (var route in Model.RiverRoutes)
            {
                <article class="card river-card">
                    <span class="eyebrow">Ilha: @route.DestinationIsland</span>
                    <h3>@route.Name</h3>
                    <p><strong>Embarque:</strong> @route.DeparturePort</p>
                    <p><strong>Desembarque:</strong> @route.DestinationPort</p>
                    <div class="river-meta" style="margin:12px 0;font-size:0.9rem;">
                        <p>⏱️ <strong>Duração estimada:</strong> @(route.IsVerified && route.EstimatedDurationMinutes>0 ? route.EstimatedDurationMinutes + " min" : "Não confirmada")</p>
                        <p>💰 <strong>Tarifa:</strong> @(route.ConfirmedFare is {} riverFare ? "R$ " + riverFare.ToString("F2") : "Não confirmada")</p>
                        <p>🚢 <strong>Embarcação:</strong> @route.VesselType</p>
                        <p>🕒 <strong>Horários:</strong> @(route.IsVerified ? route.OperatingHours : "Confirme a operação com o responsável")</p>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(route.OperatorNotes))
                    {
                        <div class="cultural-badge">💡 @route.OperatorNotes</div>
                    }
                </article>
            }
        </div>
    </section>
</div>
