@model IReadOnlyList<MinhaBelem.Core.Entities.TransitStop>
@{
    ViewData["Title"] = "Paradas, terminais e estações";
    var bairro = ViewData["Bairro"] as string;
    var busca = ViewData["Busca"] as string;
    var terminais = Model.Where(s => s.StopType is "Terminal" or "Estação BRT").ToArray();
    var paradas = Model.Where(s => s.StopType is not ("Terminal" or "Estação BRT")).ToArray();
    var bairros = Model.Select(s => s.Neighborhood).Where(n => !string.IsNullOrWhiteSpace(n)).Distinct().OrderBy(n => n).ToArray();
}

<section class="section">
    <div class="sectionhead">
        <div>
            <span class="eyebrow">MOBILIDADE / EMBARQUE</span>
            <h1>Paradas, terminais e estações</h1>
            <p class="section-subtitle">Pontos de embarque do sistema, com as linhas que passam em cada um. Integração <strong>física</strong> acontece dentro do terminal; <strong>temporal</strong>, na parada lateral da pista.</p>
        </div>
    </div>

    <form method="get" action="/mobilidade/paradas" class="filters" role="search">
        <label>
            Buscar
            <input name="busca" maxlength="120" value="@busca" placeholder="Ex.: Mangueirão, São Brás, 758" />
        </label>
        <label>
            Bairro
            <select name="bairro">
                <option value="">Todos os bairros</option>
                @Html.Raw(SelectOptions.Build(bairros.Select(b => (b, b)), bairro ?? ""))
            </select>
        </label>
        <button type="submit">Filtrar</button>
        <a class="button secondary" href="/mobilidade/paradas">Limpar</a>
        <a class="button secondary" href="/mobilidade/de-para">Planejador de-para ↗</a>
    </form>

    @if (Model.Count == 0)
    {
        <div class="empty">
            <h3>Nenhum ponto encontrado</h3>
            <p>Tente outro termo ou consulte o planejador de-para.</p>
        </div>
    }
    else
    {
        @if (terminais.Length > 0)
        {
            <section class="section" style="margin-top:32px;">
                <div class="sectionhead">
                    <div><span class="eyebrow">INTEGRAÇÃO</span><h2>Terminais e estações</h2></div>
                    <span class="small">@terminais.Length pontos</span>
                </div>
                <div class="grid">
                    @foreach (var s in terminais)
                    {
                        var lines = (s.LinesServiced ?? "").Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                        <article class="card transit-stop-card">
                            <span class="eyebrow">@s.StopType</span>
                            <h3>@s.Name</h3>
                            @if (!string.IsNullOrWhiteSpace(s.Address))
                            {
                                <p class="small">📍 @s.Address</p>
                            }
                            <p class="small">🏘️ @s.Neighborhood · @s.Municipality</p>
                            @if (lines.Length > 0)
                            {
                                <div class="stop-lines">
                                    @foreach (var code in lines.Take(12))
                                    {
                                        <a class="line-chip" href="/mobilidade/linha/@code">@code</a>
                                    }
                                    @if (lines.Length > 12)
                                    {
                                        <span class="small">+@(lines.Length - 12)</span>
                                    }
                                </div>
                            }
                        </article>
                    }
                </div>
            </section>
        }

        @if (paradas.Length > 0)
        {
            <section class="section" style="margin-top:32px;">
                <div class="sectionhead">
                    <div><span class="eyebrow">PONTOS DE LINHA</span><h2>Paradas</h2></div>
                    <span class="small">@paradas.Length pontos</span>
                </div>
                <div class="grid">
                    @foreach (var s in paradas)
                    {
                        var lines = (s.LinesServiced ?? "").Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                        <article class="card transit-stop-card">
                            <span class="eyebrow">@s.StopType</span>
                            <h3>@s.Name</h3>
                            @if (!string.IsNullOrWhiteSpace(s.Address))
                            {
                                <p class="small">📍 @s.Address</p>
                            }
                            <p class="small">🏘️ @s.Neighborhood · @s.Municipality</p>
                            @if (lines.Length > 0)
                            {
                                <div class="stop-lines">
                                    @foreach (var code in lines.Take(12))
                                    {
                                        <a class="line-chip" href="/mobilidade/linha/@code">@code</a>
                                    }
                                </div>
                            }
                        </article>
                    }
                </div>
            </section>
        }
    }
</section>
