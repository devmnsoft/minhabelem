@model IReadOnlyList<MinhaBelem.Core.Entities.RiverRoute>
@using System.Globalization
@{ ViewData["Title"] = "Travessias fluviais"; }
<section class="hero">
    <div class="hero-content">
        <span class="eyebrow">MOBILIDADE / HIDROVIÁRIO</span>
        <h1>Travessias fluviais</h1>
        <p>As ilhas de Belém são acessadas por via fluvial. Tarifas e horários seguem a regulamentação municipal e as cooperativas dos barqueiros; confirme as condições de maré e a operação do dia no ponto de embarque.</p>
        <div class="hero-quick-tags" style="margin-top:18px;">
            <a href="/mobilidade">🚌 Linhas de ônibus</a>
            <a href="/mobilidade/de-para">🔀 Planejador de-para</a>
            <a href="/guia-ia">✨ Perguntar ao Curió</a>
        </div>
    </div>
</section>
<main class="section">
    <div class="sectionhead">
        <div><span class="eyebrow">ILHAS</span><h2>Embarques e tarifas</h2></div>
        <a class="button-link" href="https://seguranca.belem.pa.gov.br/integra-belem/" target="_blank" rel="noopener noreferrer">Fonte oficial ↗</a>
    </div>

    @if (Model.Count == 0)
    {
        <p class="empty">@Loc["General_Empty"]</p>
    }
    else
    {
        <div class="grid">
            @foreach (var route in Model)
            {
                <article class="card river-card">
                    <span class="eyebrow">@route.DestinationIsland</span>
                    <h2>@route.Name</h2>

                    <div class="transit-de-para" style="margin:12px 0;">
                        <div class="depara-end">
                            <span class="depara-label">Embarque</span>
                            <strong>@route.DeparturePort</strong>
                        </div>
                        <span class="depara-arrow" aria-hidden="true">→</span>
                        <div class="depara-end">
                            <span class="depara-label">Desembarque</span>
                            <strong>@route.DestinationPort</strong>
                        </div>
                    </div>

                    <div class="features-box" style="margin:0 0 14px;padding:16px;background:var(--green-surface-subtle,#f4f8f5);border-radius:10px;">
                        <h4>🕒 Operação e tarifa</h4>
                        <p><strong>Horários:</strong> @(route.IsVerified && !string.IsNullOrWhiteSpace(route.OperatingHours) ? route.OperatingHours : "Confirme a operação com o responsável")</p>
                        <p><strong>Tarifa:</strong> @(route.ConfirmedFare is { } fare ? $"R$ {fare.ToString("F2", CultureInfo.CurrentUICulture)}" : "Não confirmada na fonte oficial")</p>
                        @if (route.EstimatedDurationMinutes > 0)
                        {
                            <p><strong>Duração estimada:</strong> @route.EstimatedDurationMinutes min</p>
                        }
                        <p><strong>Embarcação:</strong> @route.VesselType</p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(route.OperatorNotes))
                    {
                        <div class="cultural-badge">💡 @route.OperatorNotes</div>
                    }

                    @if (route.IsVerified && !string.IsNullOrWhiteSpace(route.SourceUrl))
                    {
                        <p class="small"><a href="@route.SourceUrl" target="_blank" rel="noopener noreferrer">@Loc["RouteSource"] ↗</a> · verificado em @route.VerifiedAt?.ToString("d", CultureInfo.CurrentUICulture)</p>
                    }

                    <div class="card-footer" style="margin-top:12px;border-top:1px solid var(--border-subtle,#eef3ef);padding-top:10px;">
                        <a href="/como-chegar?destino=@Uri.EscapeDataString(route.DestinationPort)&modo=boat" class="button-link">Como chegar ↗</a>
                        <a href="/guia-ia?q=@Uri.EscapeDataString("como ir para " + route.DestinationIsland + " de barco")" class="button-link">✨ Perguntar ao Curió</a>
                    </div>
                </article>
            }
        </div>
    }
</main>
