@model IReadOnlyList<MinhaBelem.Web.Controllers.MediaAsset>
@if(Model.Count>0){<section class="section"><h2>@Loc["PhotoGallery"]</h2><div class="grid">@foreach(var asset in Model){<figure class="card">@if(asset.StorageKey is not null){<img src="/midia/@asset.Id" alt="@asset.Description" loading="lazy" decoding="async" width="960" height="640"/>}@if(asset.YoutubeId is not null){<a href="https://www.youtube.com/watch?v=@asset.YoutubeId" target="_blank" rel="noopener noreferrer">@asset.Description · YouTube ↗</a>}<figcaption>@asset.Credit · @asset.License</figcaption></figure>}</div></section>}
