@model IReadOnlyList<MinhaBelem.Core.Entities.AdvertiserCampaign>
@if (Model.Count > 0)
{
    <aside class="section" aria-label="@Loc["CampaignSponsored"]">
        <div class="grid">
        @foreach (var campaign in Model)
        {
            if (!MinhaBelem.Core.Security.SafeUrl.Validate(campaign.DestinationUrl).IsValid) { continue; }
            <article class="card">
                <span class="eyebrow">@Loc["CampaignSponsored"] · @campaign.AdvertiserName</span>
                @if (MinhaBelem.Core.Security.SafeUrl.Validate(campaign.ImageUrl).IsValid)
                { <img src="@campaign.ImageUrl" alt="@campaign.AdvertiserName" loading="lazy" decoding="async" /> }
                <h3><a href="@campaign.DestinationUrl" target="_blank" rel="sponsored noopener noreferrer">@(campaign.Headline ?? campaign.AdvertiserName) ↗</a></h3>
            </article>
        }
        </div>
    </aside>
}
