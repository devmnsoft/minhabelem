<!DOCTYPE html>
<html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="MinhaBelém: cultura, notícias, serviços e mobilidade em Belém do Pará."/><title>@(ViewData["Title"] ?? "MinhaBelém — Nossa cidade. Mil histórias.")</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head>
<body><a class="skip-link" href="#conteudo">Pular para o conteúdo</a><header class="header"><a class="brand" href="/">✺ minha<span>belém</span></a><nav aria-label="Menu principal"><a href="/?categoria=cultura">Cultura</a><a href="/agenda">Agenda</a><a href="/?categoria=politica">Cidadania</a><a href="/?categoria=mobilidade">Mobilidade</a><a href="/guia">Guia da cidade</a>@if(User.Identity?.IsAuthenticated == true){<a href="/conta/perfil">Minha conta</a>}else{<a href="/conta/login">Entrar</a>}</nav></header>
@if(User.Identity?.IsAuthenticated == true){<nav class="admin-nav" aria-label="Administração">
@foreach(var link in new[]{("dashboard.read","/admin","Painel"),("content.read","/editorial","Editorial"),("source.manage","/admin/fontes","Fontes"),("place.manage","/admin/lugares","Lugares"),("submission.moderate","/admin/colaboracoes","Colaborações"),("user.manage","/admin/usuarios","Usuários"),("settings.manage","/admin/integracoes","Integrações"),("audit.read","/admin/auditoria","Auditoria"),("settings.manage","/admin/configuracoes","Configurações")}){if(User.HasClaim("mb:permission",link.Item1)){<a href="@link.Item2">@link.Item3</a>}}
<a href="/conta/sessoes">Sessões</a></nav>}
<main id="conteudo" tabindex="-1">@if(TempData["Notice"] is string notice){<p class="notice" role="status">@notice</p>}@RenderBody()</main><footer><strong>MinhaBelém</strong><p>Nossa cidade. Mil histórias. Belém, Pará, Brasil.</p><nav aria-label="Informações"><a href="/privacidade">Privacidade</a><a href="/termos">Termos de uso</a></nav></footer><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
