@using System.Globalization
@{
    var currentCulture = CultureInfo.CurrentUICulture.Name;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var canonicalUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
    var languages = new[]
    {
        ("pt-BR", "Português", "🇧🇷"),
        ("en", "English", "🇺🇸"),
        ("fr", "Français", "🇫🇷"),
        ("es", "Español", "🇪🇸"),
        ("ru", "Русский", "🇷🇺"),
        ("zh-Hans", "简体中文", "🇨🇳"),
        ("ja", "日本語", "🇯🇵")
    };
    // Markup das opções montado fora da tag para evitar C# na área de atributos do <option>.
    var languageOptions = string.Concat(languages.Select(l =>
    {
        var selected = string.Equals(currentCulture, l.Item1, StringComparison.OrdinalIgnoreCase) ? " selected" : string.Empty;
        return $"<option value=\"{l.Item1}\"{selected}>{l.Item3} {l.Item2}</option>";
    }));
}
<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="@(ViewData["Description"] ?? Loc["Hero_Subtitle"].Value ?? "MinhaBelém: portal global de cultura, turismo, notícias, mobilidade e serviços de Belém do Pará.")" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} — MinhaBelém" : Loc["Brand_Tagline"].Value ?? "MinhaBelém — Nossa cidade. Mil histórias.")</title>

    <!-- Google Fonts Preconnect & Stylesheets -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">

    <!-- Open Graph & Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MinhaBelém" />
    <meta property="og:title" content="@(ViewData["Title"] != null ? $"{ViewData["Title"]} — MinhaBelém" : "MinhaBelém — Nossa cidade. Mil histórias.")" />
    <meta property="og:description" content="@(ViewData["Description"] ?? Loc["Hero_Subtitle"].Value ?? "Portal completo de notícias, eventos, turismo, mobilidade e cultura de Belém do Pará.")" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:locale" content="@currentCulture.Replace("-", "_")" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(ViewData["Title"] != null ? $"{ViewData["Title"]} — MinhaBelém" : "MinhaBelém — Nossa cidade. Mil histórias.")" />
    <meta name="twitter:description" content="@(ViewData["Description"] ?? Loc["Hero_Subtitle"].Value ?? "Portal completo de notícias, eventos, turismo, mobilidade e cultura de Belém do Pará.")" />

    <!-- Schema.org JSON-LD Structured Data -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "WebSite",
      "name": "MinhaBelém",
      "url": "@Context.Request.Scheme://@Context.Request.Host",
      "description": "Portal 360 de notícias, cultura, turismo e serviços de Belém do Pará",
      "potentialAction": {
        "@@type": "SearchAction",
        "target": "@Context.Request.Scheme://@Context.Request.Host/?busca={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
    </script>

    <!-- SEO & Multilingual Alternate Hreflang -->
    <link rel="canonical" href="@canonicalUrl" />
    @foreach (var lang in languages)
    {
        <link rel="alternate" hreflang="@lang.Item1" href="@($"{Context.Request.Scheme}://{Context.Request.Host}/{lang.Item1}")" />
    }
    <link rel="alternate" hreflang="x-default" href="@($"{Context.Request.Scheme}://{Context.Request.Host}/pt-BR")" />

    <link rel="icon" type="image/svg+xml" href="~/images/favicon.svg" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#123f36" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/accessibility.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="culture-@currentCulture.ToLowerInvariant() @(Context.Request.Path.StartsWithSegments("/admin") || Context.Request.Path.StartsWithSegments("/editorial") ? "administration" : "portal")">
    <a class="skip-link" href="#conteudo">@Loc["SkipToContent"]</a>
    <div class="connection-notice" role="status" data-connection-status data-offline="@Loc["InterfaceOffline"]" data-online="@Loc["InterfaceBackOnline"]" hidden></div>
    <div class="page-progress" aria-hidden="true"></div>

    <header class="header">
        <a class="brand" href="/" aria-label="MinhaBelém — página inicial">
            <span class="brand-mark" aria-hidden="true">
                <img src="/images/minhabelem-marca.svg" width="248" height="70" alt="" class="brand-logo" />
            </span>
            <span class="brand-tagline">
                <strong>Nossa cidade. Mil histórias.</strong>
                <small>Belém do Pará · Amazônia</small>
            </span>
        </a>

        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-navigation">@Loc["MenuToggle"] <span aria-hidden="true">☰</span></button>
        <nav id="main-navigation" class="main-nav" aria-label="@Loc["Nav_Home"]">
            <a href="/">@Loc["Nav_Home"]</a>
            <a href="/explore" class="nav-highlight">@Loc["Nav_Explore"]</a>
            <a href="/guia">@Loc["Nav_Guide"]</a>
            <a href="/agenda">@Loc["Nav_Agenda"]</a>
            <a href="/mobilidade">@Loc["NavMobility"]</a>
            <a href="/como-chegar">@Loc["RouteTitle"]</a>
            <a href="/guia-ia" class="nav-ai-highlight">✨ @Loc["TouristAssistantTitle"]</a>
            <a href="/videos" class="nav-media-highlight">🎬 @Loc["VideoGalleryTitle"]</a>
            <a href="/meu-bairro">@Loc["NavNeighborhood"]</a>
            <a href="/salvos">@Loc["SavedPlans"]</a>
            <a href="/parceiros">@Loc["NavPartners"]</a>
            <a href="/explore/glossario">@Loc["Glossary_Title"]</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a href="/conta/perfil">@Loc["Nav_Account"]</a>
                @if (User.HasClaim("amr", "mfa"))
                {
                    <a href="/admin" class="nav-highlight">⚙️ @Loc["Admin_Dashboard"]</a>
                }
            }
            else
            {
                <a href="/conta/login" class="nav-login">@Loc["Nav_Login"]</a>
            }
        </nav>

        <div class="header-tools">
            <!-- Modo Escuro / Claro -->
            <button type="button" class="theme-toggle" aria-label="Alternar tema" aria-pressed="false">🌙</button>

            <!-- Botão de Acessibilidade Visual (WCAG 2.2 AA) -->
            <button type="button" class="a11y-trigger-btn" data-open-a11y aria-haspopup="dialog" aria-expanded="false" title="@Loc["A11y_Panel_Title"]">
                <span aria-hidden="true">♿</span>
                <span>@Loc["A11y_Open_Panel"]</span>
            </button>

            <!-- Language Switcher Selector -->
            <form action="/idioma/mudar" method="get" class="lang-selector-form" aria-label="@Loc["Language_Selector_Title"]">
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <span class="lang-icon" aria-hidden="true">🌐</span>
                <select name="cultura" onchange="this.form.submit()" aria-label="@Loc["Language_Selector_Title"]" class="lang-select">
                    @Html.Raw(languageOptions)
                </select>
                <noscript><button type="submit">OK</button></noscript>
            </form>
        </div>
    </header>

    @if (User.Identity?.IsAuthenticated == true && User.HasClaim("amr","mfa") && !Context.Request.Path.StartsWithSegments("/admin") && !Context.Request.Path.StartsWithSegments("/editorial"))
    {
        <div class="city-ribbon" role="navigation" aria-label="@Loc["AdminNavigation"]">
            <span class="live-dot" aria-hidden="true"></span>
            <strong>@Loc["Admin_Dashboard"]:</strong>
            <span>Sessão com autenticação em dois fatores ativa.</span>
            <a href="/admin">Abrir Painel Administrativo ↗</a>
            <a href="/editorial">Área Editorial ↗</a>
        </div>
    }

    <main id="conteudo" tabindex="-1">
        @if (TempData["Notice"] is string notice)
        {
            <div class="notice" role="status">
                <span class="notice-icon">ℹ️</span>
                <span>@notice</span>
            </div>
        }
        @if (Context.Request.Path != "/" && !MinhaBelem.Web.Resources.SupportedCultures.All.Any(c => Context.Request.Path == "/" + c))
        {
            <nav class="breadcrumbs" aria-label="@Loc["NavHome"]"><a href="/">@Loc["NavHome"]</a><span aria-hidden="true">/</span><span>@(ViewData["Title"] ?? Loc["SiteTitle"].Value)</span></nav>
        }
        @RenderBody()
    </main>

    <footer class="footer footer-pattern">
        <div class="footer-container">
            <div class="footer-col brand-col">
                <img src="/images/minhabelem-marca.svg" width="240" height="68" alt="MinhaBelém — Nossa cidade. Mil histórias." class="footer-logo" />
                <strong class="footer-brand">MinhaBelém</strong>
                <p class="footer-tagline">@Loc["Brand_Tagline"]</p>
                <p class="footer-sub">Belém do Pará, Amazônia, Brasil 🇧🇷</p>
                <p class="footer-curio">
                    <img src="/images/curio-marca.svg" width="26" height="26" alt="" aria-hidden="true" />
                    <span>Curió · o guia inteligente de Belém</span>
                </p>
                <p class="small footer-copy">&copy; @DateTime.UtcNow.Year MNSOFT — @Loc["General_AllRightsReserved"]</p>
            </div>
            <div class="footer-col">
                <h4>@Loc["Nav_Explore"]</h4>
                <nav aria-label="@Loc["Nav_Explore"]">
                    <a href="/explore">@Loc["Explore_Hero_Title"]</a>
                    <a href="/explore/roteiro/belem-express-1-dia">1 Dia em Belém</a>
                    <a href="/explore/roteiro/belem-cultural-2-dias">2 Dias Cultural</a>
                    <a href="/explore/roteiro/belem-completa-3-dias">3 Dias Completa</a>
                    <a href="/explore/roteiro/amazonia-urbana-ilhas-5-dias">5 Dias Ilhas e Natureza</a>
                    <a href="/explore/glossario">@Loc["Glossary_Title"]</a>
                    <a href="/videos">🎬 @Loc["VideoGalleryTitle"]</a>
                    <a href="/midias">📷 @Loc["MediaGalleryTitle"]</a>
                </nav>
            </div>
            <div class="footer-col">
                <h4>🏙️ @Loc["Nav_Guide"]</h4>
                <nav aria-label="@Loc["Nav_Guide"]">
                    <a href="/guia">@Loc["Nav_Guide"]</a>
                    <a href="/guia/acervo">@Loc["PhotoArchiveTitle"]</a>
                    <a href="/salvos">@Loc["SavedPlans"]</a>
                    <a href="/agenda">@Loc["Nav_Agenda"]</a>
                    <a href="/?categoria=cultura">@Loc["Category_Culture"]</a>
                    <a href="/?categoria=gastronomia">@Loc["Category_Gastronomy"]</a>
                    <a href="/?categoria=mobilidade">@Loc["Category_Mobility"]</a>
                </nav>
            </div>
            <div class="footer-col">
                <h4>⚖️ @Loc["Nav_Account"]</h4>
                <nav aria-label="Institucional">
                    <a href="/privacidade">@Loc["Nav_Privacy"]</a>
                    <a href="/termos">@Loc["Nav_Terms"]</a>
                    <a href="#a11y" data-open-a11y>♿ @Loc["A11y_Panel_Title"]</a>
                    <a href="/sitemap.xml" target="_blank">Sitemap XML</a>
                    <a href="/operacao">@Loc["PlatformStatus"]</a>
                </nav>
                <div class="footer-languages">
                    <span class="small">@Loc["Language_Selector_Title"]:</span>
                    <div class="footer-lang-links">
                        @foreach (var lang in languages)
                        {
                            <a href="/idioma/mudar?cultura=@lang.Item1&returnUrl=@Uri.EscapeDataString(returnUrl)" class="lang-pill @(string.Equals(currentCulture, lang.Item1, StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                @lang.Item3 @lang.Item1
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Botão flutuante de IA (Curió) -->
    <button class="ai-float-btn" data-href="/guia-ia" aria-label="Converse com o Curió IA — assistente turístico de Belém" title="Curió IA — Pergunte sobre Belém">
        ✨
        <span class="ai-float-badge" aria-hidden="true">IA</span>
    </button>

    <!-- Lightbox para fotos e vídeos -->
    <div id="mb-lightbox" class="mb-lightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Visualizador de mídia">
        <button id="mb-lightbox-prev" class="mb-lightbox-nav" aria-label="Anterior">&#10094;</button>
        <div id="mb-lightbox-content" class="mb-lightbox-content"></div>
        <div id="mb-lightbox-caption" class="mb-lightbox-caption"></div>
        <button id="mb-lightbox-close" class="mb-lightbox-close" aria-label="Fechar visualizador">✕</button>
        <button id="mb-lightbox-next" class="mb-lightbox-nav" aria-label="Próximo">&#10095;</button>
    </div>

    <partial name="_AccessibilityPanel" />
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/evolution.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
