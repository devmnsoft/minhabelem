@model MinhaBelem.Core.Entities.RadarDashboardStats
@using MinhaBelem.Core.Entities
@using MinhaBelem.Web.Models
<section class="card radar-operations" aria-labelledby="radar-operations-title">
    <h2 id="radar-operations-title">@Loc["RadarOperations"]</h2>
    @if (Model.Heartbeat is null || Model.Heartbeat.Status is WorkerStatus.Off or WorkerStatus.Delayed)
    {
        <p class="notice" role="alert">@Loc["RadarNoHeartbeat"]</p>
    }
    @if (Model.Heartbeat?.ConsecutiveErrors >= 3 || Model.Heartbeat?.Status == WorkerStatus.Error)
    {
        <p class="notice" role="alert">@Loc["RadarFailures"]</p>
    }
    <p class="small text-muted">@Loc["RadarTelemetryNote"]</p>
    @if(Model.ActiveSources==0){<p class="notice" role="status">@Loc["RadarNoAuthorizedSources"]</p>}
    <dl class="radar-operation-metrics">
        <div><dt>@Loc["RadarEnabled"]</dt><dd>@Model.EnabledSources</dd></div>
        <div><dt>@Loc["RadarApproved"]</dt><dd>@Model.ApprovedSources</dd></div>
        <div><dt>@Loc["RadarOperational"]</dt><dd>@Model.ActiveSources</dd></div>
        <div><dt>@Loc["RadarConsulted"]</dt><dd>@Model.ConsultedSources</dd></div>
        <div><dt>@Loc["RadarPublished"]</dt><dd>@Model.PublishedItems</dd></div>
        <div><dt>@Loc["RadarAiCost"]</dt><dd>@Model.AiCostUsd.ToString("N6")</dd></div>
    </dl>
    <h3>@Loc["RadarCycles"]</h3>
    @if (Model.RecentCycles.Count == 0) { <p>@Loc["RadarNoCycles"]</p> }
    else
    {
        <div class="table-scroll">
            <table class="table">
                <thead><tr><th scope="col">@Loc["RadarStarted"]</th><th scope="col">@Loc["RadarCycleStatus"]</th><th scope="col">@Loc["RadarChecked"]</th><th scope="col">@Loc["RadarSuccessRate"]</th><th scope="col">@Loc["RadarItems"]</th><th scope="col">@Loc["RadarDuration"]</th></tr></thead>
                <tbody>
                @foreach (var cycle in Model.RecentCycles)
                {
                    <tr><td>@PortalTime.Local(cycle.StartedAt).ToString("g")</td><td>@Loc["RadarCycle_" + cycle.Status] @if(cycle.SourcesChecked==0){<small class="small">@Loc["RadarEmptyCycle"]</small>}</td><td>@cycle.SourcesChecked / @cycle.SourcesFailed</td><td>@(cycle.SuccessRate is {} rate ? rate.ToString("N1") + "%" : "—")</td><td>@cycle.ItemsDiscovered / @cycle.EventsIdentified</td><td>@((cycle.DurationMs / 1000m).ToString("N1"))</td></tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
