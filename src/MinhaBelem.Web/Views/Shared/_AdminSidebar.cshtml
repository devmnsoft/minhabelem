@using MinhaBelem.Core.Security

@{
    var currentPath = Context.Request.Path.Value?.ToLowerInvariant() ?? "";
}

<aside class="admin-sidebar" aria-label="@Loc["AdminNavigation"]">
    <div class="admin-brand"><span>@Loc["Admin_Dashboard"]</span><strong>MinhaBelém 360</strong></div>

    <!-- GRUPO: EDITORIAL -->
    <div class="admin-sidebar-group">
        <span class="admin-sidebar-heading">@Loc["AdminContent"]</span>
        @if(User.HasClaim("mb:permission",Permissions.DashboardRead)){
        <a href="/admin" class="@(currentPath == "/admin" ? "active" : "")">
            <span>📊</span> @Loc["Admin_Dashboard"]
        </a>
        <a href="/admin/evolucao" class="@(currentPath.StartsWith("/admin/evolucao") ? "active" : "")">
            <span>🚀</span> @Loc["AdminProgress"]
        </a>
        }
        @if (User.HasClaim("mb:permission", Permissions.ContentRead))
        {
            <a href="/admin/conteudo" class="@(currentPath.StartsWith("/admin/conteudo") ? "active" : "")">
                <span>📰</span> @Loc["AdminContent"]
            </a>
            <a href="/editorial" class="@(currentPath.StartsWith("/editorial") ? "active" : "")">
                <span>✍️</span> @Loc["AdminEditorial"]
            </a>
            <a href="/editorial/lotes">@Loc["BatchTitle"]</a>
            @if(User.HasClaim("mb:permission",Permissions.ContentWrite)){<a href="/admin/midias">@Loc["PhotoGallery"]</a>}
            @if(User.HasClaim("mb:permission",Permissions.ContentWrite)){<a href="/admin/midias/submissoes">📨 Submissões de mídia</a>}
        }
        @if (User.HasClaim("mb:permission", Permissions.PlaceManage))
        {
            <a href="/admin/lugares" class="@(currentPath.StartsWith("/admin/lugares") ? "active" : "")">
                <span>📍</span> @Loc["AdminPlaces"]
            </a>
            <a href="/admin/fotos" class="@(currentPath.StartsWith("/admin/fotos") ? "active" : "")">
                <span>🖼️</span> Fotos dos locais
            </a>
            <a href="/admin/visitas" class="@(currentPath.StartsWith("/admin/visitas") ? "active" : "")">
                <span>🗓️</span> @Loc["AdminVisits"]
            </a>
        }
        @if (User.HasClaim("mb:permission", Permissions.SubmissionModerate))
        {
            <a href="/admin/colaboracoes" class="@(currentPath.StartsWith("/admin/colaboracoes") ? "active" : "")">
                <span>📬</span> @Loc["AdminSubmissions"]
            </a>
        }
    </div>

    <!-- GRUPO: CIDADE & SERVIÇOS -->
    <div class="admin-sidebar-group">
        <span class="admin-sidebar-heading">@Loc["AdminCityServices"]</span>
        @if (User.HasClaim("mb:permission", Permissions.SettingsManage))
        {
            <a href="/admin/mobilidade" class="@(currentPath.StartsWith("/admin/mobilidade") ? "active" : "")">
                <span>🚌</span> @Loc["NavMobility"]
            </a>
        }
        @if (User.HasClaim("mb:permission", Permissions.PlaceManage))
        {
            <a href="/admin/bairros" class="@(currentPath.StartsWith("/admin/bairros") ? "active" : "")">
                <span>🏘️</span> @Loc["NavNeighborhood"]
            </a>
        }
    </div>

    <!-- GRUPO: INTELIGÊNCIA DIGITAL & IA -->
    <div class="admin-sidebar-group">
        <span class="admin-sidebar-heading">@Loc["AdminIntelligence"]</span>
        @if (User.HasClaim("mb:permission", Permissions.SourceManage))
        {
            <a href="/admin/radar" class="@(currentPath.StartsWith("/admin/radar") ? "active" : "")">
                <span>🧭</span> MinhaBelém Radar
            </a>
            <a href="/admin/fontes" class="@(currentPath.StartsWith("/admin/fontes") ? "active" : "")">
                <span>📡</span> @Loc["AdminSources"]
            </a>
        }
        @if (User.HasClaim("mb:permission", Permissions.TranslationRead))
        {
            <a href="/admin/traducoes" class="@(currentPath.StartsWith("/admin/traducoes") ? "active" : "")">
                <span>🌐</span> @Loc["AdminAiReview"]
            </a>
            <a href="/admin/idiomas" class="@(currentPath.StartsWith("/admin/idiomas") ? "active" : "")">
                <span>🗣️</span> @Loc["Admin_Languages"]
            </a>
        }
        @if (User.HasClaim("mb:permission", Permissions.DashboardRead))
        {
            <a href="/admin/relatorios" class="@(currentPath.StartsWith("/admin/relatorios") ? "active" : "")">
                <span>📈</span> @Loc["AdminReports"]
            </a>
        }
    </div>

    <!-- GRUPO: NEGÓCIOS -->
    @if (User.HasClaim("mb:permission", Permissions.AdvertiserManage))
    {
        <div class="admin-sidebar-group">
            <span class="admin-sidebar-heading">@Loc["AdminBusiness"]</span>
            <a href="/admin/anunciantes" class="@(currentPath.StartsWith("/admin/anunciantes") ? "active" : "")">
                <span>💼</span> @Loc["NavPartners"]
            </a>
        </div>
    }

    <!-- GRUPO: SISTEMA & SEGURANÇA -->
    <div class="admin-sidebar-group">
        <span class="admin-sidebar-heading">@Loc["AdminSecurity"]</span>
        @if (User.HasClaim("mb:permission", Permissions.UserManage))
        {
            <a href="/admin/usuarios" class="@(currentPath.StartsWith("/admin/usuarios") ? "active" : "")">
                <span>👥</span> @Loc["AdminUsers"]
            </a>
            <a href="/admin/perfis" class="@(currentPath.StartsWith("/admin/perfis") ? "active" : "")">
                <span>🛡️</span> @Loc["AdminRoles"]
            </a>
        }
        @if (User.HasClaim("mb:permission", Permissions.AuditRead))
        {
            <a href="/admin/auditoria" class="@(currentPath.StartsWith("/admin/auditoria") ? "active" : "")">
                <span>📜</span> @Loc["AdminAudit"]
            </a>
        }
        @if (User.HasClaim("mb:permission", Permissions.SettingsManage))
        {
            <a href="/admin/integracoes" class="@(currentPath.StartsWith("/admin/integracoes") ? "active" : "")">
                <span>🔌</span> @Loc["AdminIntegrations"]
            </a>
            <a href="/admin/configuracoes" class="@(currentPath.StartsWith("/admin/configuracoes") ? "active" : "")">
                <span>⚙️</span> @Loc["AdminSettings"]
            </a>
        }
    </div>
</aside>
