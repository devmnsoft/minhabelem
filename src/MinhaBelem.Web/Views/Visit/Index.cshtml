@using System.Text.Json
@using MinhaBelem.Web.Models
@inject IConfiguration Configuration
@model MinhaBelem.Web.Controllers.VisitPage
@{ViewData["Title"]=Loc["RouteTitle"];var modes=new[]{"transit","walking","bicycling","driving","boat"};var price=Model.EntryPrice;var share="/como-chegar?"+(Model.Query.PlaceId is {} placeId?"placeId="+placeId:"destino="+Uri.EscapeDataString(Model.Query.Destination));}
<section class="hero"><p class="eyebrow">MINHABELÉM · @Loc["NavMobility"]</p><h1>@Loc["RouteTitle"]</h1><p>@Loc["RouteIntro"]</p></section>
<main class="section route-shell"><div class="route-columns"><section class="card"><h2>@Loc["RoutePlan"]</h2><form method="post" action="/mobilidade/como-chegar" class="route-form">@Html.AntiForgeryToken()
<label>@Loc["RouteOrigin"]<input name="Origin" id="route-origin" value="@Model.Query.Origin" list="route-places" maxlength="350" required autocomplete="off"/></label><button type="button" id="route-location" class="button secondary">@Loc["RouteLocation"]</button><p id="route-location-status" class="small" role="status">@Loc["RoutePrivacy"]</p>
<label>@Loc["RouteDestination"]<input name="Destination" value="@Model.Query.Destination" list="route-places" maxlength="350" required/></label><datalist id="route-places">@foreach(var p in (IReadOnlyList<MinhaBelem.Core.Entities.Place>)ViewData["Places"]!){<option value="@(p.DisplayName+", "+p.FormattedAddress+", "+p.Municipality)"/>}</datalist>
@if(Model.Query.PlaceId is {} pid){<input type="hidden" name="PlaceId" value="@pid"/>}
<label>@Loc["RouteWhen"]<input name="LocalTime" type="datetime-local" value="@Model.Query.LocalTime?.ToString("yyyy-MM-ddTHH:mm")"/></label><label><input type="checkbox" name="ArriveBy" value="true" checked="@Model.Query.ArriveBy"/> @Loc["RouteArriveBy"]</label><label>@Loc["RouteMode"]<select name="Mode">@foreach(var m in modes){<option value="@m" selected="@(Model.Query.Mode==m)">@Loc["RouteMode_"+m]</option>}</select></label>
<label>@Loc["RoutePreference"]<select name="Preference">@foreach(var p in new[]{"less_walking","less_transfers","fastest","cheapest"}){<option value="@p" selected="@(Model.Query.Preference==p)">@Loc["RoutePreference_"+p]</option>}</select></label><label>@Loc["RouteWalkLimit"]<input type="number" name="MaxWalkMeters" min="0" max="10000" value="@Model.Query.MaxWalkMeters"/></label><label><input type="checkbox" name="Accessible" value="true" checked="@Model.Query.Accessible"/> @Loc["RouteAccessible"]</label>
<label>@Loc["RouteReturnCost"]<input type="number" name="inbound" min="0" max="100000" step="0.01" value="@Model.Inbound?.ToString(System.Globalization.CultureInfo.InvariantCulture)"/></label><label>@Loc["RouteOptional"]<input type="number" name="optional" min="0" max="100000" step="0.01" value="@Model.Optional.ToString(System.Globalization.CultureInfo.InvariantCulture)"/></label><button>@Loc["RouteCalculate"]</button></form></section>
<section class="card route-map-panel"><h2>@Loc["RouteMap"]</h2>
@if(Model.Plan.Options.Any(x=>x.Polyline is not null)&&Configuration["Maps:BrowserKey"] is {Length:>0} mapKey){<div id="visit-map" class="visit-map" role="region" aria-label="@Loc["RouteMap"]"></div><script id="route-geometries" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.Plan.Options.Select(x=>x.Polyline).Where(x=>x is not null)))</script><script src="~/js/route-map.js"></script><script src="https://maps.googleapis.com/maps/api/js?key=@Uri.EscapeDataString(mapKey)&amp;libraries=geometry&amp;callback=initVisitMap" async defer></script>}
else{<div class="route-map-empty"><svg aria-hidden="true" width="72" height="72"><use href="/images/icons.svg#boat"/></svg><p>@Loc["RouteMapFallback"]</p></div>}
<a class="button secondary" href="@Model.Plan.ExternalUrl" target="_blank" rel="noopener noreferrer">@Loc[Model.Query.Mode=="boat"?"WaterOfficialSource":"RouteOpenMaps"] ↗</a><p class="notice">@Loc["RouteRealtimeUnavailable"]</p><p>@Loc["RouteState_"+Model.Plan.State]</p><p class="small">@Loc["RouteSource"]: @Model.Plan.Provider · @(Model.Plan.QueriedAt is {} queried?PortalTime.Local(queried).ToString("g"):Loc["RouteUnknown"].Value)</p></section></div>
<section class="section"><h2>@Loc["RouteAlternatives"]</h2><div class="grid">@foreach(var option in Model.Plan.Options){<article class="card"><h3>@option.Description</h3><p>@(option.DistanceMeters/1000d) km · @Math.Ceiling(option.DurationSeconds/60d) min</p><p>@(option.Fare is {} fare?option.Currency+" "+fare.ToString("F2"):Loc["RouteUnknown"].Value) · @Loc["RouteEstimate"]</p><ol class="journey-timeline">@foreach(var step in option.Steps){<li><strong>@(step.Mode=="WALK"?Loc["RouteMode_walking"].Value:step.Line??step.Mode)</strong><p>@step.Instruction</p>@if(step.Board is not null){<p>@Loc["RouteBoard"]: @step.Board → @Loc["RouteAlight"]: @step.Alight</p>}@if(step.Departure is {} departure){<time>@PortalTime.Local(departure.UtcDateTime).ToString("g")</time>}</li>}</ol></article>}</div></section>
<section class="card"><h2>@Loc["RouteVisit"]</h2>@if(Model.Place is {} place){<a href="/guia/@place.Id">@place.DisplayName</a>}<p>@Loc["VisitState_"+Model.Assessment.State]</p>@if(Model.Assessment.NextChangeUtc is {} next){<p>@PortalTime.Local(next).ToString("f")</p>}@if(Model.Schedule.Info is {} info){<p><a href="@info.SourceUrl" rel="noopener noreferrer" target="_blank">@Loc["RouteSource"] ↗</a> · @info.ConfirmedAt.ToString("d") → @info.ValidUntil.ToString("d")</p><p>@info.PriceConditions</p>}
<dl><dt>@Loc["RouteEntry"]</dt><dd>@(price is {} entry?"BRL "+entry.ToString("F2"):Loc["RouteUnknown"].Value)</dd><dt>@Loc["RouteKnownSubtotal"]</dt><dd>BRL @Model.KnownSubtotal.ToString("F2")</dd><dt>@Loc["RouteTotal"]</dt><dd>@(Model.Total is {} total?"BRL "+total.ToString("F2"):Loc["RouteIncompleteCost"].Value)</dd></dl><p>@Loc["RouteNoCrowding"]</p><a href="https://wa.me/?text=@Uri.EscapeDataString(Context.Request.Scheme+"://"+Context.Request.Host+share)" target="_blank" rel="noopener noreferrer">@Loc["RouteShare"] ↗</a><p class="small">@Loc["RoutePrivacy"]</p></section>
<section class="section"><h2>@Loc["RouteAlerts"]</h2>@foreach(var alert in Model.Alerts){<article class="notice"><strong>@alert.Title</strong><p>@alert.Description</p><p>@alert.Neighborhood · @alert.StartAt.ToString("g") → @alert.EndAt?.ToString("g")</p></article>}</section></main><script src="~/js/visit.js" defer></script>
