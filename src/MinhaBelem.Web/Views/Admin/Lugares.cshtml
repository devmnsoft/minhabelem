@model IReadOnlyList<MinhaBelem.Core.Entities.Place>

@{
    ViewData["Title"] = "Curadoria do Guia de Lugares";
}

<div class="admin-shell">
    <partial name="_AdminSidebar" />

    <main class="admin-content">
        <div class="admin-header">
            <div>
                <span class="eyebrow">GUIA DA CIDADE & GOOGLE PLACES</span>
                <h1 class="view-26731c99">Curadoria de Lugares & Atrações</h1>
                <p class="small text-muted">Cadastro de identificadores do Google Places e notas editoriais próprias, sem armazenar indevidamente fotos ou avaliações de terceiros.</p>
            </div>
            <a href="#novo-lugar" class="button small">➕ Cadastrar Novo Lugar</a>
        </div>

        @if (TempData["Notice"] is string notice)
        {
            <div class="notice" role="status">
                <span>ℹ️ @notice</span>
            </div>
        }

        <!-- GRADE DE LUGARES CADASTRADOS -->
        <h2 class="view-975245e1">Locais Cadastrados no Guia (@Model.Count)</h2>
        <div class="view-4c34f994 grid">
            @if (Model.Count == 0)
            {
                <div class="view-01d607cb card empty">
                    <p>Nenhum lugar cadastrado no momento.</p>
                </div>
            }
            @foreach (var place in Model)
            {
                <article class="card">
                    <span class="eyebrow">@(place.PrimaryType ?? "Atração")</span>
                    <h3><a href="/guia/@place.Id">@place.Name</a></h3>
                    <p>@place.EditorialNote</p>
                    <div class="card-meta">
                        <span>📍 @place.Neighborhood, @place.Municipality</span>
                        <span style="margin-left:auto;">
                            <a href="/guia/@place.Id" class="button-link">Ver ficha →</a>
                        </span>
                    </div>
                </article>
            }
        </div>

        <!-- FORMULÁRIO DE CADASTRO DE LOCAL -->
        <div id="novo-lugar" class="view-5afd4f17 card">
            <h2 class="view-a0b99945">Cadastrar Novo Estabelecimento / Atração</h2>
            <form method="post" asp-action="SalvarLugar" style="max-width:800px;">
                @Html.AntiForgeryToken()

                <div class="view-0e3686f0 grid">
                    <label>
                        Google Place ID *
                        <input name="googlePlaceId" maxlength="255" required placeholder="Chave ChIJ..." />
                    </label>

                    <label>
                        Nome Editorial Próprio *
                        <input name="name" maxlength="300" required placeholder="Ex: Mercado Ver-o-Peso" />
                    </label>
                </div>

                <label>
                    Descrição / Resenha Editorial Própria
                    <textarea name="note" maxlength="1000" rows="3" placeholder="Informações culturais, história e orientações aos visitantes..."></textarea>
                </label>

                <div class="view-c2fdb273 grid">
                    <label>
                        Bairro
                        <input name="bairro" maxlength="120" placeholder="Campina, Nazaré..." />
                    </label>

                    <label>
                        Município
                        <input name="municipio" maxlength="120" value="Belém" />
                    </label>

                    <label>
                        Categoria Principal
                        <select name="Category">
                            <option value="">Sem categoria</option>
                            @foreach (var type in MinhaBelem.Infrastructure.Places.PlacesCatalog.Types)
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                    </label>
                </div>

                <fieldset class="view-5afb97bc">
                    <legend class="view-ed9e32ea">Públicos Confirmados pela Equipe</legend>
                    <div class="view-1b6abf54">
                        @foreach (var audience in Enum.GetNames<MinhaBelem.Core.Taxonomy.Audience>())
                        {
                            <label class="view-299715b9">
                                <input type="checkbox" name="Audiences" value="@audience" class="view-ba78805d" /> @audience
                            </label>
                        }
                    </div>
                </fieldset>

                <fieldset class="view-5afb97bc">
                    <legend class="view-ed9e32ea">Acessibilidade Confirmada</legend>
                    <div class="view-1b6abf54">
                        @foreach (var feature in Enum.GetNames<MinhaBelem.Core.Taxonomy.AccessibilityFeature>())
                        {
                            <label class="view-299715b9">
                                <input type="checkbox" name="Accessibility" value="@feature" class="view-ba78805d" /> @feature
                            </label>
                        }
                    </div>
                </fieldset>

                <button type="submit">Salvar Local no Guia</button>
            </form>
        </div>
    </main>
</div>
