@model IReadOnlyList<MinhaBelem.Core.Entities.Place>
<section class="section"><h1>Curadoria do guia</h1><p>Cadastre o identificador do Google e textos próprios, obtidos com autorização. Os detalhes do Google são consultados ao abrir o local, sem armazenar fotos ou avaliações.</p><div class="grid">@foreach(var place in Model){<article class="card"><h2><a href="/guia/@place.Id">@place.Name</a></h2><p>@place.EditorialNote</p></article>}</div><h2>Cadastrar local</h2><form method="post" asp-action="SalvarLugar"><label>Google Place ID<input name="googlePlaceId" maxlength="255" required /></label><label>Nome editorial próprio<input name="name" maxlength="300" required /></label><label>Descrição própria<textarea name="note" maxlength="1000"></textarea></label><label>Bairro<input name="bairro" maxlength="120" /></label><label>Município<input name="municipio" maxlength="120" /></label><button>Salvar no guia</button></form></section>
