@model MinhaBelem.Core.Entities.RiverRoute
@{ViewData["Title"]=Loc["RiverEditor"];}
<div class="admin-shell"><partial name="_AdminSidebar"/><main class="admin-content"><header class="admin-header"><h1>@Loc["RiverEditor"]</h1><p>@Loc["RiverEvidenceNotice"]</p></header><form method="post" action="/admin/mobilidade/fluvial" class="card route-form">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@Model.Id"/><input type="hidden" name="expectedRevision" value="@Model.Revision"/>
<label>@Loc["NameLabel"]<input name="Name" value="@Model.Name" required maxlength="150"/></label><label>@Loc["RouteOrigin"]<input name="DeparturePort" value="@Model.DeparturePort" required maxlength="200"/></label><label>@Loc["RouteDestination"]<input name="DestinationPort" value="@Model.DestinationPort" required maxlength="200"/></label><label>@Loc["RiverIsland"]<input name="DestinationIsland" value="@Model.DestinationIsland" list="river-islands" maxlength="100"/></label><datalist id="river-islands"><option value="Combu"/><option value="Cotijuba"/><option value="Mosqueiro"/><option value="Icoaraci"/></datalist>
<label>@Loc["RiverOperator"]<input name="OperatorName" value="@Model.OperatorName" maxlength="150"/></label><label>@Loc["RiverVessel"]<input name="VesselType" value="@Model.VesselType" maxlength="100"/></label><label>@Loc["RiverDuration"]<input type="number" name="EstimatedDurationMinutes" min="0" max="1440" value="@Model.EstimatedDurationMinutes"/></label><label>@Loc["RouteEntry"] (BRL)<input name="Fare" type="number" min="0" max="10000" step=".01" value="@Model.Fare.ToString(System.Globalization.CultureInfo.InvariantCulture)"/></label>
<label>@Loc["RiverHours"]<textarea name="OperatingHours" maxlength="1000">@Model.OperatingHours</textarea></label><label>@Loc["RiverConditions"]<textarea name="OperatorNotes" maxlength="2000">@Model.OperatorNotes</textarea></label><label>@Loc["RouteAccessible"]<select name="IsAccessible"><option value="">@Loc["RouteUnknown"]</option><option value="true" selected="@(Model.IsAccessible==true)">@Loc["Yes"]</option><option value="false" selected="@(Model.IsAccessible==false)">@Loc["No"]</option></select></label>
<label>@Loc["RouteSource"]<input name="SourceUrl" type="url" value="@Model.SourceUrl" maxlength="2000"/></label><label>@Loc["RiverVerified"] (UTC)<input name="VerifiedAt" type="datetime-local" value="@Model.VerifiedAt?.ToString("yyyy-MM-ddTHH:mm")"/></label><label>@Loc["RiverValidUntil"] (UTC)<input name="ValidUntil" type="datetime-local" value="@Model.ValidUntil?.ToString("yyyy-MM-ddTHH:mm")"/></label><label>@Loc["RiverFareUntil"] (UTC)<input name="FareValidUntil" type="datetime-local" value="@Model.FareValidUntil?.ToString("yyyy-MM-ddTHH:mm")"/></label><label><input name="IsActive" type="checkbox" value="true" checked="@Model.IsActive"/>@Loc["RiverActivate"]</label><input name="IsActive" type="hidden" value="false"/><button>@Loc["Save"]</button></form><a href="/admin/mobilidade">@Loc["NavMobility"]</a></main></div>
