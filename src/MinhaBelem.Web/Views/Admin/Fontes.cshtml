@model IReadOnlyList<MinhaBelem.Core.Entities.IngestionSource>
@using MinhaBelem.Core.Entities
@using MinhaBelem.Core.Services
@{ var profiles = ViewData["Profiles"] as Dictionary<long,SourceProfile> ?? new(); }
<section class="section"><h1>Fontes e monitoramento</h1><p>Apenas fontes aprovadas e habilitadas são consultadas. A coleta respeita robots.txt.</p><div class="table-wrap"><table><thead><tr><th>Fonte</th><th>Estado</th><th>Última consulta (UTC)</th><th>Falhas</th><th>Ação</th></tr></thead><tbody>@foreach(var source in Model){<tr><td><a href="@(MinhaBelem.Core.Security.SafeUrl.Validate(source.FeedUrl).IsValid ? source.FeedUrl : null)" rel="noopener noreferrer">@source.Name</a><p>@source.Protocol · @source.LicenseNote</p><p>@profiles.GetValueOrDefault(source.Id)?.OwnerName · @profiles.GetValueOrDefault(source.Id)?.Organization · @profiles.GetValueOrDefault(source.Id)?.Region</p><p>Frequência: @profiles.GetValueOrDefault(source.Id)?.FrequencyMinutes min · Cota: @profiles.GetValueOrDefault(source.Id)?.DailyRequestLimit/dia</p></td><td>@(!source.Approved ? "Não autorizada" : !source.Enabled ? "Suspensa" : MinhaBelem.Web.Models.SourceStatusLabels.Label(profiles.GetValueOrDefault(source.Id)?.Status))</td><td>@source.LastCheckedAt<p>Próxima: @profiles.GetValueOrDefault(source.Id)?.NextDueAt</p><p>Estado: @MinhaBelem.Web.Models.SourceStatusLabels.Label(profiles.GetValueOrDefault(source.Id)?.Status) · Registros: @profiles.GetValueOrDefault(source.Id)?.RecordsFound</p></td><td>@source.ConsecutiveFailures · @source.LastError</td><td><form method="post" asp-action="SuspenderFonte" asp-route-id="@source.Id"><button>Suspender</button></form><details><summary>Permissão de mídia</summary><form method="post" asp-action="PermitirMidia" asp-route-id="@source.Id"><label>Licença e evidência da autorização<textarea name="license" maxlength="1000" required></textarea></label><label><input type="checkbox" name="allowed" value="true" /> Autorizar análise local de mídia</label><button>Registrar permissão</button></form></details></td></tr>}</tbody></table></div>
<form method="post" asp-action="ExecutarColeta"><button>Verificar fontes com agendamento vencido</button></form><h2>Cadastrar ou atualizar por URL</h2><form method="post" asp-action="SalvarFonte"><label>Nome<input name="Name" maxlength="200" required /></label><label>URL HTTPS<input name="FeedUrl" type="url" maxlength="2000" required /></label><label>Protocolo<select name="Protocol">@foreach(var protocol in Enum.GetNames<FeedProtocol>()){<option>@protocol</option>}</select></label><label>Assuntos<input name="Topics" maxlength="255" /></label><label>Município<input name="Municipality" maxlength="120" /></label><label>Autorização, licença e política de uso<textarea name="LicenseNote" maxlength="500" required></textarea></label><label><input type="checkbox" name="Approved" value="true" /> Fonte autorizada após conferência</label><label><input type="checkbox" name="Enabled" value="true" /> Habilitar consulta</label><label>Responsável<input name="OwnerName" maxlength="180" /></label><label>Organização<input name="Organization" maxlength="200" /></label><label>Região<input name="Region" maxlength="120" value="Pará" /></label><label>Palavras-chave<input name="Keywords" maxlength="500" /></label><label>Frequência (minutos)<input name="FrequencyMinutes" type="number" value="10" min="10" max="1440" /></label><label>Limite diário de requisições<input name="DailyRequestLimit" type="number" value="24" min="1" max="1000" /></label><label>Itens por consulta<input name="MaxItems" type="number" value="20" min="1" max="100" /></label><label>Referência de credencial (nunca a chave ou token)<input name="CredentialReference" maxlength="80" pattern="[a-zA-Z0-9_-]{1,80}" /></label><button>Salvar fonte</button></form>
<h2>Execuções recentes</h2><ul>@foreach(var run in ViewData["Runs"] as IReadOnlyList<IngestionRun> ?? Array.Empty<IngestionRun>()){<li>@run.StartedAt UTC · @run.Status · @run.SourcesChecked fontes · @run.ItemsInserted itens · @run.SourcesFailed falhas · @run.Error</li>}</ul></section>
