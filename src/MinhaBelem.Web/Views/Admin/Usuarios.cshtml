@model IReadOnlyList<MinhaBelem.Core.Abstractions.AdminUser>
@using MinhaBelem.Core.Security
<section class="section"><h1>Usuários e perfis</h1><div class="table-wrap"><table><thead><tr><th>Nome</th><th>E-mail</th><th>Estado</th><th>MFA</th><th>Perfil e acesso</th></tr></thead><tbody>@foreach(var user in Model){<tr><td>@user.DisplayName</td><td>@user.Email</td><td>@(user.Enabled ? "Ativo" : "Suspenso")</td><td>@(user.TwoFactorEnabled ? "Configurado" : "Pendente")</td><td><form method="post" asp-action="Papel" asp-route-id="@user.Id"><label>Perfil<select name="role">@foreach(var role in Roles.All){<option>@role</option>}</select></label><button>Alterar perfil e invalidar sessões</button></form><form method="post" asp-action="EstadoUsuario" asp-route-id="@user.Id"><input type="hidden" name="enabled" value="@((!user.Enabled).ToString().ToLowerInvariant())" /><button>@(user.Enabled ? "Suspender" : "Reativar")</button></form></td></tr>}</tbody></table></div>
<h2>Novo usuário</h2><form method="post" asp-action="CriarUsuario"><label>Nome<input name="DisplayName" maxlength="180" required /></label><label>E-mail<input name="Email" type="email" autocomplete="off" required /></label><label>Senha inicial (12 caracteres, maiúscula, minúscula, número e símbolo)<input name="Password" type="password" autocomplete="new-password" minlength="12" required /></label><label>Perfil<select name="Role">@foreach(var role in Roles.All){<option>@role</option>}</select></label><button>Criar usuário</button></form><p>A senha não é registrada em logs. Combine sua entrega com o usuário por um canal seguro.</p></section>
