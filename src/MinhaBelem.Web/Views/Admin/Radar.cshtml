                            <th class="view-3450ea98">Link da Publicação</th>
                            <th class="view-3450ea98">Conteúdo / Legenda</th>
                            <th class="view-3450ea98">Tipo de Mídia</th>
                            <th class="view-3450ea98">Conteúdo Vinculado</th>
                            <th class="view-3450ea98">Patrocinado</th>
                        </tr>
                    </thead>
                    <tbody>
