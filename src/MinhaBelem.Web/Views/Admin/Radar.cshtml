            <h3 class="view-8b7e29fd">
                + Cadastrar Perfil Oficial para Monitoramento
            </h3>
            <form method="post" action="/admin/radar/perfis/cadastrar" class="view-a662acde">
                @Html.AntiForgeryToken()
