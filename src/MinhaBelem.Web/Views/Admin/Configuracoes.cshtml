@model IReadOnlyDictionary<string,string>
<section class="section article"><h1>Configurações operacionais</h1><p>O intervalo mínimo é de um minuto. A atualização depende da disponibilidade e dos limites das fontes.</p><form method="post" asp-action="SalvarConfiguracoes"><label><input type="checkbox" name="collectorEnabled" value="true" checked="@(Model.GetValueOrDefault("collector.enabled") == "true")" /> Ativar coleta supervisionada</label><label>Intervalo em minutos<input name="intervalMinutes" type="number" min="1" max="240" value="@(Model.GetValueOrDefault("collector.intervalMinutes") ?? "1")" /></label><button>Salvar configurações</button></form></section>
