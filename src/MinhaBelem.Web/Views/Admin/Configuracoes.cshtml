@model IReadOnlyDictionary<string,string>
@{ Layout = "_AdminLayout"; ViewData["Title"] = Loc["OperationalSettings"].Value; }
<section class="section article"><span class="eyebrow">MINHABELÉM / RADAR</span><h1>@Loc["OperationalSettings"]</h1><p>@Loc["SettingsDescription"]</p><form method="post" asp-action="SalvarConfiguracoes"><label class="checkbox-label">@Html.Raw(SelectOptions.Checkbox("collectorEnabled", "true", Model.GetValueOrDefault("collector.enabled") == "true")) @Loc["CollectorEnable"]</label><label>@Loc["IntervalMinutes"]<input name="intervalMinutes" type="number" min="1" max="240" value="@(Model.GetValueOrDefault("collector.intervalMinutes") ?? "1")" /></label><button>@Loc["Save"]</button></form></section>
