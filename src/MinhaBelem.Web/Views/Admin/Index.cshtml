@using MinhaBelem.Core.Security
@using MinhaBelem.Core.Entities
@model DashboardSnapshot
@{
    ViewData["Title"]=Loc["DashboardTitle"].Value;
    var metrics=new[]{("DashboardPublished",Model.PublishedContent),("DashboardReview",Model.ContentInReview),("DashboardCandidates",Model.PendingCandidates),("DashboardFailingSources",Model.FailingSources)};
    var tools=new[]{
        (Permissions.ContentRead,"/editorial/lotes?kind=content","BatchTitle"),
        (Permissions.ContentRead,"/editorial","AdminEditorial"),
        (Permissions.SourceManage,"/admin/radar","RadarOperations"),
        (Permissions.SubmissionModerate,"/admin/colaboracoes","AdminSubmissions"),
        (Permissions.TranslationRead,"/admin/traducoes","AdminAiReview"),
        (Permissions.PlaceManage,"/admin/lugares","AdminPlaces"),
        (Permissions.UserManage,"/admin/usuarios","AdminUsers"),
        (Permissions.AdvertiserManage,"/admin/anunciantes","NavPartners"),
        (Permissions.AuditRead,"/admin/auditoria","AdminAudit")
    };
}
<div class="admin-shell"><partial name="_AdminSidebar"/><main class="admin-content" id="conteudo-admin">
    <header class="admin-header"><div><span class="eyebrow">MINHABELÉM / 360</span><h1>@Loc["DashboardTitle"]</h1><p class="small text-muted">@Loc["DashboardIntro"]</p></div>
        <a class="button secondary" href="/admin/relatorios">@Loc["AdminReports"] ↗</a>
    </header>
    @if(Model.ContentInReview>0 && User.HasClaim("mb:permission",Permissions.ContentRead)){
        <section class="notice dashboard-attention"><strong>@Model.ContentInReview · @Loc["DashboardReview"]</strong><p>@Loc["DashboardEditorialText"]</p><a href="/editorial/lotes?kind=content">@Loc["BatchTitle"] ↗</a></section>
    }
    @if(ViewData["RoutesConfigured"] is not true){<p class="notice">@Loc["RouteState_unconfigured"] @if(User.HasClaim("mb:permission",Permissions.SettingsManage)){<a href="/admin/integracoes">@Loc["AdminIntegrations"] ↗</a>}</p>}
    <section class="admin-stats-grid" aria-label="@Loc["DashboardTitle"]">
    @foreach(var metric in metrics){<article class="stat-card"><span class="eyebrow">@Loc[metric.Item1]</span><div class="stat-number">@metric.Item2</div></article>}
    </section><p class="small text-muted dashboard-metric-note">@Loc["DashboardMetricNote"]</p>
    <section class="card dashboard-ai"><h2>@Loc["DashboardAiTitle"]</h2><dl class="radar-operation-metrics">
        <div><dt>@Loc["DashboardAiRuns"]</dt><dd>@Model.AiRunsLast24h</dd></div>
        <div><dt>@Loc["DashboardAiFailures"]</dt><dd>@Model.AiFailuresLast24h</dd></div>
        <div><dt>@Loc["DashboardAiCost"]</dt><dd>USD @Model.AiCostUsdLast30d.ToString("N4")</dd></div>
        <div><dt>@Loc["DashboardRunFailures"]</dt><dd>@Model.IngestionRunsWithErrorsLast24h</dd></div>
    </dl></section>
    @if(ViewData["RadarStats"] is RadarDashboardStats radar){<partial name="_RadarOperations" model="radar"/>}
    <section class="card dashboard-trend"><h2>@Loc["DashboardPublicationDays"]</h2>
    @if(Model.PublishedByDay.Count==0){<p>@Loc["General_Empty"]</p>}
    else{var maximum=Model.PublishedByDay.Max(x=>x.Count);<ol>@foreach(var day in Model.PublishedByDay){<li><time datetime="@day.Day.ToString("yyyy-MM-dd")">@day.Day.ToString("d")</time><span class="dashboard-bar" style="--bar-width:@((100m*day.Count/Math.Max(1,maximum)).ToString(System.Globalization.CultureInfo.InvariantCulture))%" aria-hidden="true"></span><strong>@day.Count</strong></li>}</ol>}
    </section>
    <section><h2>@Loc["DashboardYourTools"]</h2><nav class="dashboard-tools" aria-label="@Loc["AdminNavigation"]">
    @foreach(var tool in tools){if(User.HasClaim("mb:permission",tool.Item1)){<a class="card" href="@tool.Item2"><span>@Loc[tool.Item3]</span><span aria-hidden="true">↗</span></a>}}
    </nav></section>
</main></div>
