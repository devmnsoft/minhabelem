@{ Layout = "_AdminLayout"; }
@model IReadOnlyDictionary<string,string[]>
@using MinhaBelem.Core.Security
<section class="section"><h1>Perfis e permissões</h1><p>Alterações encerram o acesso das sessões existentes do perfil. O perfil principal conserva o acesso de recuperação administrativa.</p><div class="grid">@foreach(var role in Roles.All.Where(x => x != Roles.SuperAdmin)){<article class="card"><h2>@role</h2><form method="post" asp-action="SalvarPerfil"><input type="hidden" name="role" value="@role" /><fieldset><legend>Permissões de @role</legend>@foreach(var code in Permissions.All){<label><input type="checkbox" name="permissions" value="@code" checked="@(Model.GetValueOrDefault(role)?.Contains(code) == true)" /> @Permissions.Descriptions[code]</label>}</fieldset><button>Salvar permissões</button></form></article>}</div></section>
