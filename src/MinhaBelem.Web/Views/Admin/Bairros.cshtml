@model IReadOnlyList<MinhaBelem.Core.Entities.NeighborhoodGuide>

@{
    ViewData["Title"] = "Gestão de Guias de Bairros";
}

<div class="admin-shell">
    <partial name="_AdminSidebar" />

    <main class="admin-content">
        <div class="admin-header">
            <div>
                <span class="eyebrow">COMUNIDADE & IDENTIDADE LOCAL</span>
                <h1 class="view-26731c99">Guias de Bairros de Belém</h1>
                <p class="small text-muted">Documentação histórica, gastronômica e atrativos culturais de cada região da capital.</p>
            </div>
            <a href="#novo-bairro" class="button small">➕ Novo Bairro</a>
        </div>

    @if (TempData["Notice"] is string notice)
    {
        <p class="notice" role="status">@notice</p>
    }

    <h2>Bairros Cadastrados (@Model.Count)</h2>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Ordem</th>
                    <th>Nome</th>
                    <th>Slug</th>
                    <th>Região / Zona</th>
                    <th>Destaques</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var n in Model)
                {
                    <tr>
                        <td>#@n.DisplayOrder</td>
                        <td><strong>@n.Name</strong></td>
                        <td><code>@n.Slug</code></td>
                        <td><span class="badge badge-info">@n.Zone</span></td>
                        <td><small>@(n.PopularAttractions ?? "-")</small></td>
                        <td>
                            <a href="/meu-bairro/@n.Slug" target="_blank" class="button small secondary">Ver Público ↗</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Novo Bairro Formulário -->
    <div id="novo-bairro" class="view-0fd92b1e card cta">
        <h3>Cadastrar / Atualizar Guia de Bairro</h3>
        <form action="/admin/bairros" method="post">
            @Html.AntiForgeryToken()
            <div class="view-c2fdb273 grid">
                <label>
                    Nome do Bairro *
                    <input name="Name" required placeholder="Ex: Marco, Guamá, Pedreira..." />
                </label>
                <label>
                    Slug da URL *
                    <input name="Slug" required placeholder="Ex: marco, guama, pedreira..." />
                </label>
                <label>
                    Região / Zona *
                    <select name="Zone">
                        <option value="Centro Histórico">Centro Histórico</option>
                        <option value="Região Central">Região Central</option>
                        <option value="Zona Sul">Zona Sul</option>
                        <option value="Zona Norte">Zona Norte</option>
                        <option value="Zona Leste">Zona Leste</option>
                        <option value="Ilhas e Distritos">Ilhas e Distritos</option>
                    </select>
                </label>
            </div>

            <label class="view-8d842990">
                Resumo Histórico *
                <textarea name="HistorySummary" rows="3" required placeholder="Origem e fundação do bairro..."></textarea>
            </label>

            <label class="view-8d842990">
                Características Culturais e Gastronômicas *
                <textarea name="CulturalCharacteristics" rows="3" required placeholder="Comércio típico, feiras, tradições, comida de rua..."></textarea>
            </label>

            <div class="grid" style="grid-template-columns:1fr 1fr;gap:16px;margin-top:14px;">
                <label>
                    Dicas de Segurança e Convivência
                    <input name="SafetyTips" placeholder="Recomendações práticas para moradores e visitantes..." />
                </label>
                <label>
                    Pontos Turísticos e Atrações
                    <input name="PopularAttractions" placeholder="Ex: Bosque Rodrigues Alves, Praça Floriano Peixoto..." />
                </label>
            </div>

            <button type="submit" class="view-76977cc9">Salvar Guia de Bairro</button>
        </form>
    </div>
    </main>
</div>
