@model IReadOnlyList<MinhaBelem.Core.Entities.AdvertiserCampaign>

@{
    ViewData["Title"] = "Gestão de Anunciantes & Parceiros";
}

<div class="admin-shell">
    <partial name="_AdminSidebar" />

    <main class="admin-content">
        <div class="admin-header">
            <div>
                <span class="eyebrow">MONETIZAÇÃO ÉTICA & PARCERIAS</span>
                <h1 class="view-26731c99">Anunciantes & Campanhas</h1>
                <p class="small text-muted">Acompanhamento de planos comerciais, ativação de banners e prestação de contas.</p>
            </div>
            <a href="/parceiros" class="button secondary small" target="_blank">Página de Planos Públicos ↗</a>
        </div>

    @if (TempData["Notice"] is string notice)
    {
        <p class="notice" role="status">@notice</p>
    }

    <h2>Campanhas Registradas (@Model.Count)</h2>
    @if (Model.Count == 0)
    {
        <div class="empty">
            <p>Nenhuma campanha comercial cadastrada no momento.</p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Anunciante</th>
                        <th>Título da Campanha</th>
                        <th>Período</th>
                        <th>Segmentação</th>
                        <th>Status</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>#@c.Id</td>
                            <td><strong>@c.AdvertiserName</strong></td>
                            <td>
                                @(c.Headline ?? c.Label)<br />
                                <small class="text-muted"><a href="@c.DestinationUrl" target="_blank" rel="noopener noreferrer">@c.DestinationUrl</a></small>
                            </td>
                            <td><small>@(c.ValidFrom?.ToString("dd/MM/yyyy") ?? "Imediato") até @(c.ValidTo?.ToString("dd/MM/yyyy") ?? "Indeterminado")</small></td>
                            <td>
                                <span class="badge badge-info">@c.Label</span>
                            </td>
                            <td>
                                @if (c.Active)
                                {
                                    <span class="badge badge-success">Ativa</span>
                                }
                                else
                                {
                                    <span class="badge badge-muted">Pausada</span>
                                }
                            </td>
                            <td>
                                <form action="/admin/anunciantes/@c.Id/estado" method="post" class="view-a91548c5">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="active" value="@(c.Active ? "false" : "true")" />
                                    <button type="submit" class="button small @(c.Active ? "secondary" : "")">
                                        @(c.Active ? "Pausar" : "Ativar")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    </main>
</div>
