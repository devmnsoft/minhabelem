@model IReadOnlyList<MinhaBelem.Core.Entities.CommunitySubmission>
<section class="section"><h1>Colaborações da comunidade</h1><p>A aprovação registra a avaliação. Não publica automaticamente o texto enviado.</p><div class="grid">@foreach(var submission in Model){<article class="card"><h2>@submission.DisplayName</h2><p>@submission.Message</p><p>@submission.Status · @submission.CreatedAt UTC</p><form method="post" asp-action="Moderar" asp-route-id="@submission.Id"><button name="approve" value="true">Aprovar avaliação</button><button name="approve" value="false">Rejeitar</button></form></article>}</div></section>
