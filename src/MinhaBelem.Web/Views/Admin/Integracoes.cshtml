@model MinhaBelem.Web.Models.IntegrationStatus[]
@using MinhaBelem.Core.Entities
<section class="section"><h1>Integrações</h1><p>Credenciais são configuradas nos segredos do servidor. Esta tela não exibe nem recebe chaves.</p><div class="grid">@foreach(var integration in Model){<article class="card"><h2>@integration.Name</h2><p>@(integration.Configured ? "Configuração presente" : "Configuração pendente")</p><p>@integration.Status</p></article>}</div><h2>Execuções de IA</h2><div class="table-wrap"><table><thead><tr><th>Data (UTC)</th><th>Provedor / modelo</th><th>Resultado</th><th>Custo USD</th><th>Latência</th></tr></thead><tbody>@foreach(var run in ViewData["AiRuns"] as IReadOnlyList<AiRun> ?? Array.Empty<AiRun>()){<tr><td>@run.CreatedAt</td><td>@run.Provider · @run.Model · @run.ModelVersion</td><td>@(run.Success ? "Concluída" : "Falha")</td><td>@run.CostUsd</td><td>@run.LatencyMs ms</td></tr>}</tbody></table></div></section>
