@model IReadOnlyList<MinhaBelem.Core.Entities.ContentItem>
@using System.Globalization
@using MinhaBelem.Core.Entities
@using MinhaBelem.Web.Models
@{
    ViewData["Title"] = Loc["Nav_Home"].Value;
    var culture = CultureInfo.CurrentUICulture;
    var events = ViewData["UpcomingEvents"] as IReadOnlyList<ContentItem> ?? Array.Empty<ContentItem>();
    var places = ViewData["Places"] as IReadOnlyList<Place> ?? Array.Empty<Place>();
    var gastronomy = ViewData["GastronomyPlaces"] as IReadOnlyList<Place> ?? Array.Empty<Place>();
    var neighborhoods = ViewData["Neighborhoods"] as IReadOnlyList<NeighborhoodGuide> ?? Array.Empty<NeighborhoodGuide>();
    var itineraries = ViewData["TouristItineraries"] as IReadOnlyList<TouristItinerary> ?? Array.Empty<TouristItinerary>();
    var videos = ViewData["SocialVideos"] as IReadOnlyList<SocialPost> ?? Array.Empty<SocialPost>();
    var page = (int)(ViewData["Page"] ?? 1);
    var filtered = ViewData["Category"] != null || !string.IsNullOrWhiteSpace(ViewData["Search"] as string) || page > 1;
}
<section class="hero home-hero" aria-labelledby="hero-title">
    <div class="hero-content">
        <span class="eyebrow">BELÉM DO PARÁ / AMAZÔNIA / BRASIL</span>
        <h1 id="hero-title">@Loc["Hero_Title"]</h1>
        <p>@Loc["Hero_Subtitle"]</p>
        <form method="get" action="/" class="search" role="search">
            <label for="busca" class="sr-only">@Loc["SearchPlaceholder"]</label>
            <svg class="icon" aria-hidden="true"><use href="/images/icons.svg#search" /></svg>
            <input id="busca" name="busca" maxlength="120" placeholder="@Loc["SearchPlaceholder"]" value="@ViewData["Search"]" />
            <button type="submit">@Loc["SearchButton"] <span aria-hidden="true">↗</span></button>
        </form>
        <div class="hero-quick-tags">
            <a href="/agenda/semana">@Loc["ThisWeek"] ↗</a>
            <a href="/explore">@Loc["NavExplore"] ↗</a>
            <a href="/guia">@Loc["NavGuide"] ↗</a>
        </div>
    </div>
    <span class="hero-caption">
        <a href="https://commons.wikimedia.org/wiki/File:Esta%C3%A7%C3%A3o_das_Docas_Bel%C3%A9m_Par%C3%A1_2023-8696.jpg" target="_blank" rel="noopener noreferrer">Estação das Docas · Prburley / Wikimedia Commons</a>
        · <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a> · @Loc["PhotoOptimized"]
    </span>
</section>
<div class="city-ribbon"><span class="live-dot" aria-hidden="true"></span><strong>@Loc["CityNow"]</strong><span>@Loc["EditorialNote"]</span><a href="/agora">@Loc["ViewMore"] ↗</a></div>
@if(!filtered){<partial name="_CityWindows" />}
@if(ViewData["Campaigns"] is IReadOnlyList<AdvertiserCampaign> campaigns){<partial name="_SponsoredCampaigns" model="campaigns" />}
<nav class="categories category-strip" aria-label="@Loc["AllCategories"]">
    <a href="/" aria-current="@(ViewData["Category"] == null ? "page" : null)">@Loc["AllCategories"]</a>
    @foreach (var category in MinhaBelem.Core.Taxonomy.Taxonomy.All)
    {
        <a href="/?categoria=@category.Slug" aria-current="@(string.Equals(ViewData["Category"] as string, category.Slug, StringComparison.OrdinalIgnoreCase) ? "page" : null)">@Loc["Category_" + category.Slug]</a>
    }
</nav>
<section class="section news-section" aria-labelledby="news-title">
    <div class="sectionhead"><div><span class="eyebrow">MINHABELÉM / 360</span><h2 id="news-title">@Loc["Home_LatestNews"]</h2></div><a href="/agora">@Loc["ViewMore"] ↗</a></div>
    @if (Model.Count == 0)
    {
        <div class="editorial-empty"><svg class="empty-art" aria-hidden="true"><use href="/images/icons.svg#river" /></svg><div><h3>@Loc["EmptyTitle"]</h3><p>@Loc["EmptyDescription"]</p><a class="button-link" href="/guia">@Loc["NavGuide"] ↗</a></div></div>
    }
    else
    {
        <div class="@(filtered ? "grid" : "editorial-grid")">
        @foreach (var item in Model)
        {
            <article class="story @(item == Model[0] && !filtered ? "story-lead" : "")">
                @if (!string.IsNullOrWhiteSpace(item.ImageUrl) && !string.IsNullOrWhiteSpace(item.ImageLicense) && !string.IsNullOrWhiteSpace(item.ImageCredit))
                {
                    <figure><img src="@item.ImageUrl" alt="" loading="lazy" decoding="async" /><figcaption>@item.ImageCredit</figcaption></figure>
                }
                <span class="eyebrow">@Loc["Category_" + MinhaBelem.Core.Taxonomy.Taxonomy.Info(item.Category).Slug]</span>
                <h3><a asp-action="Detalhe" asp-route-id="@item.Id">@item.DisplayTitle</a></h3>
                <p>@item.DisplaySummary</p>
                <div class="card-meta"><span>@item.SourceName</span><time datetime="@item.PublishedAt.ToString("O")">@PortalTime.Local(item.PublishedAt).ToString("d", culture)</time></div>
            </article>
        }
        </div>
        <nav class="pagination" aria-label="@Loc["NextPage"]">
            @if (page > 1) { <a asp-action="Index" asp-route-pagina="@(page - 1)" asp-route-busca="@ViewData["Search"]" asp-route-categoria="@ViewData["Category"]">← @Loc["PreviousPage"]</a> }
            <span>@(page)</span>
            @if (Model.Count >= 12) { <a asp-action="Index" asp-route-pagina="@(page + 1)" asp-route-busca="@ViewData["Search"]" asp-route-categoria="@ViewData["Category"]">@Loc["NextPage"] →</a> }
        </nav>
    }
</section>
@if (places.Count > 0)
{
    <section class="section"><div class="sectionhead"><h2>@Loc["NavGuide"]</h2></div><div class="grid">
        @foreach (var place in places) { <article class="card"><span class="eyebrow">@place.PrimaryType</span><h3><a href="/guia/@place.Id">@place.DisplayName</a></h3><p>@place.DisplayEditorialNote</p><span class="small">@place.Neighborhood</span></article> }
    </div></section>
}
@if (!filtered)
{
    <section class="section home-events-highlight" aria-labelledby="home-events-title">
        <div class="sectionhead">
            <div>
                <span class="eyebrow">AGENDA CULTURAL & FESTIVA</span>
                <h2 id="home-events-title">@Loc["Upcoming_Belém_Events"]</h2>
                <p class="section-subtitle" style="color:var(--text-muted,#59675f);margin-top:6px;max-width:65ch;">
                    @Loc["Upcoming_Belém_Events_Subtitle"]
                </p>
            </div>
            <div style="display:flex;gap:10px;align-items:center;">
                <a class="button secondary" href="/agenda">@Loc["NavAgenda"] ↗</a>
                <a class="button" href="/agenda/semana">@Loc["ThisWeek"] ↗</a>
            </div>
        </div>

        @if (events.Count == 0)
        {
            <div class="empty" style="text-align:center;padding:48px 24px;">
                <svg class="empty-art" aria-hidden="true" style="width:64px;height:64px;margin-bottom:16px;"><use href="/images/icons.svg#calendar" /></svg>
                <h3>@Loc["General_Empty"]</h3>
                <p style="max-width:45ch;margin:8px auto 20px;color:var(--text-muted,#59675f);">@Loc["AgendaEmpty"]</p>
                <a class="button secondary" href="/agenda">@Loc["AgendaAll"] ↗</a>
            </div>
        }
        else
        {
            <div class="events-spotlight-grid">
                @foreach (var item in events)
                {
                    var localStart = item.EventStartAt.HasValue ? PortalTime.Local(item.EventStartAt.Value) : (DateTime?)null;
                    var topicSlug = MinhaBelem.Infrastructure.MySql.CuratedAgendaImporter.AgendaSubjects.Contains(item.Subject ?? "") ? "AgendaTopic_" + item.Subject : "Category_" + MinhaBelem.Core.Taxonomy.Taxonomy.Info(item.Category).Slug;
                    var artSvg = item.Subject switch { "corrida" => "sport", "musica" or "humor" => "music", "infantil" => "family", "congressos" or "feiras" => "city", _ => "stage" };
                    var hasCustomImg = !string.IsNullOrWhiteSpace(item.ImageUrl) && !string.IsNullOrWhiteSpace(item.ImageCredit) && !item.ImageUrl.StartsWith("/images/agenda/", StringComparison.Ordinal);
                    var imgUrl = hasCustomImg ? item.ImageUrl : $"/images/agenda/{artSvg}.svg";
                    var isFree = item.IsFree;
                    var priceText = isFree ? Loc["Event_Confirmed_Free"].Value : (!string.IsNullOrWhiteSpace(item.TicketPriceText) ? item.TicketPriceText : Loc["Event_Check_Price"].Value);

                    <article class="event-spotlight-card" aria-labelledby="event-title-@item.Id">
                        <div class="event-spotlight-header">
                            <img src="@imgUrl" alt="" width="480" height="270" loading="lazy" decoding="async" />
                            @if (localStart.HasValue)
                            {
                                <div class="event-date-badge" aria-hidden="true">
                                    <strong>@localStart.Value.ToString("dd")</strong>
                                    <span>@localStart.Value.ToString("MMM", culture)</span>
                                </div>
                            }
                            <span class="event-price-tag @(isFree ? "is-free" : "")">
                                @(isFree ? "✓ " + Loc["FreeEvents"].Value : priceText)
                            </span>
                        </div>

                        <div class="event-spotlight-body">
                            <span class="event-category-label">
                                <span aria-hidden="true">🏷️</span> @Loc[topicSlug]
                            </span>

                            <h3 class="event-spotlight-title" id="event-title-@item.Id">
                                <a asp-action="Detalhe" asp-route-id="@item.Id">@item.DisplayTitle</a>
                            </h3>

                            <div class="event-spotlight-meta">
                                @if (localStart.HasValue)
                                {
                                    <div class="event-meta-item">
                                        <span aria-hidden="true">🕒</span>
                                        <time datetime="@item.EventStartAt?.ToString("O")">
                                            @localStart.Value.ToString("dddd, dd 'de' MMMM", culture) · @(AgendaPage.DateOnlyEvent(item) ? Loc["AgendaUnknownTime"].Value : localStart.Value.ToString("HH:mm"))
                                        </time>
                                    </div>
                                }
                                <div class="event-meta-item">
                                    <span aria-hidden="true">📍</span>
                                    <span>@(item.EventDetails?.Location ?? item.Address ?? item.Neighborhood ?? "Belém do Pará")</span>
                                </div>
                            </div>

                            <p style="font-size:0.88rem;color:var(--text-secondary,#42554b);line-height:1.5;margin:0 0 16px;flex:1;">
                                @(item.DisplaySummary.Length > 150 ? item.DisplaySummary[..147] + "..." : item.DisplaySummary)
                            </p>

                            <div class="event-spotlight-actions">
                                <span class="event-source-credit" title="@Loc["Event_Official_Source"]">
                                    🏛️ @item.SourceName
                                </span>
                                <a asp-action="Detalhe" asp-route-id="@item.Id" class="button-link" style="font-weight:700;font-size:0.86rem;" aria-label="@Loc["Event_Details_Link"]: @item.DisplayTitle">
                                    @Loc["ViewMore"] ↗
                                </a>
                            </div>
                        </div>
                    </article>
                }
            </div>
            <nav class="agenda-links" style="display:flex;gap:14px;flex-wrap:wrap;margin-top:24px;justify-content:center;">
                <a href="/agenda" class="quick-pill">@Loc["UpcomingEvents"] ↗</a>
                <a href="/cinema-teatro" class="quick-pill">@Loc["CinemaTheater"] ↗</a>
                <a href="/programacao-infantil" class="quick-pill">@Loc["ChildrenProgram"] ↗</a>
                <a href="/eventos-gratuitos" class="quick-pill">@Loc["FreeEvents"] ↗</a>
            </nav>
        }
    </section>
    <section class="section discovery-feature"><div><span class="eyebrow">@Loc["NavExplore"]</span><h2>@Loc["Explore_Hero_Title"]</h2><p>@Loc["Explore_Hero_Subtitle"]</p><a class="button-link" href="/explore">@Loc["WhatToVisit"] ↗</a></div><div class="route-list">
        @foreach (var route in itineraries.Take(4)) { <a href="/explore/roteiro/@route.Slug"><span>@route.Days.ToString("00")</span><strong>@route.GetTitle(culture.Name)</strong><span aria-hidden="true">↗</span></a> }
        @if (itineraries.Count == 0) { <p>@Loc["General_Empty"]</p> }
    </div></section>
    <section class="section"><div class="sectionhead"><div><span class="eyebrow">AÇAÍ / TACACÁ / MANIOCA</span><h2>@Loc["GastronomyTitle"]</h2></div><a href="/guia?categoria=restaurant">@Loc["WhereToEat"] ↗</a></div>
        <div class="grid">@foreach (var place in gastronomy) { <article class="card"><span class="eyebrow">@place.Neighborhood</span><h3><a href="/guia/@place.Id">@place.DisplayName</a></h3><p>@place.DisplayEditorialNote</p></article> }</div>
        @if (gastronomy.Count == 0) { <p class="empty-inline">@Loc["General_Empty"] · <a href="/guia">@Loc["NavGuide"] ↗</a></p> }
    </section>
    <section class="section city-columns"><div class="mobility-feature"><svg class="feature-icon" aria-hidden="true"><use href="/images/icons.svg#boat" /></svg><span class="eyebrow">@Loc["NavMobility"]</span><h2>@Loc["RiverMobility"]</h2><p>@Loc["MobilityDescription"]</p><a href="/mobilidade" class="button-link">@Loc["NavMobility"] ↗</a></div><div class="service-feature"><svg class="feature-icon" aria-hidden="true"><use href="/images/icons.svg#city" /></svg><span class="eyebrow">@Loc["NavCitizenship"]</span><h2>@Loc["PublicServices"]</h2><p>@Loc["ServicesDescription"]</p><a href="/?categoria=servicos" class="button-link">@Loc["ViewMore"] ↗</a></div></section>
    <section class="section"><div class="sectionhead"><div><span class="eyebrow">@Loc["NavNeighborhood"]</span><h2>@Loc["NeighborhoodTitle"]</h2></div><a href="/meu-bairro">@Loc["ViewMore"] ↗</a></div><div class="neighborhood-list">
        @foreach (var area in neighborhoods.Take(4)) { <a href="/meu-bairro/@area.Slug"><span class="eyebrow">@area.Zone</span><h3>@area.Name</h3><span aria-hidden="true">↗</span></a> }
        @if (neighborhoods.Count == 0) { <p class="empty-inline">@Loc["General_Empty"]</p> }
    </div></section>
    <section class="section"><div class="sectionhead"><h2>@Loc["VideoTitle"]</h2></div><div class="grid">@foreach (var video in videos) { <article class="story"><span class="eyebrow">@video.Platform</span><h3><a href="@video.PostUrl" target="_blank" rel="noopener noreferrer">@video.Title ↗</a></h3><p>@video.CaptionSnippet</p></article> }</div>@if (videos.Count == 0) { <p class="empty-inline">@Loc["General_Empty"]</p> }</section>
    <section class="section sponsor-feature"><div><span class="eyebrow">@Loc["NavPartners"] / MINHABELÉM</span><h2>@Loc["PartnerTitle"]</h2><p>@Loc["PartnerDescription"]</p></div><a href="/parceiros" class="button">@Loc["NavPartners"] ↗</a></section>
}
<section class="section collaboration"><div><span class="eyebrow">MINHABELÉM / COMUNIDADE</span><h2>@Loc["Collab_Title"]</h2><p>@Loc["Collab_Subtitle"]</p></div><form asp-controller="Home" asp-action="Colaborar" method="post"><label>@Loc["Collab_Name"]<input name="nome" maxlength="100" required autocomplete="name" /></label><label>@Loc["Collab_Message"]<textarea name="mensagem" maxlength="2500" rows="4" required></textarea></label><label class="checkbox-label"><input type="checkbox" name="consentimento" value="true" required /><span>@Loc["Collab_Consent"] (<a href="/privacidade">@Loc["Nav_Privacy"]</a>)</span></label><button type="submit">@Loc["Collab_Submit"] ↗</button></form></section>
