@model IReadOnlyList<MinhaBelem.Core.Entities.ContentItem>
@using System.Globalization

@{
    ViewData["Title"] = Loc["Nav_Home"].Value;
    var currentCulture = CultureInfo.CurrentUICulture;
}

@if (ViewData["Places"] is IReadOnlyList<MinhaBelem.Core.Entities.Place> places && places.Count > 0)
{
    <section class="section search-results-places">
        <h2>@Loc["Explore_Places"]</h2>
        <div class="grid">
            @foreach (var place in places)
            {
                <article class="card place-card">
                    <span class="eyebrow">@place.PrimaryType</span>
                    <h3><a href="/guia/@place.Id">@place.DisplayName</a></h3>
                    <p>@place.DisplayEditorialNote</p>
                    @if (!string.IsNullOrWhiteSpace(place.CulturalNotes))
                    {
                        <div class="cultural-badge">💡 @place.CulturalNotes</div>
                    }
                    <span class="small">📍 @place.Neighborhood, @place.Municipality</span>
                </article>
            }
        </div>
    </section>
}

<section class="hero">
    <div class="eyebrow">BELÉM • PARÁ • AMAZÔNIA 🇧🇷</div>
    <h1>@Loc["Hero_Title"]</h1>
    <p>@Loc["Hero_Subtitle"]</p>
    
    <form method="get" action="/" class="search" role="search">
        <label for="busca" class="sr-only">@Loc["Search_Placeholder"]</label>
        <input id="busca" name="busca" maxlength="120" placeholder="@Loc["Search_Placeholder"]" value="@ViewData["Search"]" />
        <button type="submit">@Loc["Search_Button"]</button>
    </form>
</section>

<section class="categories" aria-label="Categorias">
    @foreach (var category in MinhaBelem.Core.Taxonomy.Taxonomy.All)
    {
        <a href="/?categoria=@category.Slug">@category.Label</a>
    }
</section>

<section class="section">
    <div class="sectionhead">
        <div>
            <span class="eyebrow">@Loc["Explore_VerifiedSource"]</span>
            <h2>@Loc["Home_LatestNews"]</h2>
        </div>
        <span class="small">@Loc["Explore_VerifiedSource"]</span>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty">
            <h3>@Loc["General_Empty"]</h3>
            <p>@Loc["Explore_VerifiedSource"]</p>
            <p>
                Consulte os <a href="https://seguranca.belem.pa.gov.br/servicos-semob/" target="_blank" rel="noopener noreferrer">serviços oficiais de mobilidade</a> 
                e a <a href="https://secult.belem.pa.gov.br/" target="_blank" rel="noopener noreferrer">Secretaria de Cultura</a>.
            </p>
        </div>
    }
    else
    {
        <div class="grid">
            @foreach (var item in Model)
            {
                <article class="card news-card">
                    <div class="eyebrow">@MinhaBelem.Core.Taxonomy.Taxonomy.Info(item.Category).Label</div>
                    <h3><a asp-action="Detalhe" asp-route-id="@item.Id">@item.DisplayTitle</a></h3>
                    <p>@(item.LocalizedSummary ?? item.Summary)</p>
                    
                    @if (!string.IsNullOrWhiteSpace(item.CulturalNotes))
                    {
                        <div class="cultural-badge">🌿 @item.CulturalNotes</div>
                    }

                    <div class="card-meta small">
                        <span>📰 @item.SourceName</span>
                        <span>•</span>
                        <time datetime="@item.PublishedAt.ToString("O")">
                            @MinhaBelem.Web.Models.PortalTime.Local(item.PublishedAt).ToString("d", currentCulture)
                        </time>
                    </div>
                </article>
            }
        </div>
    }
</section>

<section class="section cta">
    <h2>@Loc["Collab_Title"]</h2>
    <p>@Loc["Collab_Subtitle"]</p>
    
    @if (TempData["Notice"] is string notice)
    {
        <p class="notice" role="status">@notice</p>
    }

    <form asp-controller="Home" asp-action="Colaborar" method="post">
        <label>
            @Loc["Collab_Name"]
            <input name="nome" maxlength="100" required />
        </label>
        <label>
            @Loc["Collab_Message"]
            <textarea name="mensagem" maxlength="2500" rows="4" required></textarea>
        </label>
        <label class="checkbox-label">
            <input type="checkbox" name="consentimento" value="true" required /> 
            <span>@Loc["Collab_Consent"] (<a href="/privacidade" target="_blank">@Loc["Nav_Privacy"]</a>)</span>
        </label>
        <button type="submit">@Loc["Collab_Submit"]</button>
    </form>
</section>
