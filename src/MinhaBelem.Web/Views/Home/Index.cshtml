@model IReadOnlyList<MinhaBelem.Core.Entities.ContentItem>
@using System.Globalization
@using MinhaBelem.Core.Entities
@using MinhaBelem.Web.Models
@{
    ViewData["Title"] = Loc["Nav_Home"].Value;
    var culture = CultureInfo.CurrentUICulture;
    var events = ViewData["UpcomingEvents"] as IReadOnlyList<ContentItem> ?? Array.Empty<ContentItem>();
    var places = ViewData["Places"] as IReadOnlyList<Place> ?? Array.Empty<Place>();
    var gastronomy = ViewData["GastronomyPlaces"] as IReadOnlyList<Place> ?? Array.Empty<Place>();
    var neighborhoods = ViewData["Neighborhoods"] as IReadOnlyList<NeighborhoodGuide> ?? Array.Empty<NeighborhoodGuide>();
    var itineraries = ViewData["TouristItineraries"] as IReadOnlyList<TouristItinerary> ?? Array.Empty<TouristItinerary>();
    var videos = ViewData["SocialVideos"] as IReadOnlyList<SocialPost> ?? Array.Empty<SocialPost>();
    var page = (int)(ViewData["Page"] ?? 1);
    var filtered = ViewData["Category"] != null || !string.IsNullOrWhiteSpace(ViewData["Search"] as string) || page > 1;
}

<section class="hero home-hero" aria-labelledby="hero-title">
    <div class="hero-content">
        <span class="eyebrow">BELÉM DO PARÁ · AMAZÔNIA</span>
        <h1 id="hero-title">@Loc["CityQuestion"]</h1>
        <p>@Loc["CityWelcome"]</p>
        <form method="get" action="/" class="search" role="search">
            <label for="busca" class="sr-only">@Loc["CitySearch"]</label>
            <svg class="icon" aria-hidden="true"><use href="/images/icons.svg#search" /></svg>
            <input type="search" id="busca" name="busca" maxlength="120" placeholder="@Loc["CitySearch"]" value="@ViewData["Search"]" />
            <button type="submit">@Loc["SearchButton"]</button>
        </form>
        <nav class="hero-quick-tags" aria-label="@Loc["CityQuestion"]">
            <a href="/agenda?dias=0" class="quick-pill"><span aria-hidden="true">☀</span> @Loc["AgendaToday"]</a>
            <a href="/agenda" class="quick-pill"><span aria-hidden="true">▦</span> @Loc["NavAgenda"]</a>
            <a href="/como-chegar" class="quick-pill"><span aria-hidden="true">↗</span> @Loc["RouteTitle"]</a>
            <a href="/guia" class="quick-pill"><span aria-hidden="true">⌖</span> @Loc["NavGuide"]</a>
        </nav>
        <a href="/guia-ia" class="hero-curio"><img src="/images/curio-marca.svg" width="32" height="32" alt="" />@Loc["CityCurio"] <span aria-hidden="true">↗</span></a>
    </div>
    <figure class="hero-photo">
        <img src="/images/licensed/estacao-docas-1920.webp" alt="@Loc["EstacaoDocasPhoto"]" width="1920" height="1280" fetchpriority="high" />
        <figcaption class="hero-caption">
            Estação das Docas · <a href="https://commons.wikimedia.org/wiki/File:Esta%C3%A7%C3%A3o_das_Docas_Bel%C3%A9m_Par%C3%A1_2023-8696.jpg" target="_blank" rel="noopener noreferrer">Prburley / Wikimedia Commons</a>
            · <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a> · @Loc["PhotoOptimized"]
        </figcaption>
    </figure>
</section>

@if (ViewData["Campaigns"] is IReadOnlyList<AdvertiserCampaign> campaigns)
{
    <partial name="_SponsoredCampaigns" model="campaigns" />
}

<!-- SEÇÃO DE NOTÍCIAS EDITORIAIS -->
<section class="section news-section" id="noticias" aria-labelledby="news-title">
    <div class="sectionhead">
        <div>
            <span class="eyebrow">MINHABELÉM / 360</span>
            <h2 id="news-title">@(filtered ? Loc["Home_LatestNews"] : Loc["CityToday"])</h2>
            <p class="section-subtitle">@Loc["EditorialNote"]</p>
        </div>
        <a href="/agora">@Loc["ViewMore"] ↗</a>
    </div>

    <!-- FAIXA DE CATEGORIAS -->
<nav class="categories category-strip" aria-label="@Loc["AllCategories"]">
    <a href="/" aria-current="@(ViewData["Category"] == null ? "page" : null)">@Loc["AllCategories"]</a>
    @foreach (var category in MinhaBelem.Core.Taxonomy.Taxonomy.All)
    {
        <a href="/?categoria=@category.Slug" aria-current="@(string.Equals(ViewData["Category"] as string, category.Slug, StringComparison.OrdinalIgnoreCase) ? "page" : null)">@Loc["Category_" + category.Slug]</a>
    }
</nav>


    @if (Model.Count == 0)
    {
        <div class="editorial-empty">
            <svg class="empty-art" aria-hidden="true"><use href="/images/icons.svg#river" /></svg>
            <div>
                <h3>@Loc["EmptyTitle"]</h3>
                <p>@Loc["EmptyDescription"]</p>
                <a class="button-link" href="/guia">@Loc["NavGuide"] ↗</a>
            </div>
        </div>
    }
    else
    {
        <div class="@(filtered ? "grid" : "editorial-grid")">
        @foreach (var item in Model)
        {
            <article class="story @(item == Model[0] && !filtered ? "story-lead" : "")">
                @if (!string.IsNullOrWhiteSpace(item.ImageUrl) && !string.IsNullOrWhiteSpace(item.ImageLicense) && !string.IsNullOrWhiteSpace(item.ImageCredit))
                {
                    <figure><img src="@item.ImageUrl" alt="" width="640" height="400" loading="lazy" decoding="async" /><figcaption>@item.ImageCredit</figcaption></figure>
                }
                <span class="eyebrow">@Loc["Category_" + MinhaBelem.Core.Taxonomy.Taxonomy.Info(item.Category).Slug]</span>
                <h3><a asp-action="Detalhe" asp-route-id="@item.Id">@item.DisplayTitle</a></h3>
                <p>@item.DisplaySummary</p>
                <div class="card-meta">
                    <span>@item.SourceName</span>
                    <time datetime="@item.PublishedAt.ToString("O")">@PortalTime.Local(item.PublishedAt).ToString("d", culture)</time>
                </div>
            </article>
        }
        </div>
        <nav class="pagination" aria-label="@Loc["NextPage"]">
            @if (page > 1) { <a asp-action="Index" asp-route-pagina="@(page - 1)" asp-route-busca="@ViewData["Search"]" asp-route-categoria="@ViewData["Category"]">← @Loc["PreviousPage"]</a> }
            <span>@(page)</span>
            @if (Model.Count >= 12) { <a asp-action="Index" asp-route-pagina="@(page + 1)" asp-route-busca="@ViewData["Search"]" asp-route-categoria="@ViewData["Category"]">@Loc["NextPage"] →</a> }
        </nav>
    }
</section>

@if (filtered)
{
    <partial name="_HomePlaces" model="places" />
}

@if (!filtered)
{
    <!-- DESTAQUE DA AGENDA CULTURAL & FESTIVA -->
    <section class="section home-events-highlight" aria-labelledby="home-events-title">
        <div class="sectionhead">
            <div>
                <span class="eyebrow">@Loc["NavAgenda"]</span>
                <h2 id="home-events-title">@Loc["Upcoming_Belém_Events"]</h2>
                <p class="section-subtitle">
                    @Loc["Upcoming_Belém_Events_Subtitle"]
                </p>
            </div>
            <div class="header-tools">
                <a class="button secondary" href="/agenda">@Loc["NavAgenda"] ↗</a>
                <a class="button" href="/agenda/semana">@Loc["ThisWeek"] ↗</a>
            </div>
        </div>

        @if (events.Count == 0)
        {
            <p class="notice">@Loc["AgendaEmpty"] <a href="/agenda">@Loc["AgendaAll"] ↗</a></p>
        }
        else
        {
            <div class="events-spotlight-grid">
                @foreach (var item in events)
                {
                    var localStart = item.EventStartAt.HasValue ? PortalTime.Local(item.EventStartAt.Value) : (DateTime?)null;
                    var topicSlug = MinhaBelem.Infrastructure.MySql.CuratedAgendaImporter.AgendaSubjects.Contains(item.Subject ?? "") ? "AgendaTopic_" + item.Subject : "Category_" + MinhaBelem.Core.Taxonomy.Taxonomy.Info(item.Category).Slug;
                    var artSvg = item.Subject switch { "corrida" => "sport", "musica" or "humor" => "music", "infantil" => "family", "congressos" or "feiras" => "city", _ => "stage" };
                    var hasCustomImg = !string.IsNullOrWhiteSpace(item.ImageUrl) && !string.IsNullOrWhiteSpace(item.ImageCredit) && !item.ImageUrl.StartsWith("/images/agenda/", StringComparison.Ordinal);
                    var imgUrl = hasCustomImg ? item.ImageUrl : $"/images/agenda/{artSvg}.svg";
                    var isFree = item.IsFree;
                    var priceText = isFree ? Loc["Event_Confirmed_Free"].Value : (!string.IsNullOrWhiteSpace(item.TicketPriceText) ? item.TicketPriceText : Loc["Event_Check_Price"].Value);

                    <article class="event-spotlight-card" aria-labelledby="event-title-@item.Id">
                        <div class="event-spotlight-header">
                            <img src="@imgUrl" alt="" width="480" height="270" loading="lazy" decoding="async" />
                            @if (localStart.HasValue)
                            {
                                <div class="event-date-badge" aria-hidden="true">
                                    <strong>@localStart.Value.ToString("dd")</strong>
                                    <span>@localStart.Value.ToString("MMM", culture)</span>
                                </div>
                            }
                            <span class="event-price-tag @(isFree ? "is-free" : "")">
                                @(isFree ? "✓ " + Loc["FreeEvents"].Value : priceText)
                            </span>
                        </div>

                        <div class="event-spotlight-body">
                            <span class="eyebrow">
                                <span aria-hidden="true">🏷️</span> @Loc[topicSlug]
                            </span>

                            <h3 class="event-spotlight-title" id="event-title-@item.Id">
                                <a asp-action="Detalhe" asp-route-id="@item.Id">@item.DisplayTitle</a>
                            </h3>

                            <div class="event-spotlight-meta">
                                @if (localStart.HasValue)
                                {
                                    <div>
                                        <span aria-hidden="true">🕒</span>
                                        <time datetime="@item.EventStartAt?.ToString("O")">
                                            @localStart.Value.ToString("dddd, dd 'de' MMMM", culture) · @(AgendaPage.DateOnlyEvent(item) ? Loc["AgendaUnknownTime"].Value : localStart.Value.ToString("HH:mm"))
                                        </time>
                                    </div>
                                }
                                <div>
                                    <span aria-hidden="true">📍</span>
                                    <span>@(item.EventDetails?.Location ?? item.Address ?? item.Neighborhood ?? "Belém do Pará")</span>
                                </div>
                            </div>

                            <p>
                                @(item.DisplaySummary.Length > 150 ? item.DisplaySummary[..147] + "..." : item.DisplaySummary)
                            </p>

                            <div class="event-spotlight-actions">
                                <span class="badge" title="@Loc["Event_Official_Source"]">
                                    🏛️ @item.SourceName
                                </span>
                                <a asp-action="Detalhe" asp-route-id="@item.Id" class="button-link" aria-label="@Loc["Event_Details_Link"]: @item.DisplayTitle">
                                    @Loc["ViewMore"] ↗
                                </a>
                            </div>
                        </div>
                    </article>
                }
            </div>
            <nav class="pagination" aria-label="Atalhos da Agenda">
                <a href="/agenda" class="quick-pill">@Loc["UpcomingEvents"] ↗</a>
                <a href="/cinema-teatro" class="quick-pill">@Loc["CinemaTheater"] ↗</a>
                <a href="/programacao-infantil" class="quick-pill">@Loc["ChildrenProgram"] ↗</a>
                <a href="/eventos-gratuitos" class="quick-pill">@Loc["FreeEvents"] ↗</a>
            </nav>
        }
    </section>

<partial name="_HomePlaces" model="places" />
    <!-- EXPLORE & ROTEIROS DE BELÉM -->
    <section class="section discovery-feature">
        <div>
            <span class="eyebrow">@Loc["NavExplore"]</span>
            <h2>@Loc["Explore_Hero_Title"]</h2>
            <p>@Loc["Explore_Hero_Subtitle"]</p>
            <a class="button" href="/explore">@Loc["WhatToVisit"] ↗</a>
        </div>
        <div class="route-list">
            @foreach (var route in itineraries.Take(4))
            {
                <a href="/explore/roteiro/@route.Slug">
                    <span>@route.Days.ToString("00")</span>
                    <strong>@route.GetTitle(culture.Name)</strong>
                    <span aria-hidden="true">↗</span>
                </a>
            }
            @if (itineraries.Count == 0)
            {
                <p>@Loc["General_Empty"]</p>
            }
        </div>
    </section>

    <section class="section home-mobility-highlight" aria-labelledby="home-mobility-title">
        <div class="mobility-banner-card">
            <div class="mobility-banner-header"><div>
                <span class="eyebrow">@Loc["NavMobility"]</span>
                <h2 id="home-mobility-title">@Loc["CityMove"]</h2>
                <p>@Loc["CityMoveText"]</p>
            </div><a href="/mobilidade" class="button">@Loc["NavMobility"] ↗</a></div>
            <nav class="mobility-quick-grid" aria-label="@Loc["NavMobility"]">
                <a href="/mobilidade/de-para" class="mobility-quick-action"><strong>De-Para</strong><span>@Loc["RouteTitle"] ↗</span></a>
                <a href="/mobilidade#linhas" class="mobility-quick-action"><strong>@Loc["NavMobility"]</strong><span>@Loc["CityRoutes"] · BRT ↗</span></a>
                <a href="/mobilidade/paradas" class="mobility-quick-action"><strong>@Loc["TransitStops"]</strong><span>@Loc["ViewMore"] ↗</span></a>
                <a href="/mobilidade/fluvial" class="mobility-quick-action"><strong>@Loc["RiverMobility"]</strong><span>@Loc["CityFluvialText"] ↗</span></a>
            </nav>
        </div>
    </section>

    <!-- GASTRONOMIA PARAENSE -->
    <section class="section">
        <div class="sectionhead">
            <div>
                <span class="eyebrow">AÇAÍ / TACACÁ / MANIÇOBA</span>
                <h2>@Loc["GastronomyTitle"]</h2>
            </div>
            <a href="/guia?categoria=restaurant">@Loc["WhereToEat"] ↗</a>
        </div>
        <div class="grid">
            @foreach (var place in gastronomy.Take(3))
            {
                <article class="card">
                    <span class="eyebrow">@place.Neighborhood</span>
                    <h3><a href="/guia/@place.Id">@place.DisplayName</a></h3>
                    <p>@place.DisplayEditorialNote</p>
                </article>
            }
        </div>
        @if (gastronomy.Count == 0)
        {
            <p class="empty">@Loc["General_Empty"] · <a href="/guia">@Loc["NavGuide"] ↗</a></p>
        }
    </section>

    <!-- MEU BAIRRO -->
    <section class="section">
        <div class="sectionhead">
            <div>
                <span class="eyebrow">@Loc["NavNeighborhood"]</span>
                <h2>@Loc["NeighborhoodTitle"]</h2>
            </div>
            <a href="/meu-bairro">@Loc["ViewMore"] ↗</a>
        </div>
        <div class="neighborhood-list">
            @foreach (var area in neighborhoods.Take(4))
            {
                <a href="/meu-bairro/@area.Slug">
                    <span class="eyebrow">@area.Zone</span>
                    <h3>@area.Name</h3>
                    <span aria-hidden="true">↗</span>
                </a>
            }
            @if (neighborhoods.Count == 0)
            {
                <p class="empty">@Loc["General_Empty"]</p>
            }
        </div>
    </section>

    <!-- PARCEIROS DA CIDADE -->
    <section class="section sponsor-feature">
        <div>
            <span class="eyebrow">@Loc["NavPartners"] / MINHABELÉM</span>
            <h2>@Loc["PartnerTitle"]</h2>
            <p>@Loc["PartnerDescription"]</p>
        </div>
        <a href="/parceiros" class="button">@Loc["NavPartners"] ↗</a>
    </section>
}

<!-- ACERVO FOTOGRÁFICO DOCUMENTAL E ENVIO DE FOTOS -->
<section class="section photo-gallery-section" aria-labelledby="photo-gallery-title">
    <div class="sectionhead">
        <div>
            <span class="eyebrow">MINHABELÉM / FOTOS</span>
            <h2 id="photo-gallery-title">@Loc["CityGallery"]</h2>
        </div>
        <a href="/guia/acervo" class="button-link">@Loc["ViewPhotoArchive"] ↗</a>
    </div>
    <div class="photo-gallery" id="home-photo-gallery">
        <figure class="photo-item">
            <a href="/images/licensed/sprint18-ver-o-peso-1280.webp" data-lightbox="home-photos" data-src="/images/licensed/sprint18-ver-o-peso-1280.webp" data-caption="Ver-o-Peso · Belém"><img src="/images/licensed/sprint18-ver-o-peso-640.webp" alt="Mercado Ver-o-Peso em Belém do Pará" width="640" height="480" loading="lazy" decoding="async" /></a>
            <figcaption>Ver-o-Peso · Campina<br /><a href="https://commons.wikimedia.org/wiki/File:Bel%C3%A9m_Fishing_port_and_Ver-o-peso_01.jpg" target="_blank" rel="noopener noreferrer">Cayambe · CC BY-SA 3.0</a></figcaption>
        </figure>
        <figure class="photo-item">
            <a href="/images/licensed/sprint18-tacaca-1280.webp" data-lightbox="home-photos" data-src="/images/licensed/sprint18-tacaca-1280.webp" data-caption="Tacacá do Renato · Belém"><img src="/images/licensed/sprint18-tacaca-640.webp" alt="Tacacá tradicional fervente em cuia" width="640" height="480" loading="lazy" decoding="async" /></a>
            <figcaption>Tacacá · Tradição Paraense<br /><a href="https://commons.wikimedia.org/wiki/File:Tacac%C3%A1_soup_at_Tacac%C3%A1_do_Renato,_Bel%C3%A9m,_Brazil_04.jpg" target="_blank" rel="noopener noreferrer">Ridiculopathy · CC0</a></figcaption>
        </figure>
        <figure class="photo-item">
            <a href="/images/licensed/sprint18-guajara-1280.webp" data-lightbox="home-photos" data-src="/images/licensed/sprint18-guajara-1280.webp" data-caption="Baía do Guajará · Belém"><img src="/images/licensed/sprint18-guajara-640.webp" alt="Pôr do sol na Baía do Guajará" width="640" height="480" loading="lazy" decoding="async" /></a>
            <figcaption>Baía do Guajará<br /><a href="https://commons.wikimedia.org/wiki/File:Baia_do_Guajar%C3%A1.jpg" target="_blank" rel="noopener noreferrer">Ancalibor2019 · CC BY-SA 4.0</a></figcaption>
        </figure>
    </div>
    <div class="photo-upload-zone" role="group" aria-label="@Loc["UploadPhotoTitle"]">
        <span class="photo-upload-icon" aria-hidden="true">📷</span>
        <p><strong>@Loc["UploadPhotoTitle"]</strong></p>
        <p>@Loc["UploadPhotoDesc"]</p>
        <a class="button small" href="/fotos/enviar">Enviar foto ↗</a>
    </div>
</section>


<!-- SEÇÃO ÚNICA E CONSOLIDADA DE VÍDEOS DE BELÉM (ELIMINADA A DUPLICAÇÃO DA SPRINT ANTERIOR) -->
<section class="section video-section" aria-labelledby="video-section-title">
    <div class="sectionhead">
        <div>
            <span class="eyebrow">MINHABELÉM / VÍDEOS</span>
            <h2 id="video-section-title">@Loc["VideoTitle"]</h2>
        </div>
        <a href="/videos" class="button-link">@Loc["ViewAllVideos"] ↗</a>
    </div>
    <div class="video-grid">
        @if (videos is not null && videos.Count > 0)
        {
            @foreach (var video in videos.Take(3))
            {
                <article class="video-card">
                    <div class="video-wrapper">
                        @if (!string.IsNullOrWhiteSpace(video.EmbedHtml))
                        {
                            <div class="video-embed">@Html.Raw(video.EmbedHtml)</div>
                            <div class="video-badge" aria-hidden="true">▶ @video.Platform</div>
                        }
                        else
                        {
                            <div class="video-placeholder" style="height:100%;display:flex;align-items:center;justify-content:center;background:var(--color-green-surface);">
                                <span style="font-size:2.5rem;" aria-hidden="true">🎬</span>
                            </div>
                            <div class="video-badge" aria-hidden="true">▶ @video.Platform</div>
                        }
                    </div>
                    <h3><a href="@(video.PostUrl ?? "#")" target="_blank" rel="noopener noreferrer">@video.Title ↗</a></h3>
                    <p>@video.CaptionSnippet</p>
                    <div class="video-meta">
                        <span aria-hidden="true">📺</span> @video.Platform · <span>@(video.PublishedAt?.ToString("dd/MM/yyyy", culture) ?? "")</span>
                    </div>
                </article>
            }
        }
        else
        {
            <p class="notice">@Loc["CityNoVideo"]</p>
        }
    </div>
</section>

<!-- COLABORAÇÃO DA COMUNIDADE -->
<section class="section collaboration">
    <div>
        <span class="eyebrow">MINHABELÉM / COMUNIDADE</span>
        <h2>@Loc["Collab_Title"]</h2>
        <p>@Loc["Collab_Subtitle"]</p>
    </div>
    <form asp-controller="Home" asp-action="Colaborar" method="post">
        <label>
            @Loc["Collab_Name"]
            <input name="nome" maxlength="100" required autocomplete="name" />
        </label>
        <label>
            @Loc["Collab_Message"]
            <textarea name="mensagem" maxlength="2500" rows="4" required></textarea>
        </label>
        <label class="checkbox-label">
            <input type="checkbox" name="consentimento" value="true" required />
            <span>@Loc["Collab_Consent"] (<a href="/privacidade">@Loc["Nav_Privacy"]</a>)</span>
        </label>
        <button type="submit" class="button">@Loc["Collab_Submit"] ↗</button>
    </form>
</section>
