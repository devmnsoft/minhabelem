@model IReadOnlyList<MinhaBelem.Web.Models.ContentItem>
<section class="hero"><div class="eyebrow">BELÉM • PARÁ • AMAZÔNIA</div><h1>A cidade que a gente vive, <em>todo dia.</em></h1><p>Notícias, cultura, lazer, serviços e mobilidade para quem vive e visita Belém.</p><form method="get" class="search"><label for="busca" class="sr-only">Buscar na cidade</label><input id="busca" name="busca" maxlength="120" placeholder="O que você procura em Belém?" value="@ViewData["Search"]"/><button type="submit">Buscar</button></form></section>
<section class="categories" aria-label="Explorar a cidade"><a href="/?categoria=eventos">🎭 Eventos</a><a href="/?categoria=cinema">🎬 Cinema</a><a href="/?categoria=teatro">🎟 Teatro</a><a href="/?categoria=infantil">🎈 Infantil</a><a href="/?categoria=esporte">⚽ Esportes</a><a href="/?categoria=transporte">🚌 Ônibus</a><a href="/?categoria=turismo">🌿 Turismo</a><a href="/?categoria=saude">🏥 Saúde</a><a href="/?categoria=servicos">🏛 Serviços</a></section>
<section class="section"><div class="sectionhead"><div><span class="eyebrow">FIQUE POR DENTRO</span><h2>Belém em pauta</h2></div><span class="small">Publicamos conteúdos verificados por fontes identificadas.</span></div>
@if(Model.Count==0){<div class="empty"><h3>Novidades em preparação</h3><p>Estamos conectando as fontes de informação. Nenhuma notícia fictícia é exibida.</p><p>Enquanto isso, consulte os <a href="https://seguranca.belem.pa.gov.br/servicos-semob/" target="_blank" rel="noopener noreferrer">serviços oficiais de mobilidade</a> e a <a href="https://secult.belem.pa.gov.br/" target="_blank" rel="noopener noreferrer">Secretaria de Cultura</a>.</p></div>}
else {<div class="grid">@foreach(var item in Model){<article class="card"><div class="eyebrow">@item.Category</div><h3><a asp-action="Detalhe" asp-route-id="@item.Id">@item.Title</a></h3><p>@item.Summary</p><span class="small">Fonte: @item.SourceName • @item.PublishedAt.ToString("dd/MM/yyyy")</span></article>}</div>}</section>
<section class="section cta"><h2>Belém é feita de gente.</h2><p>Conhece um evento, notícia ou serviço que merece espaço? Envie sua sugestão. Ela será revisada antes de qualquer publicação.</p>@if(TempData["Notice"] is string notice){<p role="status">@notice</p>}<form asp-controller="Home" asp-action="Colaborar" method="post"><label>Seu nome<input name="nome" maxlength="100" required/></label><label>Sugestão<textarea name="mensagem" maxlength="2500" rows="4" required></textarea></label><button type="submit">Enviar para revisão</button></form></section>