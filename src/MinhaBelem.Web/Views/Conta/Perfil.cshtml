@model MinhaBelem.Infrastructure.Identity.ApplicationUser
<section class="section article"><h1>Meu perfil</h1><p>@Model.DisplayName · @Model.Email</p><p><a href="/conta/mfa">Autenticador</a> · <a href="/conta/sessoes">Minhas sessões</a></p><h2>Alterar senha</h2><form method="post" asp-action="Senha"><label>Senha atual<input name="CurrentPassword" type="password" autocomplete="current-password" required /></label><label>Nova senha (12 caracteres ou mais)<input name="NewPassword" type="password" autocomplete="new-password" minlength="12" required /></label><button type="submit">Alterar senha e sair</button></form><h2>Permissões</h2><ul>@foreach(var claim in User.FindAll("mb:permission")){<li>@claim.Value</li>}</ul><form method="post" asp-action="Sair"><button type="submit">Sair desta sessão</button></form></section>
