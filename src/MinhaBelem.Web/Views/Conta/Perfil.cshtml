@model MinhaBelem.Infrastructure.Identity.ApplicationUser

@{
    ViewData["Title"] = "Meu Perfil — MinhaBelém";
}
@if(Model.MustChangePassword){<div class="notice" role="alert">Troque a senha temporária para continuar e configure o autenticador MFA.</div>}
<section class="section"><form method="post" action="/conta/preferencias" class="card route-form">@Html.AntiForgeryToken()<h2>@Loc["AccountPreferences"]</h2><label>@Loc["AccountLanguage"]<select name="culture">@foreach(var language in MinhaBelem.Web.Resources.SupportedCultures.All){<option value="@language" selected="@(ViewData["PreferredCulture"] as string==language)">@System.Globalization.CultureInfo.GetCultureInfo(language).NativeName</option>}</select></label><label><input name="accessible" type="checkbox" value="true" checked="@(ViewData["PrefersAccessible"] as bool?==true)"/> @Loc["RouteAccessible"]</label><button>@Loc["Save"]</button></form></section>

<section class="section" style="max-width:760px;margin:50px auto 80px;">
    <div class="card" style="padding:36px;border-top:6px solid var(--green-forest);box-shadow:var(--shadow-md);">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:16px;margin-bottom:24px;">
            <div>
                <span class="eyebrow">DADOS DA CONTA</span>
                <h1 style="font-size:2rem;margin:4px 0 6px;">@Model.DisplayName</h1>
                <p class="view-38965f9b small text-muted">@Model.Email · Usuário registrado</p>
            </div>
            <div class="view-4a5cec13">
                <a href="/conta/mfa" class="button secondary small">🔐 Autenticador TOTP</a>
                <a href="/conta/sessoes" class="button outline small">📱 Sessões Ativas</a>
            </div>
        </div>

        @if (TempData["Notice"] is string notice)
        {
            <div class="notice" role="status">
                <span>ℹ️ @notice</span>
            </div>
        }

        <!-- ALTERAÇÃO DE SENHA -->
        <div style="background:var(--creme);padding:24px;border-radius:var(--radius-md);border:1px solid var(--border);margin-bottom:30px;">
            <h2 style="font-size:1.3rem;margin-bottom:12px;">Alterar Senha de Acesso</h2>
            <form method="post" asp-action="Senha">
                @Html.AntiForgeryToken()
                <label>
                    Senha Atual *
                    <input name="CurrentPassword" type="password" autocomplete="current-password" required placeholder="Digite sua senha atual" />
                </label>
                <label class="view-8d842990">
                    Nova Senha Forte * (Mínimo 12 caracteres, maiúscula, minúscula, número e símbolo)
                    <input name="NewPassword" type="password" autocomplete="new-password" minlength="12" required placeholder="Digite a nova senha segura" />
                </label>
                <div style="margin-top:18px;">
                    <button type="submit" class="button small">Alterar Senha e Invalidar Sessões Anteriores</button>
                </div>
            </form>
        </div>

        <!-- PERMISSÕES CONCEDIDAS -->
        <div class="view-a612e8d2">
            <h3 class="view-fe794d34">Permissões Atribuídas ao seu Perfil</h3>
            <div class="view-31e4e2a2">
                @foreach (var claim in User.FindAll("mb:permission"))
                {
                    <span class="badge badge-primary">@claim.Value</span>
                }
            </div>
        </div>

        <div style="padding-top:20px;border-top:1px solid var(--border-subtle);display:flex;justify-content:flex-end;">
            <form method="post" asp-action="Sair">
                @Html.AntiForgeryToken()
                <button type="submit" class="button secondary small">Encerrar Sessão</button>
            </form>
        </div>
    </div>
</section>
