@model MinhaBelem.Infrastructure.Identity.ApplicationUser

@{
    ViewData["Title"] = "Meu Perfil — MinhaBelém";
}

@if (Model.MustChangePassword)
{
    <div class="notice error-notice" role="alert" style="margin-bottom:24px;">
        <strong>Ação Obrigatória:</strong> Sua conta está configurada com senha provisória de homologação. Atualize sua senha abaixo e em seguida configure seu autenticador MFA para desbloquear o acesso pleno à plataforma.
    </div>
}

<section class="section" style="max-width:820px;margin:20px auto 60px;">
    <!-- PREFERÊNCIAS DE ACESSIBILIDADE E IDIOMA -->
    <div class="card route-form" style="padding:28px;margin-bottom:28px;">
        <h2>@Loc["AccountPreferences"]</h2>
        <form method="post" action="/conta/preferencias">
            @Html.AntiForgeryToken()
            <div class="form-group" style="margin-bottom:16px;">
                <label for="pref-culture">
                    @Loc["AccountLanguage"]
                </label>
                <select id="pref-culture" name="culture" class="form-control" style="max-width:320px;">
                    @foreach (var language in MinhaBelem.Web.Resources.SupportedCultures.All)
                    {
                        <!option value="@language" @(string.Equals(ViewData["PreferredCulture"] as string, language, StringComparison.OrdinalIgnoreCase) ? "selected" : null)>
                            @System.Globalization.CultureInfo.GetCultureInfo(language).NativeName (@language)
                        </!option>
                    }
                </select>
            </div>

            <div class="form-group" style="margin-bottom:20px;">
                <label class="checkbox-label" for="pref-accessible" style="display:flex;align-items:center;gap:10px;cursor:pointer;">
                    <input id="pref-accessible" name="accessible" type="checkbox" value="true" @(ViewData["PrefersAccessible"] as bool? == true ? "checked" : null) style="width:20px;height:20px;" />
                    <span>@Loc["RouteAccessible"] (Priorizar rotas acessíveis com elevador, rampa e piso tátil)</span>
                </label>
            </div>

            <button type="submit" class="button small">@Loc["Save"] ↗</button>
        </form>
    </div>

    <!-- DADOS DA CONTA -->
    <div class="card" style="padding:36px;border-top:6px solid var(--river,#123f36);box-shadow:var(--shadow-md);">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:16px;margin-bottom:24px;">
            <div>
                <span class="eyebrow">DADOS DA CONTA</span>
                <h1 style="font-size:2rem;margin:4px 0 6px;">@Model.DisplayName</h1>
                <p class="small text-muted">@Model.Email · Usuário registrado</p>
                <p class="small">
                    MFA Ativo: <strong>@(Model.TwoFactorEnabled ? "Sim (TOTP)" : "Não configurado")</strong> ·
                    Troca de Senha Pendente: <strong>@(Model.MustChangePassword ? "Sim" : "Não")</strong>
                </p>
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;">
                <a href="/conta/mfa" class="button secondary small">🔐 Autenticador TOTP</a>
                <a href="/conta/sessoes" class="button outline small">📱 Sessões Ativas</a>
            </div>
        </div>

        @if (TempData["Notice"] is string notice)
        {
            <div class="notice" role="status" style="margin-bottom:24px;">
                <span>ℹ️ @notice</span>
            </div>
        }

        <div id="profile-caps-warning" class="notice caps-lock-notice" role="status" aria-live="polite" hidden style="margin-bottom:16px;">
            <span aria-hidden="true">⚠️</span> @Loc["CapsLock_Warning"]
        </div>

        <!-- FORMULÁRIO DE ALTERAÇÃO DE SENHA -->
        <div style="background:var(--creme-dark,#f4eee2);padding:24px;border-radius:var(--radius-md,14px);border:1px solid var(--border,#d4ded5);margin-bottom:30px;">
            <h2 style="font-size:1.3rem;margin-bottom:12px;">Alterar Senha de Acesso</h2>
            <p class="small text-muted" style="margin-bottom:16px;">
                A senha deve conter no mínimo 12 caracteres, incluindo letras maiúsculas, minúsculas, números e símbolos especiais.
            </p>

            <form method="post" asp-action="Senha" id="change-password-form">
                @Html.AntiForgeryToken()

                <div class="form-group" style="margin-bottom:14px;">
                    <label for="current-pwd">
                        Senha Atual *
                    </label>
                    <div class="password-wrapper">
                        <input id="current-pwd"
                               name="CurrentPassword"
                               type="password"
                               autocomplete="current-password"
                               required
                               placeholder="Digite sua senha atual"
                               class="form-control" />
                        <button type="button"
                                class="password-toggle-btn"
                                data-target="current-pwd"
                                aria-label="@Loc["Password_Show"]"
                                aria-pressed="false">
                            <span class="toggle-icon" aria-hidden="true">👁️</span>
                        </button>
                    </div>
                </div>

                <div class="form-group" style="margin-bottom:18px;">
                    <label for="new-pwd">
                        Nova Senha Forte * (mínimo 12 caracteres)
                    </label>
                    <div class="password-wrapper">
                        <input id="new-pwd"
                               name="NewPassword"
                               type="password"
                               autocomplete="new-password"
                               minlength="12"
                               required
                               placeholder="Digite a nova senha segura"
                               class="form-control" />
                        <button type="button"
                                class="password-toggle-btn"
                                data-target="new-pwd"
                                aria-label="@Loc["Password_Show"]"
                                aria-pressed="false">
                            <span class="toggle-icon" aria-hidden="true">👁️</span>
                        </button>
                    </div>
                </div>

                <div>
                    <button type="submit" class="button small">
                        Alterar Senha e Atualizar Credenciais ↗
                    </button>
                </div>
            </form>
        </div>

        <!-- PERMISSÕES CONCEDIDAS -->
        <div style="margin-bottom:24px;">
            <h3 style="font-size:1.1rem;margin-bottom:10px;">Permissões Atribuídas ao seu Perfil</h3>
            <div style="display:flex;gap:8px;flex-wrap:wrap;">
                @foreach (var claim in User.FindAll("mb:permission"))
                {
                    <span class="badge" style="background:#eaf1e7;color:#1e3f32;border:1px solid #c5d7c8;padding:4px 8px;border-radius:4px;font-size:0.8rem;font-weight:700;">
                        @claim.Value
                    </span>
                }
            </div>
        </div>

        <div style="padding-top:20px;border-top:1px solid var(--border,#d4ded5);display:flex;justify-content:flex-end;">
            <form method="post" asp-action="Sair">
                @Html.AntiForgeryToken()
                <button type="submit" class="button secondary small">Encerrar Sessão</button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
<script>
(function() {
    var showLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc["Password_Show"].Value));
    var hideLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc["Password_Hide"].Value));

    document.querySelectorAll('.password-toggle-btn[data-target]').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var targetId = btn.getAttribute('data-target');
            var input = document.getElementById(targetId);
            if (!input) return;
            var isPassword = input.getAttribute('type') === 'password';
            input.setAttribute('type', isPassword ? 'text' : 'password');
            btn.setAttribute('aria-pressed', String(isPassword));
            var currentLabel = isPassword ? hideLabel : showLabel;
            btn.setAttribute('aria-label', currentLabel);
            var icon = btn.querySelector('.toggle-icon');
            if (icon) icon.textContent = isPassword ? '🙈' : '👁️';
            input.focus();
        });
    });

    var capsWarning = document.getElementById('profile-caps-warning');
    document.querySelectorAll('#change-password-form input[type="password"]').forEach(function(inp) {
        inp.addEventListener('keyup', function(e) {
            if (e.getModifierState && e.getModifierState('CapsLock')) {
                capsWarning.hidden = false;
            } else {
                capsWarning.hidden = true;
            }
        });
        inp.addEventListener('blur', function() {
            capsWarning.hidden = true;
        });
    });
})();
</script>
}
