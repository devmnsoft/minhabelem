@model IReadOnlyList<MinhaBelem.Core.Abstractions.UserSession>
<section class="section"><h1>Minhas sessões</h1><div class="table-wrap"><table><thead><tr><th>Início (UTC)</th><th>Expira (UTC)</th><th>Estado</th><th>Ação</th></tr></thead><tbody>@foreach(var session in Model){<tr><td>@session.CreatedAt.ToString("g")</td><td>@session.ExpiresAt.ToString("g")</td><td>@(session.RevokedAt is not null ? "Revogada" : session.ExpiresAt <= DateTime.UtcNow ? "Expirada" : "Ativa")</td><td>@if(session.RevokedAt is null){<form method="post" asp-action="Revogar"><input type="hidden" name="id" value="@session.Id" /><button type="submit">Encerrar</button></form>}</td></tr>}</tbody></table></div></section>
