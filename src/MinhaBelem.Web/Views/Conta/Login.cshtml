@model MinhaBelem.Web.Models.LoginInput
@{ ViewData["Title"] = Loc["LoginTitle"].Value; }
<section class="section account-section"><div class="card account-card"><span class="eyebrow">@Loc["AccountPortal"]</span><h1>@Loc["LoginTitle"]</h1><p>@Loc["LoginDescription"]</p><div asp-validation-summary="All" class="notice error-notice" role="alert"></div><form method="post" asp-action="Login"><label asp-for="Email">@Loc["EmailLabel"]<input asp-for="Email" autocomplete="username" type="email" required /></label><label asp-for="Password">@Loc["PasswordLabel"]<input asp-for="Password" autocomplete="current-password" type="password" required /></label><button type="submit">@Loc["NavLogin"] ↗</button></form></div></section>
