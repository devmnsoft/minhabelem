@model MinhaBelem.Web.Models.MfaModel

@{
    ViewData["Title"] = "Autenticação em Duas Etapas (MFA) — MinhaBelém";
}

<section class="section" style="max-width:580px;margin:50px auto 80px;">
    <div class="card" style="padding:36px;border-top:6px solid var(--gold);box-shadow:var(--shadow-md);">
        <span class="view-0488757b eyebrow">SEGURANÇA DA CONTA</span>
        <h1 style="font-size:1.85rem;margin:6px 0 16px;">Autenticação em Duas Etapas (TOTP)</h1>

        @if (Model.Enabled)
        {
            <div class="notice" role="status">
                <span>✓ <strong>Autenticador Ativo:</strong> Sua conta está protegida com TOTP de segundo fator.</span>
            </div>
            <div class="view-910f53fb">
                <a href="/editorial" class="button">Acessar Central Editorial →</a>
            </div>
        }
        else if (Model.Secret is null)
        {
            <p>
                Para acessar as áreas administrativas e editoriais do MinhaBelém, é obrigatório vincular sua conta a um aplicativo autenticador como Google Authenticator, Microsoft Authenticator ou 1Password.
            </p>
            <form method="post" asp-action="IniciarMfa" class="view-910f53fb">
                @Html.AntiForgeryToken()
                <button type="submit" class="button">Configurar Aplicativo Autenticador</button>
            </form>
        }
        else
        {
            <p class="view-7564ec60 small text-muted">
                No seu aplicativo autenticador, adicione uma nova conta via chave de configuração manual ou utilize o link direto.
            </p>

            <div style="background:var(--creme);padding:18px;border-radius:var(--radius-sm);border:1px solid var(--border);margin-bottom:20px;">
                <div style="font-size:0.9rem;margin-bottom:6px;"><strong>Conta:</strong> MinhaBelém Redação</div>
                <div style="font-size:0.9rem;margin-bottom:12px;"><strong>Chave Secreta:</strong> <code>@Model.Secret</code></div>
                <a href="@Model.Uri" class="button-link">📲 Abrir diretamente no aplicativo</a>
            </div>

            <form method="post" asp-action="ConfirmarMfa">
                @Html.AntiForgeryToken()
                <label for="code">
                    Código de 6 dígitos gerado pelo aplicativo *
                    <input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required placeholder="000000" style="font-size:1.4rem;letter-spacing:0.2em;text-align:center;" />
                </label>

                <div class="view-910f53fb">
                    <button type="submit" class="view-9ccc4ca9">Validar Código e Obter Códigos de Recuperação</button>
                </div>
            </form>
        }
    </div>
</section>
