@using MinhaBelem.Core.Entities
@using MinhaBelem.Core.Abstractions
@model VisitSchedule
@{ViewData["Title"]=Loc["RouteVisit"];var place=(Place)ViewData["Place"]!;var info=Model.Info;var weekly=Enumerable.Range(0,7).Select(d=>new{Day=d,Date=(DateTime?)null,Hours=Model.Hours.Where(h=>h.SpecialDate is null&&h.Weekday==d).ToArray()}).ToList();var groups=Model.Hours.Where(h=>h.SpecialDate is not null).GroupBy(h=>new{h.SpecialDate,h.Sector});}
<div class="admin-shell"><partial name="_AdminSidebar"/><main class="admin-content"><h1>@Loc["RouteVisit"] · @place.DisplayName</h1><p><a href="/como-chegar?placeId=@place.Id">@Loc["RouteTitle"] →</a></p><form method="post" class="card route-form">@Html.AntiForgeryToken()<input type="hidden" name="revision" value="@(info?.Revision??0)"/>
<label>@Loc["RouteSource"] (HTTPS)<input name="SourceUrl" type="url" value="@info?.SourceUrl" required maxlength="2000"/></label><label>UTC · @Loc["BatchVersion"]<input name="ConfirmedAt" type="datetime-local" value="@info?.ConfirmedAt.ToString("yyyy-MM-ddTHH:mm")" required/></label><label>UTC · @Loc["RouteWhen"]<input name="ValidUntil" type="datetime-local" value="@info?.ValidUntil.ToString("yyyy-MM-ddTHH:mm")" required/></label><label>@Loc["RouteEntry"]<input name="EntryPrice" type="number" min="0" step="0.01" value="@info?.EntryPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture)"/></label><label>½ · @Loc["RouteEntry"]<input name="HalfPrice" type="number" min="0" step="0.01" value="@info?.HalfPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture)"/></label><label>@Loc["BatchReason"]<textarea name="PriceConditions" maxlength="500">@info?.PriceConditions</textarea></label><label>@Loc["VisitState_closed"]<input name="ClosedUntil" type="date" value="@info?.ClosedUntil?.ToString("yyyy-MM-dd")"/></label><label><input name="ReservationOnly" type="checkbox" value="true" checked="@(info?.ReservationOnly??false)"/> @Loc["VisitReservationOnly"]</label><label>@Loc["VisitLastEntry"] (0–1439)<input name="LastEntryMinutes" type="number" min="0" max="1439" value="@info?.LastEntryMinutes"/></label>
@{var index=0;}
@foreach(var row in weekly){<fieldset><legend>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetDayName((DayOfWeek)row.Day)</legend><input name="days[@index].Weekday" type="hidden" value="@row.Day"/><input name="days[@index].Sector" type="hidden" value="principal"/><label>HH:mm-HH:mm;HH:mm-HH:mm<input name="days[@index].Intervals" value="@string.Join(';',row.Hours.Where(h=>h.OpenMinute.HasValue&&h.CloseMinute.HasValue).Select(h=>$"{h.OpenMinute/60:00}:{h.OpenMinute%60:00}-{h.CloseMinute/60:00}:{h.CloseMinute%60:00}"))"/></label><label><input name="days[@index].Closed" type="checkbox" value="true" checked="@row.Hours.Any(h=>h.IsClosed)"/> @Loc["VisitClosedDay"]</label><label><input name="days[@index].AllDay" type="checkbox" value="true" checked="@row.Hours.Any(h=>h.Is24h)"/> 24 h</label></fieldset>index++;}
@foreach(var group in groups){<fieldset><legend>@group.Key.SpecialDate?.ToString("d") · @group.Key.Sector</legend><input type="hidden" name="days[@index].Weekday" value="-1"/><input type="date" name="days[@index].Date" value="@group.Key.SpecialDate?.ToString("yyyy-MM-dd")"/><input name="days[@index].Sector" value="@group.Key.Sector"/><input name="days[@index].Intervals" value="@string.Join(';',group.Where(h=>h.OpenMinute.HasValue&&h.CloseMinute.HasValue).Select(h=>$"{h.OpenMinute/60:00}:{h.OpenMinute%60:00}-{h.CloseMinute/60:00}:{h.CloseMinute%60:00}"))"/><label><input type="checkbox" name="days[@index].Closed" value="true" checked="@group.Any(h=>h.IsClosed)"/> @Loc["VisitClosedDay"]</label><label><input name="days[@index].AllDay" type="checkbox" value="true" checked="@group.Any(h=>h.Is24h)"/> 24 h</label></fieldset>index++;}
<fieldset><legend>@Loc["VisitException"]</legend><input type="hidden" name="days[@index].Weekday" value="-1"/><label>@Loc["RouteWhen"]<input type="date" name="days[@index].Date"/></label><label>@Loc["VisitSector"]<input name="days[@index].Sector" value="principal" maxlength="120"/></label><label>HH:mm-HH:mm<input name="days[@index].Intervals"/></label><label><input type="checkbox" name="days[@index].Closed" value="true"/> @Loc["VisitClosedDay"]</label></fieldset>
<button>@Loc["VisitSave"]</button></form></main></div>
