@using System.Globalization
@using MinhaBelem.Core.Abstractions
@using MinhaBelem.Core.Security
@using MinhaBelem.Core.Services
@using MinhaBelem.Web.Models
@inject IConfiguration Configuration
@inject MinhaBelem.Core.Abstractions.IPlacePhotoScout PlacePhotos
@model MinhaBelem.Core.Entities.Place
@{
    ViewData["Title"] = Model.DisplayName;
    var live = ViewData["Live"] is true;
    var own = ViewData["OwnLandmark"] is true || LandmarkGuide.IsOwn(Model.GooglePlaceId);
    var schedule = ViewData["VisitSchedule"] as VisitSchedule ?? new(null,[]);
    var assessment = ViewData["VisitAssessment"] as VisitAssessment ?? new("unknown","unavailable","");
    var now = DateTime.UtcNow;
    var confirmed = schedule.Info is {} evidence && evidence.ConfirmedAt <= now && evidence.ValidUntil > now && SafeUrl.Validate(evidence.SourceUrl).IsValid;
    var hasPoint = Model.Latitude is >= -90 and <= 90 && Model.Longitude is >= -180 and <= 180;
    var mapUrl = own && hasPoint
        ? LandmarkGuide.MapLink(Model.Latitude!.Value, Model.Longitude!.Value)
        : "https://www.google.com/maps/search/?api=1&query=" + Uri.EscapeDataString(Model.DisplayName + ", Belém")
            + (string.IsNullOrWhiteSpace(Model.GooglePlaceId) ? "" : "&query_place_id=" + Uri.EscapeDataString(Model.GooglePlaceId));
    var canMap = hasPoint && (own || live) && Configuration["Maps:BrowserKey"] is { Length: > 0 };
    var placeLine = string.IsNullOrWhiteSpace(Model.Neighborhood) ? Model.Municipality
        : string.IsNullOrWhiteSpace(Model.Municipality) ? Model.Neighborhood
        : Model.Neighborhood + " · " + Model.Municipality;
}
@{
    var licensedPhotos = await PlacePhotos.ApprovedAsync(Model.Id, Model.Name, Context.RequestAborted);
}
<header class="section guide-heading">
    <div><span class="eyebrow">@Loc["Nav_Guide"] · BELÉM DO PARÁ</span><h1>@Model.DisplayName</h1><p class="lead">@Model.DisplayEditorialNote</p></div>
    <svg class="icon guide-intro-icon" aria-hidden="true" viewBox="0 0 64 64"><use href="/images/icons.svg#market"/></svg>
</header>
<article class="section guide-place-layout">
    <div>
        @if (licensedPhotos.Count > 0)
        {
            <div class="photo-grid">
                @foreach (var licensed in licensedPhotos.Take(6))
                {
                    <figure>
                        <img src="@licensed.ThumbUrl" alt="@Model.DisplayName" width="640" height="360" loading="lazy" referrerpolicy="no-referrer" />
                        <figcaption>@licensed.Credit · @licensed.LicenseName · <a href="@licensed.PageUrl" rel="noopener noreferrer" target="_blank">Commons</a></figcaption>
                    </figure>
                }
            </div>
            <p class="small">@Loc["PhotoNotCurrent"]</p>
        }
        @if(live && ViewData["Photo"] is string photo)
        {
            <figure class="guide-visual"><img src="@photo" alt="@Model.DisplayName" loading="lazy" referrerpolicy="no-referrer"/>
                <figcaption>@Loc["GuidePhoto"]:
                @foreach(var author in Model.PhotoAuthors){<span>@if(SafeUrl.Validate(author.Uri).IsValid){<a href="@author.Uri" target="_blank" rel="noopener noreferrer">@author.Name</a>}else{@author.Name} </span>}
                @if(SafeUrl.Validate(Model.PhotoGoogleMapsUri).IsValid){<a href="@Model.PhotoGoogleMapsUri" target="_blank" rel="noopener noreferrer">Google Maps ↗</a>}</figcaption>
            </figure>
        }
        @if(!string.IsNullOrWhiteSpace(Model.CulturalNotes)){<section class="card"><h2>@Loc["Glossary_Title"]</h2><p>@Model.CulturalNotes</p></section>}
        @if(live)
        {
            <dl class="guide-information">
                <div><dt>@Loc["GuideAddress"]</dt><dd>@Model.FormattedAddress</dd></div>
                @if(!string.IsNullOrWhiteSpace(Model.Phone)){<div><dt>@Loc["GuidePhone"]</dt><dd>@Model.Phone</dd></div>}
                <div><dt>@Loc["GuidePrice"]</dt><dd>@(Model.PriceText??Loc["NoVerifiedPrice"].Value)</dd></div>
                @if(Model.WheelchairAccessible is {} wheelchair){<div><dt>@Loc["GuideWheelchair"]</dt><dd>@Loc[wheelchair?"GuideYes":"GuideNo"]</dd></div>}
            </dl>
            @if(Model.OpeningHours.Count>0){<section class="card"><h2>@Loc["GuideHours"]</h2><ul>@foreach(var hours in Model.OpeningHours){<li>@hours.Label</li>}</ul></section>}
            <p class="small attribution"><img src="/images/google-maps-attribution.svg" alt="Google Maps" width="100" height="18"/> @Loc["GuideProviderNote"]</p>
        }
        else if (own)
        {
            <dl class="guide-information">
                @if (!string.IsNullOrWhiteSpace(Model.FormattedAddress))
                {
                    <div><dt>@Loc["GuideAddress"]</dt><dd>@Model.FormattedAddress</dd></div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Neighborhood) || !string.IsNullOrWhiteSpace(Model.Municipality))
                {
                    <div><dt>@Loc["Neighborhood"]</dt><dd>@placeLine</dd></div>
                }
            </dl>
            <p class="notice" role="status">@Loc["LandmarkUnverified"]</p>
        }
        else{<p class="notice" role="status">@Loc["GuideUnavailable"]</p>}
        <section class="card"><h2>@Loc["RouteMap"]</h2>
            @if(canMap)
            {
                <button type="button" class="button secondary" data-guide-map-load data-lat="@(Model.Latitude.GetValueOrDefault().ToString(CultureInfo.InvariantCulture))" data-lng="@(Model.Longitude.GetValueOrDefault().ToString(CultureInfo.InvariantCulture))" data-map-key="@Configuration["Maps:BrowserKey"]" data-loading="@Loc["GuideMapLoading"]" data-failed="@Loc["RouteMapFallback"]">@Loc["GuideInteractiveMap"]</button>
                <p data-guide-map-status role="status" class="small"></p><div class="guide-map" data-guide-map role="region" aria-label="@Loc["RouteMap"]" hidden></div>
            }
            else{<p>@Loc["RouteMapFallback"]</p>}
            <a class="button secondary" href="@mapUrl" target="_blank" rel="noopener noreferrer">@Loc["RouteOpenMaps"] ↗</a>
        </section>
    </div>
    <aside class="card guide-visit-card" aria-labelledby="visit-card-heading">
        <span class="eyebrow">@Loc["RouteVisit"] · BELÉM 360</span>
        <h2 id="visit-card-heading" style="margin:6px 0 12px;">@Loc["VisitState_" + assessment.State]</h2>

        <!-- FASE 4: Componente de Recomendação de Visitação -->
        <div class="features-box" style="margin-bottom:16px;">
            <h4 style="display:flex;align-items:center;gap:6px;margin:0 0 6px;">
                <span>💡</span> <strong>Melhor período para visitação</strong>
            </h4>
            <p class="small" style="line-height:1.6;margin:0 0 8px;">
                @(string.IsNullOrWhiteSpace(assessment.Reason) ? "Visita sugerida no período de funcionamento oficial do local." : assessment.Reason)
            </p>
            @if (assessment.NextChangeUtc.HasValue)
            {
                <p class="small text-muted" style="margin:0 0 6px;">
                    🕒 Próxima mudança de horário prevista para às @PortalTime.Local(assessment.NextChangeUtc.Value).ToString("HH:mm").
                </p>
            }
            <p class="small text-muted" style="font-size:0.78rem;margin:0;">
                ℹ️ @Loc["RouteNoCrowding"]
            </p>
        </div>

        <!-- FASE 4: Quadro de Horários por Dia e Exceções -->
        <div class="card" style="padding:14px;margin-bottom:16px;background:var(--color-cream);">
            <h4 style="margin:0 0 8px;font-size:0.95rem;">📅 Horários de Funcionamento</h4>
            @if (schedule.Hours.Count > 0)
            {
                var regularHours = schedule.Hours.Where(h => h.SpecialDate is null).OrderBy(h => (h.Weekday + 6) % 7).ToList();
                var specialHours = schedule.Hours.Where(h => h.SpecialDate is not null).ToList();
                var daysNames = new[] { "Domingo", "Segunda-feira", "Terça-feira", "Quarta-feira", "Quinta-feira", "Sexta-feira", "Sábado" };

                <ul style="list-style:none;padding:0;margin:0;font-size:0.88rem;display:grid;gap:6px;">
                    @foreach (var h in regularHours)
                    {
                        var dayName = daysNames[Math.Clamp(h.Weekday, 0, 6)];
                        <li style="display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid var(--color-border-subtle);">
                            <strong>@dayName:</strong>
                            <span>
                                @if (h.IsClosed) { <span class="badge badge-secondary" style="font-size:0.75rem;">Fechado</span> }
                                else if (h.Is24h) { <span>Aberto 24 horas</span> }
                                else if (h.OpenMinute.HasValue && h.CloseMinute.HasValue)
                                {
                                    <span>@(h.OpenMinute.Value / 60):@((h.OpenMinute.Value % 60).ToString("00")) às @(h.CloseMinute.Value / 60):@((h.CloseMinute.Value % 60).ToString("00"))</span>
                                }
                                else { <span>Horário a confirmar</span> }
                            </span>
                        </li>
                    }
                </ul>

                @if (schedule.Info?.LastEntryMinutes is { } lastEntry)
                {
                    <p class="small text-muted" style="margin-top:8px;">
                        ⚠️ <strong>Última entrada:</strong> até às @(lastEntry / 60):@((lastEntry % 60).ToString("00")).
                    </p>
                }

                @if (specialHours.Count > 0)
                {
                    <div style="margin-top:10px;padding-top:8px;border-top:1px solid var(--color-border-subtle);">
                        <strong style="font-size:0.8rem;text-transform:uppercase;color:var(--color-text-muted);">Feriados &amp; Datas Especiais:</strong>
                        <ul style="list-style:none;padding:0;margin:4px 0 0;font-size:0.82rem;">
                            @foreach (var sh in specialHours)
                            {
                                <li>@sh.SpecialDate?.ToString("dd/MM"): @(sh.IsClosed ? "Fechado" : "Horário especial")</li>
                            }
                        </ul>
                    </div>
                }
            }
            else if (Model.OpeningHours.Count > 0)
            {
                <ul style="list-style:none;padding:0;margin:0;font-size:0.88rem;display:grid;gap:4px;">
                    @foreach (var h in Model.OpeningHours)
                    {
                        <li style="padding:2px 0;">@h.Label</li>
                    }
                </ul>
            }
            else
            {
                <p class="small text-muted" style="margin:0;">
                    Horário de funcionamento não verificado recentemente. Consulte o estabelecimento antes da visita.
                </p>
            }
        </div>

        <!-- FASE 4: Ingressos, Tarifas e Gratuidade -->
        <div class="card" style="padding:14px;margin-bottom:16px;background:var(--color-cream);">
            <h4 style="margin:0 0 8px;font-size:0.95rem;">🎟️ Ingressos e Tarifas</h4>
            @if (confirmed && schedule.Info is { } confirmedInfo)
            {
                @if (confirmedInfo.EntryPrice is { } price)
                {
                    <p style="margin:0 0 4px;"><strong>Inteira:</strong> R$ @price.ToString("N2")</p>
                    @if (confirmedInfo.HalfPrice is { } half)
                    {
                        <p style="margin:0 0 4px;"><strong>Meia-entrada:</strong> R$ @half.ToString("N2")</p>
                    }
                }
                else
                {
                    <p style="margin:0 0 4px;"><strong>Entrada:</strong> Gratuita ou sob consulta no local.</p>
                }

                @if (!string.IsNullOrWhiteSpace(confirmedInfo.PriceConditions))
                {
                    <p class="small text-muted" style="margin:4px 0 0;">@confirmedInfo.PriceConditions</p>
                }

                <div style="margin-top:10px;padding-top:8px;border-top:1px solid var(--color-border-subtle);font-size:0.8rem;color:var(--color-text-muted);">
                    <a href="@confirmedInfo.SourceUrl" target="_blank" rel="noopener noreferrer">Fonte oficial ↗</a> ·
                    Verificado: @PortalTime.Local(confirmedInfo.ConfirmedAt).ToString("dd/MM/yyyy")
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(Model.PriceText))
            {
                <p style="margin:0;"><strong>Valor:</strong> @Model.PriceText</p>
                <p class="small text-muted" style="margin-top:4px;">Tarifa conforme informado pelo estabelecimento.</p>
            }
            else
            {
                <p class="small text-muted" style="margin:0;">
                    Tarifa não informada / Entrada franca ou a confirmar na bilheteria local.
                </p>
            }
        </div>

        <!-- Acessibilidade -->
        <p class="small" style="margin-bottom:14px;">
            ♿ <strong>Acessibilidade:</strong> @(Model.WheelchairAccessible == true ? "Acesso para cadeirantes confirmado" : Model.WheelchairAccessible == false ? "Sem acessibilidade informada" : "Consulte com a administração")
        </p>
        @if (TempData["VisitRequest"] is string visitNote)
        {
            <p class="notice" role="status">@visitNote</p>
        }
        <form asp-action="Visita" asp-route-id="@Model.Id" method="post" class="visit-request">
            <h3>@Loc["VisitRequestTitle"]</h3>
            <p class="small">@Loc["VisitRequestLead"]</p>
            <label>@Loc["VisitRequestName"]<input name="nome" maxlength="100" required autocomplete="name" /></label>
            <label>@Loc["VisitRequestEmail"]<input name="email" type="email" maxlength="150" required autocomplete="email" /></label>
            <label>@Loc["VisitRequestPhone"]<input name="telefone" maxlength="30" autocomplete="tel" /></label>
            <label>@Loc["VisitRequestParty"]<input name="pessoas" type="number" min="1" max="30" value="1" required /></label>
            <label>@Loc["VisitRequestDate"]<input name="data" type="date" required min="@DateOnly.FromDateTime(DateTime.UtcNow.AddHours(-3)).ToString("yyyy-MM-dd")" max="@DateOnly.FromDateTime(DateTime.UtcNow.AddHours(-3)).AddDays(180).ToString("yyyy-MM-dd")" /></label>
            <label>@Loc["VisitRequestMessage"]<textarea name="recado" maxlength="1000" rows="3"></textarea></label>
            <label class="checkbox-label"><input type="checkbox" name="consentimento" value="true" required /><span>@Loc["VisitRequestConsent"] (<a href="/privacidade">@Loc["Nav_Privacy"]</a>)</span></label>
            <button type="submit">@Loc["VisitRequestSubmit"]</button>
        </form>
        <a class="button" href="/como-chegar?placeId=@Model.Id">@Loc["RouteTitle"] ↗</a>
        @if(SafeUrl.Validate(Model.WebsiteUri).IsValid && live){<a class="button secondary" href="@Model.WebsiteUri" target="_blank" rel="noopener noreferrer">@Loc["GuideWebsite"] ↗</a>}
        <a class="button secondary" href="/guia">← @Loc["Nav_Guide"]</a><p class="small">@Loc["RouteNoCrowding"]</p>
    </aside>
</article>
<partial name="_PlaceMediaGallery" model="Model.Id"/>
@if(canMap){<script src="~/js/guide-map.js" asp-append-version="true" defer></script>}
