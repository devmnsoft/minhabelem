@model IReadOnlyList<MinhaBelem.Core.Entities.Place>
<section class="section"><p class="eyebrow">EXPLORE A CIDADE</p><h1>Guia de Belém</h1><p>Locais selecionados pela equipe. Ao abrir um local, os detalhes disponíveis são consultados no Google Maps.</p>
<form method="get" class="filters"><label>Busca<input name="busca" maxlength="120" /></label><label>Bairro<input name="bairro" maxlength="120" /></label><label>Município<input name="municipio" maxlength="120" /></label><button>Filtrar</button></form>
@if(Model.Count == 0){<div class="empty"><h2>Nenhum local disponível</h2><p>A equipe está preparando o guia. Tente outros filtros ou consulte novamente mais tarde.</p></div>}
<div class="grid">@foreach(var place in Model){<article class="card"><h2><a asp-action="Detalhe" asp-route-id="@place.Id">@place.Name</a></h2><p>@place.EditorialNote</p><p>@place.Neighborhood · @place.Municipality</p></article>}</div></section>
