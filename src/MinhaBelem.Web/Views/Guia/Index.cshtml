@model IReadOnlyList<MinhaBelem.Web.Services.PlaceCard>
<section class="section"><p class="eyebrow">EXPLORE BELÉM DO PARÁ</p><h1>Um guia da nossa cidade</h1><p>Encontre serviços, lazer e atrações. Os estabelecimentos exibidos são obtidos da API Google Places quando configurada. Informações como preço e horários devem ser confirmadas com o estabelecimento.</p>
<nav class="categories" aria-label="Categorias do guia"><a href="/guia?categoria=tourist_attraction">Passeios</a><a href="/guia?categoria=restaurant">Restaurantes</a><a href="/guia?categoria=museum">Museus</a><a href="/guia?categoria=movie_theater">Cinemas</a><a href="/guia?categoria=park">Parques</a><a href="/guia?categoria=hospital">Saúde</a><a href="/guia?categoria=library">Bibliotecas</a><a href="/guia?categoria=lodging">Hospedagem</a><a href="/guia?categoria=stadium">Esportes</a></nav>
@if(Model.Count==0){<div class="empty"><h2>Guia em preparação</h2><p>Configure a chave Google Places no servidor. Nenhuma localização ou serviço será inventado.</p></div>}
else {<div class="grid">@foreach(var place in Model){<article class="card"><div class="eyebrow">@place.Category</div><h3>@place.Name</h3><p>@place.Address</p>@if(!string.IsNullOrWhiteSpace(place.MapsUrl)){<a href="@place.MapsUrl" target="_blank" rel="noopener noreferrer">Ver endereço e rota no Google Maps ↗</a>}</article>}</div>}
<p class="small">Dados de estabelecimentos fornecidos pelo Google Maps Platform. O MinhaBelém não garante disponibilidade, preço ou horário sem confirmação.</p></section>