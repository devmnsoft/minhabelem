@model IReadOnlyList<MinhaBelem.Core.Entities.Place>

@{
    ViewData["Title"] = Loc["Nav_Guide"].Value;
}

<section class="section">
    <p class="eyebrow">EXPLORE A CIDADE</p>
    <h1>@Loc["Nav_Guide"]</h1>
    <p>Locais selecionados pela equipe editorial. Detalhes em tempo real integrados com o Google Places.</p>

    <form method="get" class="filters" role="search">
        <label>
            Busca
            <input name="busca" maxlength="120" placeholder="Ex: Ver-o-Peso, Mangal..." />
        </label>
        <label>
            Bairro
            <input name="bairro" maxlength="120" placeholder="Ex: Campina, Cidade Velha..." />
        </label>
        <label>
            Município
            <input name="municipio" maxlength="120" placeholder="Belém" />
        </label>
        <label>
            Categoria
            <select name="categoria">
                <option value="">Todas</option>
                <option value="restaurant">Restaurantes & Gastronomia</option>
                <option value="museum">Museus & Teatros</option>
                <option value="park">Parques & Praças</option>
                <option value="tourist_attraction">Atrações Turísticas & Feiras</option>
            </select>
        </label>
        <label>
            Acessibilidade
            <select name="acessibilidade">
                <option value="">Todas</option>
                @foreach (var feature in Enum.GetNames<MinhaBelem.Core.Taxonomy.AccessibilityFeature>())
                {
                    <option value="@feature">@feature</option>
                }
            </select>
        </label>
        <button type="submit">@Loc["Search_Button"]</button>
    </form>

    @if (Model.Count == 0)
    {
        <div class="empty">
            <h2>@Loc["General_Empty"]</h2>
            <p>Nenhum local encontrado para os filtros selecionados.</p>
        </div>
    }
    else
    {
        <div class="grid">
            @foreach (var place in Model)
            {
                <article class="card place-card">
                    <span class="eyebrow">@place.PrimaryType</span>
                    <h2><a asp-action="Detalhe" asp-route-id="@place.Id">@place.DisplayName</a></h2>
                    <p>@place.DisplayEditorialNote</p>

                    @if (!string.IsNullOrWhiteSpace(place.CulturalNotes))
                    {
                        <div class="cultural-badge">💡 @place.CulturalNotes</div>
                    }

                    <div class="place-meta small">
                        <span>📍 @place.Neighborhood · @place.Municipality</span>
                    </div>
                </article>
            }
        </div>
    }
</section>
