@model IReadOnlyList<MinhaBelem.Core.Entities.AdvertiserCampaign>
@{ ViewData["Title"] = Loc["NavPartners"]; }
<section class="hero">
    <span class="eyebrow">MINHABELÉM · @Loc["NavPartners"]</span>
    <h1>@Loc["CommercialHero"]</h1>
    <p>@Loc["CommercialIntro"]</p>
</section>
<partial name="_SponsoredCampaigns" model="Model" />
<section class="section">
    <div class="grid">
        <article class="card"><span class="eyebrow">01 · @Loc["NavGuide"]</span><h2>@Loc["CommercialFoodStay"]</h2><p>@Loc["CommercialBusinessText"]</p></article>
        <article class="card"><span class="eyebrow">02 · @Loc["NavAgenda"]</span><h2>@Loc["CommercialCulture"]</h2><p>@Loc["CommercialCultureText"]</p></article>
        <article class="card"><span class="eyebrow">03 · @Loc["NavNeighborhood"]</span><h2>@Loc["CommercialLocal"]</h2><p>@Loc["CommercialLocalText"]</p></article>
    </div>
    <p class="notice">@Loc["CommercialEditorial"]</p>
</section>
<section class="section cta">
    <h2>@Loc["CommercialProposal"]</h2>
    @if (TempData["Notice"] is string notice) { <p class="notice" role="status">@notice</p> }
    <form asp-action="Anunciar" method="post" class="card route-form">
        @Html.AntiForgeryToken()
        <label>@Loc["CampaignCompany"] *<input name="empresa" maxlength="150" required /></label>
        <label>@Loc["CommercialContact"] *<input name="contato" maxlength="100" required /></label>
        <label>@Loc["CommercialEmail"] *<input name="email" type="email" maxlength="150" required /></label>
        <label>@Loc["CommercialPhone"]<input name="telefone" type="tel" maxlength="30" /></label>
        <label>@Loc["CommercialInterest"]<select name="plano"><option value="Guia">@Loc["CommercialFoodStay"]</option><option value="Categoria">@Loc["CommercialCulture"]</option><option value="Bairro">@Loc["CommercialLocal"]</option><option value="Personalizado">@Loc["CommercialCustom"]</option></select></label>
        <label>@Loc["CommercialMessage"]<textarea name="mensagem" rows="3" maxlength="2000"></textarea></label>
        <label><input type="checkbox" name="consentimento" value="true" required /> @Loc["CommercialConsent"]</label>
        <a href="/privacidade">@Loc["PrivacyPolicy"]</a>
        <button type="submit">@Loc["CommercialSend"]</button>
    </form>
</section>
