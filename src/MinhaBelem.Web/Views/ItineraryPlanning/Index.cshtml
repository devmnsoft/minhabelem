@using MinhaBelem.Web.Models
@model MinhaBelem.Web.Controllers.ItineraryPlanningPage
@{ViewData["Title"]=Loc["ItineraryPlannerTitle"];}
<section class="hero"><h1>@Loc["ItineraryPlannerTitle"]</h1><p>@Loc["ItineraryPlannerScope"]</p></section><main class="section"><form method="post" action="/explore/planejar" class="card route-form">@Html.AntiForgeryToken()<label>@Loc["RouteOrigin"]<input name="Origin" required maxlength="350" value="@Model.Request.Origin"/></label><label>@Loc["RouteWhen"]<input type="datetime-local" name="LocalStart" required value="@Model.Request.LocalStart.ToString("yyyy-MM-ddTHH:mm")"/></label><label>@Loc["Period"]<select name="Days">@foreach(var d in new[]{.5m,1m,2m,3m,5m}){<option value="@d.ToString(System.Globalization.CultureInfo.InvariantCulture)" selected="@(d==Model.Request.Days)">@d · @Loc["ItineraryDays"]</option>}</select></label><label>@Loc["RouteMode"]<select name="Mode">@foreach(var m in new[]{"transit","walking","bicycling","driving","boat"}){<option value="@m" selected="@(Model.Request.Mode==m)">@Loc["RouteMode_"+m]</option>}</select></label><label>@Loc["ItineraryVisitors"]<input type="number" name="Visitors" min="1" max="20" required value="@Model.Request.Visitors"/></label><label>@Loc["RouteTotal"] · BRL<input type="number" name="Budget" min="0" step=".01" value="@Model.Request.Budget?.ToString(System.Globalization.CultureInfo.InvariantCulture)"/></label><label>@Loc["ItineraryStay"]<input type="number" name="VisitMinutes" min="30" max="240" value="@Model.Request.VisitMinutes"/></label><label>@Loc["BatchCategory"]<select name="Category"><option value="">—</option>@foreach(var c in MinhaBelem.Infrastructure.Places.PlacesCatalog.Types){<option value="@c" selected="@(Model.Request.Category==c)">@c</option>}</select></label><label><input name="Children" type="checkbox" value="true" checked="@Model.Request.Children"/> @Loc["ChildrenProgram"]</label><label><input name="Accessible" type="checkbox" value="true" checked="@Model.Request.Accessible"/> @Loc["RouteAccessible"]</label><label><input name="FreeOnly" type="checkbox" value="true" checked="@Model.Request.FreeOnly"/> @Loc["FreeEvents"]</label><button>@Loc["RouteCalculate"]</button></form>
<p class="small">@Loc["ItineraryGroupCost"]</p>
@if(Model.Result is {} result){<p class="notice">@Loc[result.State=="calculated"?"ItineraryCalculated":"RouteState_unavailable"]</p>@foreach(var day in result.Days){<section class="section"><h2>@day.LocalDate.ToString("D")</h2><ol class="journey-timeline">@foreach(var stop in day.Visits){<li><h3><a href="/guia/@stop.Place.Id">@stop.Place.DisplayName</a></h3><p>@PortalTime.Local(stop.ArrivalUtc).ToString("t") → @PortalTime.Local(stop.DepartureUtc).ToString("t")</p><p>@Math.Ceiling(stop.Route.DurationSeconds/60d) min · @Loc["RouteEstimate"]</p><a href="@stop.SourceUrl" target="_blank" rel="noopener noreferrer">@Loc["RouteSource"] ↗</a><a href="/como-chegar?placeId=@stop.Place.Id">@Loc["RouteTitle"]</a></li>}</ol><p>@Loc["RouteKnownSubtotal"]: BRL @day.KnownCost.ToString("F2")</p>@if(!day.CostComplete){<p>@Loc["RouteIncompleteCost"]</p>}@if(day.ReturnRoute is {} back){<a href="@back.ExternalUrl" rel="noopener noreferrer" target="_blank">@Loc["ItineraryReturn"] ↗</a>}</section>}}
@if(Model.Result?.State == "calculated") {
<p>@Loc["ItinerarySharePrivacy"]</p>
<button type="button" data-share-itinerary data-copied="@Loc["ItineraryCopied"]" data-failed="@Loc["ItineraryCopyFailed"]">@Loc["ItineraryShare"]</button>
<p role="status" data-itinerary-share-status></p>
}
</main><script src="~/js/itinerary-share.js" defer></script>

