@model MinhaBelem.Web.Models.AgendaPage
@using MinhaBelem.Web.Models
@using System.Globalization
@using Microsoft.AspNetCore.WebUtilities
@{
    ViewData["Title"] = $"{Model.Title} — MinhaBelém";
    var culture = CultureInfo.CurrentUICulture;
    var today = DateOnly.FromDateTime(PortalTime.Local(DateTime.UtcNow));
    var month = Model.Month ?? today;
    var first = new DateOnly(month.Year, month.Month, 1);
    string Link(string key, string? value, bool resetDate = false) {
        var q = Context.Request.Query.ToDictionary(x => x.Key, x => (string?)x.Value.ToString());
        if(resetDate){q.Remove("data");q.Remove("mes");}
        if(value is null)q.Remove(key);else q[key]=value;
        return QueryHelpers.AddQueryString("/agenda", q);
    }
    var types = new[]{("teatro","stage"),("musica","music"),("danca","stage"),("humor","music"),("infantil","family"),("corrida","sport"),("congressos","city"),("feiras","city"),("cinema","stage"),("exposicoes","city"),("religioso","city")};
}
<section class="agenda-hero">
    <div class="agenda-hero-copy"><p class="eyebrow">MINHABELÉM / @Loc["Nav_Agenda"]</p><h1>@Loc["AgendaDiscover"]</h1><p>@Loc["AgendaExploreIntro"]</p>
    <div class="agenda-hero-actions"><a class="button" href="@Link("dias","0",true)">@Loc["AgendaPeriod_0"] ↗</a><a href="#agenda-results">@Loc["AgendaSeeEvents"] ↓</a></div>
    <div class="agenda-stats"><span><strong>@Model.Items.Count</strong> @Loc["AgendaSessions"]</span><span><strong>@Model.Items.Select(x=>x.EventStartAt is {} s?PortalTime.Local(s).Date:DateTime.MinValue).Distinct().Count()</strong> @Loc["AgendaDays"]</span><span><strong>@Model.Items.Select(x=>x.SourceName).Distinct().Count()</strong> @Loc["AgendaSources"]</span></div></div>
    <figure class="agenda-hero-art"><img src="/images/agenda/city.svg" alt="" width="720" height="360"/><figcaption>@Loc["AgendaIllustration"]</figcaption><span class="agenda-art-note">BELÉM<br/><strong>@Loc["AgendaAlive"]</strong></span></figure>
</section>
<nav class="agenda-topics" aria-label="@Loc["AgendaThemes"]"><a href="@Link("tipo",null)" aria-current="@(string.IsNullOrEmpty(Context.Request.Query["tipo"])?"page":null)">@Loc["AgendaAll"]</a>@foreach(var (key,art) in types){<a href="@Link("tipo",key)" aria-current="@(Context.Request.Query["tipo"]==key?"page":null)"><img src="/images/agenda/@(art).svg" alt="" width="32" height="32"/>@Loc["AgendaTopic_"+key]</a>}</nav>
<main class="section agenda-workspace">
    <aside class="agenda-sidebar"><section class="card agenda-calendar"><p class="eyebrow">@Loc["MonthlyEvents"]</p><nav class="agenda-month-nav" aria-label="@Loc["MonthlyEvents"]"><a href="@Link("mes",first.AddMonths(-1).ToString("yyyy-MM-dd"),true)" aria-label="@Loc["AgendaPreviousMonth"]">←</a><h2>@first.ToString("MMMM yyyy",culture)</h2><a href="@Link("mes",first.AddMonths(1).ToString("yyyy-MM-dd"),true)" aria-label="@Loc["AgendaNextMonth"]">→</a></nav>
    <div class="agenda-weekdays" aria-hidden="true">@for(var d=0;d<7;d++){<span>@culture.DateTimeFormat.AbbreviatedDayNames[d][..1]</span>}</div><div class="month-calendar">
    @for(var blank=0;blank<(int)first.DayOfWeek;blank++){<span aria-hidden="true"></span>}
    @for(var n=1;n<=DateTime.DaysInMonth(first.Year,first.Month);n++){var day=new DateOnly(first.Year,first.Month,n);var count=Model.CalendarItems.Count(x=>AgendaPage.OccursOn(x,day));<a class="@(day==today?"is-today":"") @(count>0?"has-events":"")" href="@Link("data",day.ToString("yyyy-MM-dd"),true)" aria-current="@(Model.SelectedDate==day?"date":null)" aria-label="@day.ToString("D",culture) · @count @Loc["AgendaSessions"]"><strong>@n</strong>@if(count>0){<small>@count</small>}</a>}
    </div><p class="small">● @Loc["AgendaCalendarHint"]</p></section>
    <details class="card agenda-filters"><summary>@Loc["AgendaRefine"]</summary><form method="get" action="/agenda" role="search">
    @if(!string.IsNullOrEmpty(Context.Request.Query["tipo"])){<input type="hidden" name="tipo" value="@Context.Request.Query["tipo"]"/>}
    <label>@Loc["Period"]<select name="dias">@Html.Raw(SelectOptions.Build(new[]{0,1,7,30,90,180,365}.Select(p => (p.ToString(), Loc["AgendaPeriod_"+p].Value)), Model.Days.ToString()))</select></label>
    <label>@Loc["Search"]<input name="busca" maxlength="120" value="@Context.Request.Query["busca"]" placeholder="@Loc["Search_Placeholder"]"/></label>
    <label>@Loc["Neighborhood"]<input name="bairro" maxlength="120" value="@Context.Request.Query["bairro"]"/></label>
    <label>@Loc["Municipality"]<input name="municipio" maxlength="120" value="@Context.Request.Query["municipio"]"/></label>
    <label>@Loc["AgeRating"]<input type="number" name="idade" min="0" max="18" value="@Context.Request.Query["idade"]"/></label>
    <label>@Loc["Audience"]<select name="publico"><option value="">@Loc["AgendaAll"]</option>@Html.Raw(SelectOptions.Build(Enum.GetNames<MinhaBelem.Core.Taxonomy.Audience>().Select(a => (a, Loc["Audience_"+a].Value)), Context.Request.Query["publico"].ToString()))</select></label>
    <label>@Loc["Explore_Accessibility_Title"]<select name="acessibilidade"><option value="">@Loc["AgendaAll"]</option>@Html.Raw(SelectOptions.Build(Enum.GetNames<MinhaBelem.Core.Taxonomy.AccessibilityFeature>().Select(a => (a, Loc["Accessibility_"+a].Value)), Context.Request.Query["acessibilidade"].ToString()))</select></label>
    <label class="agenda-check">@Html.Raw(SelectOptions.Checkbox("gratuito", "true", Context.Request.Query["gratuito"] == "true"))@Loc["FreeEvents"]</label><button>@Loc["Search_Button"]</button><a href="/agenda">@Loc["AgendaClear"]</a></form></details>
    <p class="agenda-source-note">@Loc["AgendaSourceNotice"]</p></aside>
    <section id="agenda-results" class="agenda-results"><div class="agenda-results-head"><div><p class="eyebrow">@Loc["AgendaYourPlans"]</p><h2>@Model.Title</h2><p>@Model.Items.Count @Loc["AgendaSessions"] @if(Model.SelectedDate is {} chosen){<span>· @chosen.ToString("D",culture)</span>}</p></div><div class="agenda-tools" hidden data-agenda-tools><button type="button" data-agenda-saved aria-pressed="false">☆ @Loc["AgendaSaved"]</button><button type="button" data-agenda-list aria-pressed="false">☷ @Loc["AgendaList"]</button></div></div>
    <nav class="agenda-periods" aria-label="@Loc["Period"]">@foreach(var days in new[]{0,1,7,30,90,180,365}){<a href="@Link("dias",days.ToString(),true)" aria-current="@(Model.Days==days&&Model.SelectedDate is null&&!Context.Request.Query.ContainsKey("mes")?"page":null)">@Loc["AgendaPeriod_"+days]</a>}</nav>
    <p role="status" aria-live="polite" id="agenda-status" data-saved-label="@Loc["AgendaSave"]" data-unsave-label="@Loc["AgendaUnsave"]" data-shared="@Loc["AgendaCopied"]" data-failed="@Loc["AgendaShareFailed"]"></p>
    @if(Model.Items.Count==0){<div class="empty"><img src="/images/agenda/city.svg" alt="" width="240" height="120"/><h3>@Loc["General_Empty"]</h3><p>@Loc["AgendaEmpty"]</p><a class="button secondary" href="/agenda">@Loc["AgendaAll"]</a></div>}
    <p class="notice" data-agenda-no-saved hidden>@Loc["AgendaNoSaved"]</p>
    @foreach(var group in Model.Items.GroupBy(x=>x.EventStartAt is {} start?new DateOnly(PortalTime.Local(start).Year,PortalTime.Local(start).Month,1):first)){
    <section class="agenda-month-group"><div class="agenda-group-title"><h3>@group.Key.ToString("MMMM yyyy",culture)</h3><span>@group.Count() @Loc["AgendaSessions"]</span></div><div class="agenda-event-grid">
    @foreach(var item in group){var local=PortalTime.Local(item.EventStartAt??item.PublishedAt);var topic=MinhaBelem.Infrastructure.MySql.CuratedAgendaImporter.AgendaSubjects.Contains(item.Subject??"")?"AgendaTopic_"+item.Subject:"Category_"+MinhaBelem.Core.Taxonomy.Taxonomy.Info(item.Category).Slug;var art=item.Subject switch{"corrida"=>"sport","musica" or "humor"=>"music","infantil"=>"family","congressos" or "feiras"=>"city",_=>"stage"};var hasImage=!string.IsNullOrWhiteSpace(item.ImageUrl)&&!string.IsNullOrWhiteSpace(item.ImageCredit)&&!string.IsNullOrWhiteSpace(item.ImageLicense)&&!item.ImageUrl.StartsWith("/images/agenda/",StringComparison.Ordinal);var verified=item.VerificationStatus==MinhaBelem.Core.Entities.VerificationStatus.Verified&&item.LastVerifiedAt>DateTime.UnixEpoch&&item.LastVerifiedAt<=DateTime.UtcNow;
    <article class="agenda-card" data-event-id="@item.Id"><div class="agenda-card-art"><img src="@(hasImage?item.ImageUrl:"/images/agenda/"+art+".svg")" alt="@(hasImage?item.DisplayTitle:"")" width="720" height="360" loading="lazy"/><span class="agenda-illustration-label">@(hasImage?item.ImageCredit:Loc["AgendaIllustration"].Value)</span><div class="agenda-date-tile"><strong>@local.ToString("dd")</strong><span>@local.ToString("MMM",culture)</span></div><button type="button" class="agenda-save" data-save-event="@item.Id" aria-pressed="false" aria-label="@Loc["AgendaSave"]: @item.DisplayTitle" hidden>☆</button></div>
    <div class="agenda-card-body"><p class="eyebrow">@Loc[topic] @if(item.Status==MinhaBelem.Core.Entities.ContentStatus.Cancelled){<span class="notice error-notice">@Loc["AgendaCancelled"]</span>}</p><h4><a href="/Home/Detalhe/@item.Id">@item.DisplayTitle</a></h4><p class="agenda-card-when"><time datetime="@(AgendaPage.DateOnlyEvent(item)?local.ToString("yyyy-MM-dd"):(item.EventStartAt??item.PublishedAt).ToString("O"))">@local.ToString("ddd, dd MMM",culture) · @(AgendaPage.DateOnlyEvent(item)?Loc["AgendaUnknownTime"].Value:local.ToString("HH:mm"))</time></p><p class="agenda-card-place">⌖ @(item.EventDetails?.Location??item.Address??item.Municipality)</p><p>@item.DisplaySummary</p><p class="agenda-card-price">@(item.IsFree?Loc["FreeEvents"].Value:item.TicketPriceText??Loc["AgendaCheckPrice"].Value)</p><p class="small agenda-verification">@item.SourceName · @if(verified){<span>@Loc["AgendaCheckedAt"] @PortalTime.Local(item.LastVerifiedAt).ToString("dd/MM/yyyy",culture)</span>}else{<span>@Loc["AgendaVerificationPending"]</span>}</p>
    <div class="agenda-card-actions"><a href="/Home/Detalhe/@item.Id">@Loc["AgendaDetails"] ↗</a>@if(item.EventStartAt is not null && item.Kind==MinhaBelem.Core.Entities.ContentKind.Event){<a href="/agenda/eventos/@item.Id/calendario.ics" aria-label="@Loc["AgendaAddCalendar"]: @item.DisplayTitle">＋ @Loc["Nav_Agenda"]</a>}<button type="button" data-share-event="/Home/Detalhe/@item.Id" data-title="@item.DisplayTitle" aria-label="@Loc["AgendaShare"]: @item.DisplayTitle" hidden>↗</button></div><a class="agenda-source-link" href="@item.SourceUrl" target="_blank" rel="noopener noreferrer">@Loc["AgendaOfficialSource"] ↗</a></div></article>}
    </div></section>}
    </section></main>
<script src="~/js/agenda.js" asp-append-version="true" defer></script>
