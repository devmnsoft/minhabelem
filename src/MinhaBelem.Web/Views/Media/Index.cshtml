@model IReadOnlyList<MinhaBelem.Web.Controllers.MediaAsset>
@{ViewData["Title"]=Loc["PhotoGallery"];}
<div class="admin-shell"><partial name="_AdminSidebar"/><main class="admin-content"><h1>@Loc["PhotoGallery"]</h1><p>@Loc["MediaLicense"]</p>
<form method="post" enctype="multipart/form-data" class="card batch-toolbar">@Html.AntiForgeryToken()<label>@Loc["PhotoGallery"] · PNG / JPEG / WebP ≤ 4.5 MB<input type="file" name="image" accept="image/png,image/jpeg,image/webp"/></label><label>YouTube · ID (11)<input name="youtubeId" maxlength="11"/></label><label>@Loc["BatchContent"] / @Loc["Nav_Agenda"] · ID<input type="number" name="contentId" min="1"/></label><label>@Loc["RouteDestination"] · ID<input type="number" name="placeId" min="1"/></label><label>@Loc["MediaDescription"]<textarea name="description" required maxlength="500"></textarea></label><label>@Loc["MediaCredit"]<input name="credit" required maxlength="300"/></label><label>@Loc["MediaLicense"]<textarea name="license" required maxlength="500"></textarea></label><label><input type="checkbox" name="reproductionAuthorized" required value="true"/> @Loc["MediaAuthorization"]</label><button>@Loc["Save"]</button></form>
<div class="table-wrap"><table><thead><tr><th>ID</th><th>@Loc["MediaDescription"]</th><th>@Loc["MediaCredit"] / @Loc["MediaLicense"]</th><th>@Loc["BatchContent"]</th></tr></thead><tbody>@foreach(var asset in Model){<tr><td>@asset.Id</td><td>@asset.Description</td><td>@asset.Credit · @asset.License</td><td>@asset.ContentId</td></tr>}</tbody></table></div></main></div>
