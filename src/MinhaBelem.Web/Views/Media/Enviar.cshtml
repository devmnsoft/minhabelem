@{
    ViewData["Title"] = Loc["UploadPhotoTitle"].Value;
    ViewData["Description"] = Loc["UploadPhotoDesc"].Value;
}
<section class="hero" aria-labelledby="enviar-title">
    <div class="hero-content">
        <span class="eyebrow">MINHABELÉM / COMUNIDADE</span>
        <h1 id="enviar-title">@Loc["UploadPhotoTitle"]</h1>
        <p>@Loc["UploadPhotoDesc"]</p>
        <div class="hero-quick-tags">
            <a href="/midias" class="quick-pill">📷 @Loc["MediaGalleryTitle"] ↗</a>
            <a href="/guia/acervo" class="quick-pill">🖼️ @Loc["PhotoGalleryTitle"] ↗</a>
        </div>
    </div>
</section>

<section class="section">
    @if (TempData["MediaNotice"] is string notice)
    {
        <div class="notice" role="status">
            <span aria-hidden="true">✅</span>
            <span>@notice</span>
        </div>
    }

    <div class="sectionhead">
        <div><span class="eyebrow">ENVIO</span><h2>@Loc["UploadPhotoTitle"]</h2></div>
    </div>

    <form method="post" action="/fotos/enviar" enctype="multipart/form-data" class="media-submission-form" data-ajax>
        @Html.AntiForgeryToken()

        <div class="photo-upload-zone" role="group" aria-label="@Loc["UploadPhotoTitle"]">
            <span class="photo-upload-icon" aria-hidden="true">📷</span>
            <p><strong>Escolher foto do dispositivo</strong></p>
            <p style="font-size:0.85rem;color:var(--text-muted,#59675f);">PNG, JPEG ou WebP, até 6 MB. Arraste e solte aqui.</p>
            <label class="button small" for="foto-envio" style="cursor:pointer;">Selecionar arquivo ↗</label>
            <input id="foto-envio" type="file" name="imagem" accept="image/png,image/jpeg,image/webp" required aria-label="Escolher foto para enviar" />
        </div>

        <div class="form-row-2" style="margin-top:28px;">
            <label>
                Título *
                <input name="titulo" maxlength="200" required placeholder="Ex.: Estação das Docas ao amanhecer" />
            </label>
            <label>
                Local
                <input name="local" maxlength="180" placeholder="Ex.: Estação das Docas" />
            </label>
        </div>

        <label>
            Descrição
            <textarea name="descricao" maxlength="500" rows="3" placeholder="Conte o que a imagem mostra e por que ela importa."></textarea>
        </label>

        <div class="form-row-2">
            <label>
                Crédito *
                <input name="credito" maxlength="300" required placeholder="Seu nome ou o nome do autor da foto" />
            </label>
            <label>
                Licença *
                <input name="licenca" maxlength="500" required placeholder="Ex.: CC BY 4.0 ·Uso livre com crédito" />
            </label>
        </div>

        <div class="form-row-3">
            <label>
                Bairro
                <input name="bairro" maxlength="120" placeholder="Ex.: Campina" />
            </label>
            <label>
                Seu nome
                <input name="autor" maxlength="120" autocomplete="name" />
            </label>
            <label>
                E-mail (opcional)
                <input name="email" type="email" maxlength="150" autocomplete="email" />
            </label>
        </div>

        <details style="margin:18px 0;">
            <summary style="cursor:pointer;font-weight:700;">Prefere enviar um vídeo já publicado?</summary>
            <label style="margin-top:14px;">
                Link do vídeo (YouTube, Vimeo ou outro)
                <input name="videoUrl" type="url" maxlength="2000" placeholder="https://www.youtube.com/watch?v=..." />
            </label>
            <p class="small" style="color:var(--text-muted,#59675f);">Envie o link em vez do arquivo. O vídeo também passa por conferência.</p>
        </details>

        <label class="checkbox-label">
            <input type="checkbox" name="consentimento" value="true" required />
            <span>Autorizo o uso editorial da imagem ou vídeo no MinhaBelém, com crédito ao autor(a) e à licença informada. (@Loc["Collab_Consent"] — <a href="/privacidade">@Loc["Nav_Privacy"]</a>)</span>
        </label>

        <div class="form-submit-row">
            <button type="submit">Enviar para revisão ↗</button>
            <a class="button secondary" href="/midias">Ver o acervo</a>
        </div>
    </form>
</section>

<style>
    .media-submission-form { max-width: 820px; }
    .media-submission-form label { display: grid; gap: 6px; }
    .media-submission-form .checkbox-label { display: flex !important; flex-direction: row !important; align-items: flex-start; gap: 10px; }
    .media-submission-form .checkbox-label span { font-size: 0.9rem; line-height: 1.5; }
</style>
