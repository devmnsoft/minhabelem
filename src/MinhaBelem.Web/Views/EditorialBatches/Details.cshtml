@using Microsoft.Extensions.Localization
@using MinhaBelem.Web.Resources
@inject IStringLocalizer<SharedResource> L
@model MinhaBelem.Core.Abstractions.EditorialBatch
@{ ViewData["Title"] = L["BatchPreview"]; }
<div class="admin-shell"><partial name="_AdminSidebar"/><main class="admin-content"><header><span class="eyebrow">@L["BatchTitle"]</span><h1>@L["BatchPreview"]</h1><p>@L["BatchAction"]: @L[BatchLabels.ActionKey(Model.Action)] · @L["BatchCount"]: @Model.Items.Count</p><p>@Model.Reason</p><p role="status">@L["BatchStatus"]: <span data-overall-status>@L["BatchState_"+Model.Status]</span> · @L["BatchCompleted"]: <span data-completed-count>@Model.Items.Count(x=>x.Status=="completed")</span> · @L["BatchFailures"]: <span data-failed-count>@Model.Items.Count(x=>x.Status is "blocked" or "failed")</span></p></header>
<label for="batch-progress">@L["BatchProgress"]</label>
<progress id="batch-progress" max="@Math.Max(1,Model.Items.Count)" value="@Model.Items.Count(x=>x.Status is "completed" or "blocked" or "failed")" data-progress-url="/editorial/lotes/@Model.Id/progresso" data-batch-status="@Model.Status" data-status-labels="@System.Text.Json.JsonSerializer.Serialize(new[]{"preview","queued","running","completed","partial","failed","blocked","pending"}.ToDictionary(x=>x,x=>L["BatchState_"+x].Value))"></progress>
<div class="table-wrap"><table><thead><tr><th>ID</th><th>@L["BatchType"]</th><th>@L["BatchVersion"]</th><th>@L["BatchStatus"]</th><th>@L["BatchResult"]</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr data-batch-item="@(item.TargetKind + ":" + item.TargetId)"><td>@item.TargetId</td><td>@item.TargetKind</td><td>@item.Revision</td><td data-item-status>@L["BatchState_"+item.Status]</td><td data-item-result>@item.Result</td></tr>}</tbody></table></div>
@if(Model.Status=="preview"){<form method="post" asp-action="Confirm" asp-route-id="@Model.Id" class="card"><p>@L["BatchSafety"]</p><label><input name="confirmed" type="checkbox" value="true" required/> @L["BatchConfirmation"]</label><button>@L["BatchConfirm"]</button></form>}
else {<p>@L["BatchWorkerNotice"]</p><a href="/editorial/lotes/@Model.Id" class="button secondary">@L["BatchRefresh"]</a>}
<a href="/editorial/lotes">@L["BatchTitle"]</a></main></div>

<script src="~/js/editorial-progress.js" defer></script>
