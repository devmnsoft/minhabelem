@using MinhaBelem.Core.Entities
@using Microsoft.Extensions.Localization
@using MinhaBelem.Web.Resources
@inject IStringLocalizer<SharedResource> L
@model object
@{ ViewData["Title"] = L["BatchTitle"]; var kind = ViewData["Kind"] as string ?? "content"; var page = (int)ViewData["Page"]!;
var actions=(kind=="candidate"?new[]{"approve","rejectCandidate","reviewCandidate","retry"}:new[]{"review","reject","archive","publish","category","locality","eventStatus","analyze","translate","deduplicate"})
    .Where(action=>User.HasClaim("mb:permission",MinhaBelem.Infrastructure.MySql.EditorialBatches.Permission(action))).ToArray(); }
<div class="admin-shell"><partial name="_AdminSidebar"/><main class="admin-content">
<header class="admin-header"><div><span class="eyebrow">MINHABELÉM · EDITORIAL</span><h1>@L["BatchTitle"]</h1><p>@L["BatchSafety"]</p></div></header>
<div class="grid">@foreach(var metric in (IReadOnlyDictionary<string,long>)ViewData["BatchMetrics"]!){<div class="card"><strong>@metric.Value</strong><span>@L[metric.Key]</span></div>}</div>
<form method="get" class="filter-bar">
<label>@L["BatchType"]<select name="kind"><option value="content" selected="@(kind == "content")">@L["BatchContent"]</option><option value="candidate" selected="@(kind == "candidate")">@L["BatchCandidates"]</option></select></label>
<label>@L["Search"]<input name="search" value="@ViewData["Search"]" maxlength="200"/></label><button>@L["Search"]</button>
</form>
<p class="small">@L["BatchKeyboard"]</p>
<form method="post" asp-action="Preview" id="editorial-batch">
<input type="hidden" name="kind" value="@kind"/><input type="hidden" name="search" value="@ViewData["Search"]"/>
<div class="batch-toolbar card"><label><input type="checkbox" id="batch-select-page"/> @L["BatchSelectPage"]</label><output id="batch-count" aria-live="polite">0</output> @L["BatchSelected"]
<label><input type="checkbox" name="allFiltered" value="true"/> @L["BatchAllFiltered"]</label><label>@L["BatchConfirmCount"]<input type="number" name="confirmedCount" min="1" max="100"/></label></div>
<div class="table-wrap"><table><thead><tr><th>@L["BatchSelect"]</th><th>@L["BatchContent"]</th><th>@L["BatchVersion"]</th></tr></thead><tbody>
@if (kind == "candidate") { foreach (var item in (IReadOnlyList<IngestionCandidate>)Model) { <tr><td><input type="checkbox" name="selected" value="candidate:@item.Id:@item.UpdatedAt.Ticks" aria-label="@item.Title"/></td><td><a href="/editorial/comparar/@item.Id">@item.Title</a><br/>@item.SourceName · @item.Status</td><td>@item.UpdatedAt.ToString("u")</td></tr> } }
else { foreach (var item in (IReadOnlyList<ContentItem>)Model) { <tr><td><input type="checkbox" name="selected" value="content:@item.Id:@item.Revision" aria-label="@item.Title"/></td><td><a href="/editorial/editar/@item.Id">@item.Title</a><br/>@item.SourceName · @item.Status</td><td>@item.Revision</td></tr> } }
</tbody></table></div>
<div class="batch-toolbar card"><label>@L["BatchAction"]<select name="Action">
@foreach(var action in actions){<option value="@action">@L[BatchLabels.ActionKey(action)]</option>}
</select></label><label>@L["BatchValue"]<input name="Value" maxlength="64" list="batch-values"/><datalist id="batch-values">@foreach(var c in Enum.GetNames<MinhaBelem.Core.Taxonomy.ContentCategory>()){<option value="@c"/>}<option value="Cancelled"/><option value="Postponed"/><option value="UncertainDate"/><option value="AwaitingOrganizer"/><option value="Completed"/></datalist></label>
<label>@L["BatchCity"]<input name="Municipality" maxlength="120"/></label><label>@L["BatchNeighborhood"]<input name="Neighborhood" maxlength="120"/></label>
<label>@L["BatchReason"]<textarea name="Reason" required minlength="5" maxlength="500"></textarea></label><button disabled="@(actions.Length==0)">@L["BatchPreview"]</button>@if(actions.Length==0){<p class="notice">@L["BatchNoActions"]</p>}</div>
</form><nav class="pagination"><a href="?kind=@kind&search=@Uri.EscapeDataString(ViewData["Search"] as string ?? "")&page=@Math.Max(1,page-1)">←</a><span>@(page)</span><a href="?kind=@kind&search=@Uri.EscapeDataString(ViewData["Search"] as string ?? "")&page=@(page+1)">→</a></nav>
<section class="card"><h2>@L["BatchMyHistory"]</h2>
@if(ViewData["BatchHistory"] is IReadOnlyList<MinhaBelem.Core.Abstractions.EditorialBatch> history) {
<ul>@foreach(var batch in history){<li><a href="/editorial/lotes/@batch.Id">@batch.CreatedAt.ToString("g") · @L[BatchLabels.ActionKey(batch.Action)] · @L["BatchState_"+batch.Status]</a></li>}</ul>
}
</section></main></div><script src="~/js/editorial-batches.js" defer></script>


